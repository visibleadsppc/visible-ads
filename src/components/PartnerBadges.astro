---
interface Props {
  compact?: boolean;
  dark?: boolean;
}
const { compact = false, dark = false } = Astro.props;

const partners = [
  { name: 'Google Partner', src: '/images/partners/google-partner.webp' },
  { name: 'Microsoft Advertising Partner', src: '/images/partners/microsoft-partner.webp' },
  { name: 'Amazon Ads Verified Partner', src: '/images/partners/amazon-partner.webp' },
  { name: 'Meta Business Partner', src: '/images/partners/meta-partner.webp' },
  { name: 'UK Search Awards Winner', src: '/images/partners/uk-search-awards.webp' },
  { name: 'UK eCommerce Awards Finalist', src: '/images/partners/uk-ecommerce-awards.webp' },
  { name: 'National Digital Awards Finalist', src: '/images/partners/national-digital-awards.webp' },
];
---

<div class={`flex flex-wrap justify-center ${compact ? 'gap-4 sm:gap-6' : 'gap-6 sm:gap-8'} items-center`} data-animate>
  {partners.map(p => (
    <div class={`${compact ? 'h-12 sm:h-14 w-[calc(33%-1rem)] sm:w-auto' : 'h-14 sm:h-18 w-[calc(33%-1.5rem)] sm:w-auto'} flex items-center justify-center ${dark ? 'brightness-0 invert' : ''} hover:scale-105 transition-transform duration-300`}>
      <img src={p.src} alt={p.name} class="max-w-full max-h-full object-contain" loading="lazy" />
    </div>
  ))}
</div>
