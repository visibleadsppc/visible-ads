---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const reviewUrl = "https://www.google.com/maps/place/Visible+Ads/data=!4m2!3m1!1s0x0:0xc19421e998217581";

const reviews = [
  {
    name: "David Archer",
    company: "CFW / Sephra",
    text: "The team's expertise in both paid search and Amazon marketplace management has been instrumental in scaling our business across multiple channels.",
    stars: 5,
  },
  {
    name: "Nari",
    company: "Japan Centre",
    text: "Visible Ads understood our unique market from day one. Their strategic approach to our campaigns delivered consistent growth and a return on investment that exceeded our expectations.",
    stars: 5,
  },
  {
    name: "Claudia Hawkins",
    company: "Kingston CoWork",
    text: "Boh and his team at Visible Ads have been running the SEO and local PPC ads for my coworking space for several years, and have generated lots of business. They are very responsive, professional and honest, highly recommended.",
    stars: 5,
  },
];
---

<div class="google-reviews">
  <!-- Rating summary -->
  <div class="flex items-center gap-3 flex-wrap">
    <svg class="w-6 h-6" viewBox="0 0 48 48">
      <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
      <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
      <path fill="#FBBC05" d="M10.53 28.59A14.5 14.5 0 019.5 24c0-1.59.28-3.14.77-4.59l-7.98-6.19A23.99 23.99 0 000 24c0 3.77.9 7.35 2.56 10.56l7.97-5.97z"/>
      <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 5.97C6.51 42.62 14.62 48 24 48z"/>
    </svg>
    <span class="text-lg font-heading font-semibold text-navy">Google Reviews</span>
    <div class="flex items-center gap-1.5">
      {Array.from({ length: 5 }).map(() => (
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="#F59E0B"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/></svg>
      ))}
      <span class="text-lg font-bold text-navy ml-1">5.0</span>
      <span class="text-sm text-slate ml-1">(8 reviews)</span>
    </div>
  </div>

  {!compact && (
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      {reviews.map((review) => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-center gap-1 mb-3">
            {Array.from({ length: review.stars }).map(() => (
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="#F59E0B"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/></svg>
            ))}
          </div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4 italic">"{review.text}"</p>
          <div>
            <p class="font-heading font-bold text-navy text-sm">{review.name}</p>
            <p class="text-slate text-xs">{review.company}</p>
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="mt-6">
    <a href={reviewUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-200 rounded-lg text-sm font-semibold text-navy hover:border-electric/40 hover:shadow-sm transition-all">
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="#F59E0B"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"/></svg>
      See more reviews
    </a>
  </div>
</div>
