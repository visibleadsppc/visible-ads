---
// K7. The channels Visible Ads runs. Partner statuses from visible-ads-facts; TikTok and LinkedIn carry none.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const groups = [
  { name: 'Search demand', items: [
    { n: 'Google Ads', h: '/google-ads/', p: 'Google Partner' },
    { n: 'Microsoft Advertising', h: '/bing-ads/', p: 'Microsoft Advertising Partner' },
  ] },
  { name: 'Marketplace', items: [
    { n: 'Amazon Ads', h: '/amazon/', p: 'Amazon Ads Verified Partner' },
  ] },
  { name: 'Demand creation', items: [
    { n: 'Meta', h: '/paid-social/', p: 'Meta Business Partner' },
    { n: 'TikTok and LinkedIn', h: '/paid-social/', p: '' },
  ] },
];
---
<nav class={`kit-fig kit-channels ${cls}`} aria-label="Channels we manage" data-kit>
  <ul class="kit-ch-groups">
    {groups.map((g, gi) => (
      <li class="kit-ch-group" style={`--i:${gi}`}>
        <p class="kit-ch-name">{g.name}</p>
        <ul class="kit-ch-items">
          {g.items.map((it) => (
            <li><a class="kit-ch-node" href={it.h}><span class="kit-ch-title">{it.n}</span>{it.p && <span class="kit-ch-partner">{it.p}</span>}</a></li>
          ))}
        </ul>
        <span class="kit-ch-stem kit-line" aria-hidden="true"></span>
      </li>
    ))}
  </ul>
  <p class="kit-ch-base">One budget view and one profit target</p>
</nav>
