---
// K7. The channels Visible Ads runs. Partner statuses from visible-ads-facts; TikTok and LinkedIn carry none.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const groups = [
  { name: 'Search demand', role: 'Buyers already searching', accent: '#2563EB', tint: '#EFF6FF', items: [
    { n: 'Google Ads', h: '/google-ads/', p: 'Google Partner' },
    { n: 'Microsoft Advertising', h: '/bing-ads/', p: 'Microsoft Advertising Partner' },
  ] },
  { name: 'Marketplace', role: 'Buyers shopping on Amazon', accent: '#2563EB', tint: '#EFF6FF', items: [
    { n: 'Amazon Ads', h: '/amazon/', p: 'Amazon Ads Verified Partner' },
  ] },
  { name: 'Demand creation', role: 'Buyers before they search', accent: '#2563EB', tint: '#EFF6FF', items: [
    { n: 'Meta', h: '/paid-social/', p: 'Meta Business Partner' },
    { n: 'TikTok and LinkedIn', h: '/paid-social/', p: 'Paid social' },
  ] },
];
---
<nav class={`kit-fig cm ${cls}`} aria-label="Channels we manage" data-kit>
  <ul class="cm-groups">
    {groups.map((g, gi) => (
      <li class="cm-group kit-fade" style={`--i:${gi};--accent:${g.accent};--tint:${g.tint}`}>
        <div class="cm-head">
          <span class="cm-num" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span>
          <div>
            <p class="cm-name">{g.name}</p>
            <p class="cm-role">{g.role}</p>
          </div>
        </div>
        <ul class="cm-items">
          {g.items.map((it) => (
            <li>
              <a class="cm-node" href={it.h}>
                <span class="cm-dot" aria-hidden="true"></span>
                <span class="cm-text"><span class="cm-title">{it.n}</span><span class="cm-partner">{it.p}</span></span>
                <svg class="cm-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
  <svg class="cm-join kit-fade" style="--i:3" viewBox="0 0 300 48" preserveAspectRatio="none" aria-hidden="true">
    <path d="M50 0 C50 30 150 18 150 48" stroke="#2563EB" />
    <path d="M150 0 L150 48" stroke="#2563EB" />
    <path d="M250 0 C250 30 150 18 150 48" stroke="#2563EB" />
  </svg>
  <span class="cm-stem kit-fade" style="--i:3" aria-hidden="true"></span>
  <p class="cm-base kit-fade" style="--i:4">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.5" fill="currentColor" /></svg>
    One budget view and one profit target
  </p>
</nav>

<style>
  .cm { padding: 24px; background: linear-gradient(180deg, #fff 0%, var(--color-gray-50) 100%); }
  .cm-groups { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .cm-group { display: flex; flex-direction: column; gap: 14px; padding: 16px; border-radius: 14px; background: var(--tint); border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent); border-top: 4px solid var(--accent); }
  .cm-head { display: flex; align-items: flex-start; gap: 10px; }
  .cm-num { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 999px; background: var(--accent); color: #fff; font-family: var(--font-heading); font-weight: 700; font-size: 0.75rem; }
  .cm-name { margin: 0; font-family: var(--font-heading); font-weight: 700; font-size: 1rem; color: var(--color-navy); line-height: 1.25; }
  .cm-role { margin: 2px 0 0; font-size: 0.85rem; color: var(--color-slate-dark); }
  .cm-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cm-node { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-radius: 10px; background: #fff; border: 1px solid var(--color-gray-200); text-decoration: none; box-shadow: 0 1px 2px rgba(10, 22, 40, 0.04); transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
  .cm-node:hover, .cm-node:focus-visible { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 6px 16px rgba(10, 22, 40, 0.08); }
  .cm-node:focus-visible { outline: 3px solid var(--color-electric); outline-offset: 2px; }
  .cm-dot { flex: none; width: 8px; height: 8px; border-radius: 999px; background: var(--accent); }
  .cm-text { display: grid; gap: 1px; min-width: 0; flex: 1; }
  .cm-title { font-family: var(--font-heading); font-weight: 700; color: var(--color-navy); line-height: 1.3; }
  .cm-partner { font-size: 0.8rem; color: var(--color-slate-dark); }
  .cm-arrow { flex: none; width: 14px; height: 14px; color: var(--accent); }
  .cm-join { display: none; }
  .cm-stem { display: block; width: 2px; height: 22px; margin: 0 auto; background: var(--color-slate-light); }
  .cm-base { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 0; padding: 14px 18px; border-radius: 12px; background: var(--color-navy); color: #fff; text-align: center; font-family: var(--font-heading); font-weight: 700; }
  .cm-base svg { flex: none; width: 22px; height: 22px; fill: none; stroke: #93C5FD; stroke-width: 2; color: #93C5FD; }
  @media (min-width: 768px) {
    .cm { padding: 28px; }
    .cm-groups { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .cm-stem { display: none; }
    .cm-join { display: block; width: 100%; height: 48px; }
    .cm-join path { opacity: 0.6; fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  }
</style>
