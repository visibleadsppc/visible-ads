---
// K1. Weekly ROAS budget rules, from Boh's deck of 1 May 2026 (visible-ads-facts). Bands exactly as published; gaps shown, not filled.
interface Props { class?: string; heading?: string }
const { class: cls = '', heading = '' } = Astro.props;
type Row = { band: string; action: string; kind: 'up' | 'hold' | 'cut' | 'off' | 'gap'; size?: number };
const rows: Row[] = [
  { band: 'Above 1,200%', action: 'Raise budget 20% a week', kind: 'up', size: 100 },
  { band: 'Exactly 1,200%', action: 'Not specified', kind: 'gap' },
  { band: 'Above 1,100% and below 1,200%', action: 'Not specified', kind: 'gap' },
  { band: '900% to 1,100%', action: 'Raise budget 10% a week', kind: 'up', size: 50 },
  { band: 'Above 800% and below 900%', action: 'Not specified', kind: 'gap' },
  { band: '600% to 800%', action: 'Hold budget', kind: 'hold' },
  { band: 'Above 500% and below 600%', action: 'Not specified', kind: 'gap' },
  { band: '300% to 500%', action: 'Cut budget 20%', kind: 'cut', size: 100 },
  { band: 'Below 300%', action: 'Switch spend off', kind: 'off' },
];
---
<figure class={`kit-fig ${cls}`} data-kit>
  {heading && <p class="kit-fig-title">{heading}</p>}
  <ol class="kit-ladder">
    {rows.map((r, i) => (
      <li class={`kit-rung kit-rung-k-${r.kind} kit-fade`} style={`--i:${rows.length - 1 - i}`}>
        <span class="kit-rung-band">{r.band}</span>
        <span class="kit-rung-track" aria-hidden="true">
          {(r.kind === 'up' || r.kind === 'cut') && <span class={`kit-bar kit-rung-bar kit-rung-bar-${r.kind}`} style={`width:${r.size}%`}></span>}
          {r.kind === 'hold' && <span class="kit-rung-flat"></span>}
          {r.kind === 'off' && <span class="kit-rung-off"></span>}
        </span>
        <span class="kit-rung-action">{r.action}</span>
      </li>
    ))}
  </ol>
  <figcaption>Our weekly budget rule, set by ROAS band. Bands not listed here are not specified. Source: Visible Ads scaling rules.</figcaption>
</figure>
