---
// K4. The audit process line. A real ordered sequence, no durations.
interface Props { steps: { title: string; body: string }[]; class?: string }
const { steps, class: cls = '' } = Astro.props;
---
<ol class={`kit-steps ${cls}`} data-kit>
  {steps.map((s, i) => (
    <li class="kit-step" style={`--i:${i}`}>
      <span class="kit-step-no kit-fade" aria-hidden="true">{i + 1}</span>
      <span class="kit-step-line kit-line" aria-hidden="true"></span>
      <h3 class="kit-step-title"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
      <p class="kit-step-body">{s.body}</p>
    </li>
  ))}
</ol>
