---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const clients = [
  { name: 'Japan Centre', src: '/images/clients/japan-centre.webp' },
  { name: 'CFW', src: '/images/clients/cfw.webp' },
  { name: 'Sephra', src: '/images/clients/sephra.webp' },
  { name: 'Diespeker & Co', src: '/images/clients/diespeker.webp' },
  { name: 'Yo-Yo Desk', src: '/images/clients/yo-yo-desk.webp' },
  { name: 'J-LOC', src: '/images/clients/j-loc.webp' },
  { name: 'Bespoke Airsoft', src: '/images/clients/bespoke-airsoft.webp' },
  { name: 'Huntsman Air Sports', src: '/images/clients/huntsman.webp' },
  { name: 'homes2let', src: '/images/clients/homes2let.webp' },
  { name: 'Health & Aesthetics', src: '/images/clients/health-aesthetics.webp' },
  { name: 'International Care', src: '/images/clients/international-care.webp' },
  { name: 'City Borough Housing', src: '/images/clients/city-borough-housing.webp' },
  { name: 'Haden', src: '/images/clients/haden.webp' },
  { name: 'OnlyBBGuns', src: '/images/clients/onlybbguns.webp' },
  { name: 'London Cask Traders', src: '/images/clients/london-cask-traders.webp' },
  { name: 'Marco Dal Maso', src: '/images/clients/marco-dal-maso.webp' },
  { name: 'Powell Europe', src: '/images/clients/powell-europe.webp' },
  { name: 'Kutchenhaus', src: '/images/clients/kutchenhaus.webp' },
  { name: 'Fragrance Hub', src: '/images/clients/fragrance-hub.webp' },
];
---

<div data-animate>
  {!compact && (
    <p class="text-center text-sm font-medium text-slate-light uppercase tracking-widest mb-8">Trusted by Leading Brands</p>
  )}
  <div class={`flex flex-wrap items-center justify-center ${compact ? 'gap-4 sm:gap-6' : 'gap-6 sm:gap-8 lg:gap-10'}`}>
    {clients.map(c => (
      <div class={`${compact ? 'h-10 basis-[calc((100%-2rem)/3)] sm:basis-[calc((100%-6rem)/5)]' : 'h-12 sm:h-14 basis-[calc((100%-3rem)/3)] sm:basis-[calc((100%-6rem)/4)] lg:basis-[calc((100%-10rem)/5)]'} flex items-center justify-center hover:scale-105 transition-transform duration-300`}>
        <img src={c.src} alt={c.name} class="max-w-full max-h-full object-contain" loading="lazy" />
      </div>
    ))}
  </div>
</div>
