---
interface Props {
  title?: string;
  bars: { label: string; value: number; color?: string }[];
}

const { title, bars } = Astro.props;
const maxValue = Math.max(...bars.map(b => b.value));
---

<div class="growth-chart" data-kit>
  {title && <h3 class="font-heading text-lg font-bold text-navy mb-6">{title}</h3>}
  <div class="space-y-4">
    {bars.map((bar, i) => (
      <div class="growth-bar-row">
        <div class="flex justify-between items-center mb-1.5">
          <span class="text-sm font-medium text-gray-700">{bar.label}</span>
          <span class="text-sm font-bold text-electric bar-value">{bar.value}%</span>
        </div>
        <div class="h-3 bg-gray-100 rounded-full overflow-hidden">
          <div
            class="growth-bar h-full rounded-full"
            style={`width: ${(bar.value / maxValue) * 100}%; transition-delay: ${i * 150}ms; background: linear-gradient(90deg, ${bar.color || '#2563EB'}, ${bar.color ? bar.color + '80' : '#3B82F6'});`}
          ></div>
        </div>
      </div>
    ))}
  </div>
</div>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html.js .growth-chart .growth-bar { transform-origin: left; transition: transform 1s ease-out; }
    html.js .growth-chart:not(.is-in) .growth-bar { transform: scaleX(0); transition-delay: 0s; }
  }
</style>
