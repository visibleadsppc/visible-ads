---
// Profit / POAS calculator. Reveals whether a given ROAS is actually profitable
// once product margin is taken into account, plus break-even ROAS and POAS.
import Turnstile from './Turnstile.astro';
---
<div class="bg-gradient-to-br from-[#0A1628] to-[#132240] rounded-3xl p-6 sm:p-10 shadow-2xl" id="profit-calc">
  <div class="text-center mb-8">
    <h3 class="font-heading text-2xl sm:text-3xl font-bold text-white">Is your ROAS actually profitable?</h3>
    <p class="mt-2 text-[#94A3B8] text-sm sm:text-base">Put in your own numbers. The calculator works out whether you are making money or just turnover.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
    <div>
      <label for="pc-spend" class="block text-[#94A3B8] text-sm font-medium mb-2">Monthly ad spend (&pound;)</label>
      <input type="number" id="pc-spend" inputmode="numeric" min="0" step="100" value="10000"
        class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/15 text-white text-lg font-semibold focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/30 outline-none transition-all" />
    </div>
    <div>
      <label for="pc-roas" class="block text-[#94A3B8] text-sm font-medium mb-2">Your ROAS (x)</label>
      <input type="number" id="pc-roas" inputmode="decimal" min="0" step="0.1" value="4"
        class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/15 text-white text-lg font-semibold focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/30 outline-none transition-all" />
    </div>
    <div>
      <label for="pc-margin" class="block text-[#94A3B8] text-sm font-medium mb-2">Gross margin (%)</label>
      <input type="number" id="pc-margin" inputmode="numeric" min="0" max="100" step="1" value="30"
        class="w-full px-4 py-3 rounded-lg bg-white/5 border border-white/15 text-white text-lg font-semibold focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/30 outline-none transition-all" />
      <p class="text-[#64748B] text-xs mt-1.5">Profit on a sale after product cost, before ad spend.</p>
    </div>
  </div>

  <!-- Verdict -->
  <div id="pc-verdict" class="rounded-2xl p-5 mb-6 text-center border transition-colors">
    <p id="pc-verdict-text" class="font-heading text-lg sm:text-xl font-bold"></p>
    <p id="pc-verdict-sub" class="text-sm mt-1"></p>
  </div>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    <div class="bg-white/5 rounded-2xl p-5 text-center border border-white/10">
      <p class="text-[#94A3B8] text-xs sm:text-sm mb-1">Revenue</p>
      <p id="pc-revenue" class="font-heading text-xl sm:text-2xl font-bold text-white">&pound;40,000</p>
    </div>
    <div class="bg-white/5 rounded-2xl p-5 text-center border border-white/10">
      <p class="text-[#94A3B8] text-xs sm:text-sm mb-1">Gross profit</p>
      <p id="pc-grossprofit" class="font-heading text-xl sm:text-2xl font-bold text-white">&pound;12,000</p>
    </div>
    <div class="bg-white/5 rounded-2xl p-5 text-center border border-white/10">
      <p class="text-[#94A3B8] text-xs sm:text-sm mb-1">Profit after ad spend</p>
      <p id="pc-netprofit" class="font-heading text-xl sm:text-2xl font-bold text-white">&pound;2,000</p>
    </div>
    <div class="bg-[#2563EB]/20 rounded-2xl p-5 text-center border border-[#2563EB]/30">
      <p class="text-[#3B82F6] text-xs sm:text-sm mb-1 font-semibold">Break-even ROAS</p>
      <p id="pc-breakeven" class="font-heading text-xl sm:text-2xl font-bold text-[#3B82F6]">3.3x</p>
    </div>
  </div>

  <p class="mt-5 text-center text-[#94A3B8] text-xs">POAS (profit on ad spend): <span id="pc-poas" class="text-white font-semibold">1.2x</span>. Below your break-even ROAS, every extra pound of spend loses money.</p>

  <!-- Lead capture -->
  <div class="mt-8 pt-8 border-t border-white/10" data-hide-sticky-cta>
    <p class="text-center text-white font-heading font-semibold mb-4">Want the real numbers from your own account?</p>
    <form action="/api/submit" method="POST" data-astro-reload class="flex flex-col gap-3 max-w-xl mx-auto" id="pc-form">
      <input type="hidden" name="_form" value="profit-calculator" />
      <input type="hidden" name="_next" value="https://visible-ads.com/roas-vs-profit?thanks=1&form=profit_calculator" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none" />
      <div class="flex flex-col sm:flex-row gap-3">
        <input type="text" name="name" required placeholder="Your name"
          class="flex-1 min-w-0 px-4 py-3 rounded-lg bg-white/5 border border-white/15 text-white placeholder-[#64748B] focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/30 outline-none transition-all" />
        <input type="email" name="email" required placeholder="you@company.com"
          class="flex-1 min-w-0 px-4 py-3 rounded-lg bg-white/5 border border-white/15 text-white placeholder-[#64748B] focus:border-[#2563EB] focus:ring-2 focus:ring-[#2563EB]/30 outline-none transition-all" />
        <button type="submit" class="px-6 py-3 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg whitespace-nowrap">Get a free profit audit</button>
      </div>
      <Turnstile theme="dark" class="mx-auto" />
    </form>
    <p id="pc-form-thanks" class="text-center text-[#94A3B8] text-sm mt-3 hidden">Thanks. Boh will be in touch within 24 hours with a profit read on your account.</p>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const spendEl = document.getElementById('pc-spend') as HTMLInputElement;
    const roasEl = document.getElementById('pc-roas') as HTMLInputElement;
    const marginEl = document.getElementById('pc-margin') as HTMLInputElement;
    if (!spendEl || !roasEl || !marginEl) return;

    const revEl = document.getElementById('pc-revenue')!;
    const gpEl = document.getElementById('pc-grossprofit')!;
    const npEl = document.getElementById('pc-netprofit')!;
    const beEl = document.getElementById('pc-breakeven')!;
    const poasEl = document.getElementById('pc-poas')!;
    const verdict = document.getElementById('pc-verdict')!;
    const vText = document.getElementById('pc-verdict-text')!;
    const vSub = document.getElementById('pc-verdict-sub')!;

    const gbp = (n: number) => '£' + Math.round(n).toLocaleString('en-GB');

    function render() {
      const spend = Math.max(0, parseFloat(spendEl.value) || 0);
      const roas = Math.max(0, parseFloat(roasEl.value) || 0);
      const marginPct = Math.min(100, Math.max(0, parseFloat(marginEl.value) || 0));
      const margin = marginPct / 100;

      const revenue = spend * roas;
      const grossProfit = revenue * margin;
      const netProfit = grossProfit - spend;
      const poas = spend > 0 ? grossProfit / spend : 0;
      const breakEven = margin > 0 ? 1 / margin : Infinity;

      revEl.textContent = gbp(revenue);
      gpEl.textContent = gbp(grossProfit);
      npEl.textContent = (netProfit < 0 ? '-' : '') + gbp(Math.abs(netProfit));
      beEl.textContent = isFinite(breakEven) ? breakEven.toFixed(1) + 'x' : '-';
      poasEl.textContent = poas.toFixed(2) + 'x';

      npEl.className = 'font-heading text-xl sm:text-2xl font-bold ' + (netProfit >= 0 ? 'text-[#10B981]' : 'text-[#EF4444]');

      if (netProfit > 0) {
        verdict.className = 'rounded-2xl p-5 mb-6 text-center border transition-colors bg-[#10B981]/10 border-[#10B981]/30';
        vText.className = 'font-heading text-lg sm:text-xl font-bold text-[#10B981]';
        vSub.className = 'text-sm mt-1 text-[#94A3B8]';
        vText.textContent = 'Profitable: ' + gbp(netProfit) + ' profit a month';
        vSub.textContent = 'Your ' + roas.toFixed(1) + 'x ROAS clears the ' + breakEven.toFixed(1) + 'x you need at ' + marginPct + '% margin.';
      } else if (netProfit === 0) {
        verdict.className = 'rounded-2xl p-5 mb-6 text-center border transition-colors bg-[#F59E0B]/10 border-[#F59E0B]/30';
        vText.className = 'font-heading text-lg sm:text-xl font-bold text-[#F59E0B]';
        vSub.className = 'text-sm mt-1 text-[#94A3B8]';
        vText.textContent = 'Break-even: every pound in comes straight back out';
        vSub.textContent = 'You need a ROAS above ' + breakEven.toFixed(1) + 'x at ' + marginPct + '% margin to make a profit.';
      } else {
        verdict.className = 'rounded-2xl p-5 mb-6 text-center border transition-colors bg-[#EF4444]/10 border-[#EF4444]/30';
        vText.className = 'font-heading text-lg sm:text-xl font-bold text-[#EF4444]';
        vSub.className = 'text-sm mt-1 text-[#94A3B8]';
        vText.textContent = 'Losing money: ' + gbp(Math.abs(netProfit)) + ' a month';
        vSub.textContent = 'A ' + roas.toFixed(1) + 'x ROAS looks fine, but at ' + marginPct + '% margin you need ' + breakEven.toFixed(1) + 'x just to break even.';
      }
    }

    [spendEl, roasEl, marginEl].forEach((el) => el.addEventListener('input', render));
    render();

    // Lead capture: show thanks on return
    if (window.location.search.includes('thanks=1')) {
      const form = document.getElementById('pc-form');
      const thanks = document.getElementById('pc-form-thanks');
      if (form) form.classList.add('hidden');
      if (thanks) thanks.classList.remove('hidden');
    }
  });
</script>
