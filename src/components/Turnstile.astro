---
// Cloudflare Turnstile, the bot check in front of every site form. Added 1 Sep 2026 after a
// bot started filling real-looking name/email values, which walks straight past the honeypot.
// The sitekey is public, so it lives here rather than in a build variable the Pages build
// would also need; its secret half is the visible-ads-forms worker's TURNSTILE_SECRET.
interface Props {
  theme?: 'light' | 'dark' | 'auto';
  class?: string;
}

const { theme = 'light', class: className = '' } = Astro.props;
const SITEKEY = '0x4AAAAAAEjuiFvjTq5K7Aln';
---

<script is:inline>
  // Turnstile normally renders itself the moment api.js loads. This site uses view
  // transitions, so a client-side navigation onto a form page never re-runs api.js and the
  // widget would never appear. Render explicitly instead: once when api.js is ready, and
  // again every time a page settles. Widgets already up, and ones still hidden behind a
  // wizard step, are skipped.
  window.vaRenderTurnstile = function () {
    if (!window.turnstile) return;
    document.querySelectorAll('.cf-turnstile').forEach(function (el) {
      if (el.dataset.rendered || el.offsetParent === null) return;
      el.dataset.rendered = '1';

      var form = el.closest('form');
      var waitingToSubmit = false;
      var spent = false;

      var id = window.turnstile.render(el, {
        sitekey: el.dataset.sitekey,
        theme: el.dataset.theme || 'light',
        'refresh-expired': 'auto',
        'expired-callback': function () {
          window.turnstile.reset(id);
        },
        callback: function () {
          if (waitingToSubmit && form) {
            waitingToSubmit = false;
            spent = true;
            form.submit();
          }
        },
      });

      if (!form) return;

      // A token is single use and dies after five minutes, and a backgrounded tab can sleep
      // through the automatic refresh. Someone who leaves a form open while they think about
      // what to write, presses submit twice, or comes back to a sent form would otherwise post
      // a stale or already-redeemed token and get a page of raw JSON instead of sending their
      // enquiry. Cloudflare rejects both cases the same way, as timeout-or-duplicate. Hold the
      // submission, fetch a fresh token, then send it.
      form.addEventListener('submit', function (e) {
        var input = form.querySelector('input[name="cf-turnstile-response"]');
        if (!spent && input && input.value && !window.turnstile.isExpired(id)) {
          spent = true;
          return;
        }
        e.preventDefault();
        waitingToSubmit = true;
        window.turnstile.reset(id);
      });

      // Back button and bfcache restore the form with the token it already spent, so retire it.
      window.addEventListener('pageshow', function (e) {
        if (!e.persisted) return;
        spent = false;
        waitingToSubmit = false;
        window.turnstile.reset(id);
      });
    });
  };
  document.addEventListener('astro:page-load', function () {
    window.vaRenderTurnstile();
  });
</script>
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=vaRenderTurnstile"
  async
  defer></script>

<div class:list={['cf-turnstile', className]} data-sitekey={SITEKEY} data-theme={theme}></div>
