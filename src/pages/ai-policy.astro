---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "AI Policy",
      "description": "How Visible Ads uses artificial intelligence responsibly in our advertising management and marketing services.",
      "url": "https://visible-ads.com/ai-policy",
      "publisher": {
        "@type": "Organization",
        "name": "Visible Ads"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "AI Policy", "item": "https://visible-ads.com/ai-policy" }
      ]
    }
  ]
};
---

<Layout title="AI Policy | Visible Ads" description="How Visible Ads uses artificial intelligence responsibly in our advertising management and marketing services." schema={schema}>

  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white mb-6 leading-tight">Our AI Policy</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">How we use artificial intelligence responsibly to deliver better results for our clients.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">Our Commitment</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Artificial intelligence is transforming digital advertising. At Visible Ads, we embrace these tools where they genuinely improve outcomes for our clients, while maintaining the human expertise and judgement that no algorithm can replace.</p>
        <p class="text-gray-700 leading-relaxed">This policy outlines how we use AI, the safeguards we have in place, and our commitment to transparency and responsible adoption. We believe our clients have the right to know when and how AI is involved in the management of their advertising.</p>
      </div>

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">How We Use AI</h2>
        <p class="text-gray-700 leading-relaxed mb-4">We use AI-powered tools in the following areas of our work:</p>
        <ul class="space-y-3 mb-4">
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span><strong class="text-navy">Campaign Optimisation:</strong> Automated bidding strategies and performance forecasting powered by platform-native AI (Google Smart Bidding, Microsoft auto-bidding) to maximise return on ad spend.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span><strong class="text-navy">Bid Management:</strong> Real-time bid adjustments based on conversion probability, time of day, device, location, and audience signals.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span><strong class="text-navy">Audience Insights:</strong> AI-driven audience analysis to identify high-value customer segments and lookalike audiences for targeting.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span><strong class="text-navy">Reporting Automation:</strong> Automated data aggregation and visualisation to surface actionable insights faster, freeing our team to focus on strategy.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span><strong class="text-navy">Ad Copy Assistance:</strong> AI tools may be used to generate ad copy drafts and variations, which are always reviewed, refined, and approved by our team before going live.</span>
          </li>
        </ul>
      </div>

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">Human Oversight</h2>
        <p class="text-gray-700 leading-relaxed mb-4">AI is a tool, not a replacement for expertise. Every AI-assisted decision at Visible Ads is reviewed and approved by a member of our team. We do not allow fully autonomous campaign changes without human review.</p>
        <p class="text-gray-700 leading-relaxed">Our team sets the strategic direction, defines the guardrails, and monitors outcomes. When AI recommendations conflict with our professional judgement or your business objectives, human expertise takes precedence.</p>
      </div>

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">Data Handling</h2>
        <p class="text-gray-700 leading-relaxed mb-4">Your data is your data. We take its protection seriously.</p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Client campaign data is never shared with third-party AI training datasets.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>We only use AI tools that comply with GDPR and UK data protection regulations.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>When we use platform-native AI features (such as Google Smart Bidding), data handling is governed by your existing agreements with those platforms.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <svg class="w-5 h-5 text-electric flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Any third-party AI tools we use are vetted for data security and privacy compliance before adoption.</span>
          </li>
        </ul>
      </div>

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">Transparency</h2>
        <p class="text-gray-700 leading-relaxed mb-4">We believe in full transparency about our use of AI. If you ask us whether AI was involved in any aspect of your campaign management, we will give you a straight answer. Our monthly reports note when AI-driven strategies (such as Smart Bidding or automated audience expansion) are in use.</p>
        <p class="text-gray-700 leading-relaxed">If you prefer that we limit or exclude AI tools from your campaign management, we are happy to discuss alternative approaches.</p>
      </div>

      <div class="prose-section mb-12">
        <h2 class="text-2xl font-heading font-bold text-navy mb-4">Policy Updates</h2>
        <p class="text-gray-700 leading-relaxed">The AI landscape is evolving rapidly. We review this policy quarterly to ensure it reflects our current practices and the latest developments in AI technology and regulation. Significant changes will be communicated to active clients directly.</p>
        <p class="text-sm text-slate mt-4">Last updated: May 2026</p>
      </div>

    </div>
  </section>

  <section class="py-20 lg:py-28 bg-navy" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">Questions About Our AI Use?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">We are always happy to discuss how we use technology to improve your advertising performance.</p>
      <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25 text-lg">
        Get In Touch
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

</Layout>
