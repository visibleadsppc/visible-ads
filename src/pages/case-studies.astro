---
import Layout from '../layouts/Layout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Case Studies | Client Results",
      "description": "Explore Visible Ads client results, including CFW's £6M return from £500K in Google Ads spend and Sephra Europe's £2.31M in ad-driven revenue.",
      "url": "https://visible-ads.com/case-studies",
      "publisher": {
        "@type": "Organization",
        "name": "Visible Ads"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": "https://visible-ads.com/case-studies" }
      ]
    }
  ]
};

const caseStudies = [
  {
    slug: 'cfw',
    title: 'CFW',
    subtitle: 'From Stagnation to Success',
    channels: 'Amazon + Google Ads',
    metric: '12x',
    metricLabel: 'Google Ads ROAS',
    industry: 'Food & Beverage',
    description: 'CFW had been running paid campaigns for years but had plateaued. Revenue was flat, ROAS was declining, and they were spending more to stand still. We rebuilt their account structure, realigned their bidding strategy to margin-weighted targets, and launched a coordinated Amazon-Google approach that turned their entire trajectory around.',
    color: 'from-electric to-cyan-500',
    logo: '/images/clients/cfw.webp',
  },
  {
    slug: 'iwholesales',
    title: 'iWholesales',
    subtitle: 'Skyrocketing Airsoft Sales',
    channels: 'Online visibility + conversion',
    metric: '+450%',
    metricLabel: 'Sales',
    industry: 'eCommerce',
    description: 'iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.',
    color: 'from-electric to-violet-500',
    logo: null,
  },
  {
    slug: 'luxury-architecture',
    title: 'Luxury Architecture',
    subtitle: 'Premium Lead Gen at Scale',
    channels: 'Lead Generation',
    metric: '12x',
    metricLabel: 'Lead Volume',
    industry: 'Architecture',
    description: 'A boutique architecture firm needed high-value leads, not volume for volume\'s sake. We designed a lead generation strategy targeting affluent homeowners planning major renovations, using geo-targeted Search and Display campaigns with bespoke landing pages. Lead volume increased 12x while cost per qualified lead dropped by 60%.',
    color: 'from-electric to-emerald-500',
    logo: null,
  },
  {
    slug: 'sephra',
    title: 'Sephra Europe',
    subtitle: 'Exceptional Business Growth',
    channels: 'Multi-channel',
    metric: '£2.31M',
    metricLabel: 'Ad-Driven Revenue',
    industry: 'Food & Beverage',
    description: 'Sephra Europe sells commercial chocolate fountains and ingredients across the UK and Europe. We managed their full advertising stack: Google Search, Shopping, Display, Bing, and Amazon. Sephra Europe achieved £2.31M in ad-driven revenue and 1,149% ROAS.',
    color: 'from-electric to-amber-500',
    logo: '/images/clients/sephra.webp',
  },
  {
    slug: 'yo-yo-desk',
    title: 'Yo-Yo Desk',
    subtitle: 'Doubling Return on Ad Spend',
    channels: 'Paid Advertising',
    metric: '5x',
    metricLabel: 'ROAS (from 2.5x)',
    industry: 'Office Furniture',
    description: 'Yo-Yo Desk came to us running at a 2.5x ROAS. We restructured their account management and doubled it to 5x, turning their advertising into a channel worth scaling rather than one that just about broke even.',
    color: 'from-electric to-rose-500',
    logo: '/images/clients/yo-yo-desk.webp',
  },
  {
    slug: 'sephra-usa-amazon',
    title: 'Sephra USA',
    subtitle: 'A Golden Quarter That Delivered',
    channels: 'Amazon Ads',
    metric: '+116%',
    metricLabel: 'Q4 Unit Growth',
    industry: 'Food & Beverage',
    description: 'Sephra USA sells chocolate fountains and dessert equipment on Amazon US, a category where demand concentrates hard into Q4. We scaled the account through the 2025 golden quarter, doubling unit volume year-on-year while ROAS rose from 7.72x to 9.84x and both ACOS and TACOS fell.',
    color: 'from-electric to-amber-500',
    logo: '/images/clients/sephra.webp',
  },
];
---

<Layout title="Case Studies | Client Results | Visible Ads" description="Explore Visible Ads client results, including CFW's £6M return from £500K in Google Ads spend and Sephra Europe's £2.31M in ad-driven revenue." schema={schema}>

  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white mb-6 leading-tight">Case Studies</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">Real results. Real businesses. Real growth.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {caseStudies.map((study) => (
          <a href={`/case-studies/${study.slug}`} class="group relative bg-white rounded-2xl overflow-hidden shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
            <div class={`h-2 group-hover:h-3 transition-all duration-300 bg-gradient-to-r ${study.color}`}></div>
            <div class="p-6 sm:p-8 lg:p-10">
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-electric bg-sky-tint px-3 py-1 rounded-full">{study.industry}</span>
                <span class="text-xs font-medium text-slate">{study.channels}</span>
              </div>
              {study.logo && (
                <img src={study.logo} alt={`${study.title} logo`} class="h-14 mb-4 object-contain object-left" loading="lazy" />
              )}
              <h2 class="text-2xl font-heading font-bold text-navy mb-1 group-hover:text-electric transition-colors">{study.title}</h2>
              <p class="text-lg font-heading font-semibold text-gray-700 mb-4">{study.subtitle}</p>
              <div class="flex items-baseline gap-2 mb-6">
                <span class="text-5xl font-heading font-extrabold text-electric index-metric" data-count-target={study.metric}>{study.metric}</span>
                <span class="text-lg font-semibold text-gray-700">{study.metricLabel}</span>
              </div>
              <p class="text-gray-700 leading-relaxed mb-6">{study.description}</p>
              <span class="inline-flex items-center text-sm font-semibold text-electric group-hover:gap-3 gap-2 transition-all">
                Read full case study
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-medium text-gray-700 uppercase tracking-widest mb-8">More Brands We Work With</p>
      <ClientLogos compact />
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 lg:py-16 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-navy" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">Ready for <span class="gradient-text">Results Like These</span>?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Every one of these clients started with a free ads audit. Yours could be the next success story.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25 text-lg">
        Get Your Free Audit
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <script>
    function animateIndexMetrics() {
      const metrics = document.querySelectorAll('.index-metric');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const raw = el.dataset.countTarget || '';
          if (el.dataset.counted) return;
          el.dataset.counted = 'true';

          const prefix = raw.match(/^([+£]*)/)?.[1] || '';
          const suffix = raw.match(/([%xM]*)$/)?.[1] || '';
          const numStr = raw.replace(/^[+£]+/, '').replace(/[%xM]+$/, '').replace(/,/g, '');
          const target = parseFloat(numStr);
          if (isNaN(target)) return;
          const hasDecimal = numStr.includes('.');
          const useCommas = raw.includes(',');
          const duration = 2000;
          const startTime = performance.now();

          function formatVal(n: number) {
            const s = hasDecimal ? n.toFixed(1) : Math.floor(n).toString();
            return useCommas ? Number(s).toLocaleString('en-GB') : s;
          }

          function animate(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = target * eased;
            el.textContent = prefix + formatVal(current) + suffix;
            if (progress < 1) {
              requestAnimationFrame(animate);
            } else {
              el.textContent = prefix + formatVal(target) + suffix;
            }
          }
          requestAnimationFrame(animate);
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.3 });
      metrics.forEach((m) => observer.observe(m));
    }
    animateIndexMetrics();
  </script>

</Layout>
