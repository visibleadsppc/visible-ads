---
import Layout from '../layouts/Layout.astro';
import CountUp from '../components/CountUp.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "name": "About Visible Ads",
      "description": "Meet the team behind Visible Ads. 20+ years of digital expertise, boutique service, global results.",
      "url": "https://visible-ads.com/about",
      "mainEntity": {
        "@type": "Organization",
        "name": "Visible Ads",
        "description": "Award-winning boutique search engine marketing consultancy",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kingston-Upon-Thames",
          "addressCountry": "GB"
        },
        "founder": {
          "@type": "Person",
          "name": "Boh Tjarks",
          "jobTitle": "Founder & PPC Specialist"
        },
        "employee": [
          { "@type": "Person", "name": "Joe", "jobTitle": "Digital Marketing Manager" },
          { "@type": "Person", "name": "Nicolas Whipp", "jobTitle": "Meta Ads Specialist" },
          { "@type": "Person", "name": "Tom", "jobTitle": "Search Advertising Specialist" }
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "About", "item": "https://visible-ads.com/about" }
      ]
    }
  ]
};

const team = [
  {
    name: 'Boh Tjarks',
    role: 'Founder & PPC Specialist',
    bio: 'With over 20 years in digital media, Boh Tjarks founded Visible Ads to give businesses access to enterprise-level advertising expertise without the enterprise price tag. An Amazon seller since 2015 and certified Google Ads specialist, he has personally scaled multiple sellers to 7-figure revenue and managed millions in ad spend across every major platform.',
    image: '/images/boh.jpg',
    initial: 'B',
    hasImage: true,
  },
  {
    name: 'Joe',
    role: 'Digital Marketing Manager',
    bio: 'Joe leads campaign execution across Google Search, Display, and Performance Max. With deep expertise in SEO and conversion rate optimisation, he brings a full-funnel perspective to every campaign, ensuring ads and landing pages work together to maximise returns.',
    image: '/images/joe.webp',
    initial: 'J',
    hasImage: true,
  },
  {
    name: 'Nicolas Whipp',
    role: 'Meta Ads Specialist',
    bio: 'Nicolas is an enterprise-scale paid social specialist who leads the Meta Ads strategy at Visible Ads, bringing deep expertise in profit-first campaign optimisation. Over his career he managed more than 30 clients and successfully directed over £10 million in ad spend for major global brands including HSBC, VW Group, and Saudi Tourism. Nicolas\' skills in creative testing and audience architecture turns Meta into a high-performing growth engine for our clients.',
    image: '/images/nicolas.jpg',
    initial: 'N',
    hasImage: true,
  },
  {
    name: 'Tom',
    role: 'Search Advertising Specialist',
    bio: 'Tom brings 15+ years of search advertising experience across more than 100 industry niches. From local service businesses to international eCommerce brands, his breadth of experience means he has seen what works and what does not in virtually every market.',
    initial: 'T',
    hasImage: false,
  },
];

const certifications = [
  { name: 'Google Partner', icon: 'G' },
  { name: 'Microsoft Advertising Partner', icon: 'M' },
  { name: 'Amazon Ads Partner', icon: 'A' },
  { name: 'Meta Business Partner', icon: 'Meta' },
  { name: 'UK Search Awards Winner', icon: 'UK' },
];
---

<Layout title="About Visible Ads | Award-Winning PPC Agency" description="Meet the team behind Visible Ads. 20+ years of digital expertise, boutique service, global results. Kingston-Upon-Thames." schema={schema}>

  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white mb-6 leading-tight">About Visible Ads</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">Award-winning boutique search engine marketing consultancy. Based in Kingston-Upon-Thames, delivering results for clients worldwide.</p>
      </div>
    </div>
  </section>


  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">Our Story</h2>
        <div class="border-l-4 border-electric pl-8">
          <p class="text-lg text-gray-700 leading-relaxed mb-6">Visible Ads was founded by Boh Tjarks with a simple conviction: businesses deserve advertising partners who care about their bottom line as much as they do. After two decades in digital media, managing campaigns for brands of every size, he saw the same pattern repeated. Agencies charging premium fees for cookie-cutter work, leaving clients without transparency and without results.</p>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">We built Visible Ads to be the opposite. A boutique consultancy where every client gets senior-level attention, every campaign is built bespoke, and every decision is driven by data and a relentless focus on measurable ROI. No account managers reading from a script. No junior staff learning on your budget.</p>
          <p class="text-lg text-gray-700 leading-relaxed">Today, we manage advertising across Google, Bing, Amazon, Meta, and more for clients ranging from ambitious start-ups to established eCommerce brands turning over seven figures. Our size is deliberate. It means we can be selective about who we work with and give every client the attention they deserve.</p>
        </div>
        <div class="mt-10 rounded-2xl overflow-hidden shadow-xl">
          <img src="/images/Boh Tjarks and Joe Short Visible Ads Google and Meta Advertising.jpg" alt="Boh Tjarks and Joe Short, the Visible Ads team" class="w-full h-64 object-cover" style="object-position: center 25%;" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Meet the Team</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">A small, senior team that punches well above its weight.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {team.map((member) => (
          <div class="bg-white rounded-2xl p-8 text-center shadow-sm border border-gray-100 transition-transform duration-300 hover:-translate-y-1">
            {member.hasImage ? (
              <img src={member.image} alt={member.name} class="w-28 h-28 rounded-full mx-auto mb-6 object-cover ring-4 ring-electric/20" loading="lazy" />
            ) : (
              <div class="w-28 h-28 rounded-full mx-auto mb-6 bg-gradient-to-br from-electric to-cyan-500 flex items-center justify-center ring-4 ring-electric/20">
                <span class="text-4xl font-heading font-bold text-white">{member.initial}</span>
              </div>
            )}
            <h3 class="text-xl font-heading font-bold text-navy mb-1">{member.name}</h3>
            <p class="text-sm font-semibold text-electric mb-4">{member.role}</p>
            <p class="text-gray-700 leading-relaxed text-sm">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Impact</h2>
        <p class="text-lg text-gray-700">The numbers behind two decades of digital advertising.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <CountUp value="20" suffix="+" label="Years Experience" />
        <CountUp value="50" suffix="+" label="Businesses Scaled" />
        <CountUp prefix="£" value="10" suffix="M+" label="Revenue Generated" />
        <CountUp value="4" label="Certified Partnerships" />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Certifications & Awards</h2>
        <p class="text-lg text-gray-700">Recognised by the platforms we manage and the industry we serve.</p>
      </div>
      <PartnerBadges />
      <div class="mt-12">
        <GoogleReviews compact />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-navy text-center mb-12">Clients We've Helped Grow</h2>
      <ClientLogos />
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-navy" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">Work With Us</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">We are selective about who we work with because we give every client our full attention. If you are serious about growth, we would love to talk.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25 text-lg">
        Get Your Free Audit
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

</Layout>
