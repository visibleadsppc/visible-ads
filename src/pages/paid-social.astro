---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServiceLinks from '../components/ServiceLinks.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Meta Ads Agency, Facebook & Instagram Advertising",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "description": "Meta Business Partner. We run Facebook and Instagram campaigns for ecommerce brands tracking Profit on Ad Spend (POAS) and unit economics, not just ROAS.",
      "url": "https://visible-ads.com/paid-social",
      "serviceType": "Meta Ads & Paid Social Media Advertising",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is POAS and how is it different from ROAS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ROAS (Return on Ad Spend) measures revenue against ad spend. POAS (Profit on Ad Spend) measures profit against ad spend, accounting for your product cost, fulfilment, and fees. A campaign can deliver strong ROAS while still being unprofitable if margins are thin. We set POAS targets before campaigns launch so every pound of ad spend is measured against a real profit outcome."
          }
        },
        {
          "@type": "Question",
          "name": "Which Meta platforms do you advertise on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We run campaigns across Facebook, Instagram, and Messenger. For ecommerce clients, Instagram and Facebook Feed and Reels typically deliver the best returns. We recommend placements based on where your audience spends time and where creative performs best for your product category."
          }
        },
        {
          "@type": "Question",
          "name": "Do you create Meta ad creative?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Creative is the primary performance lever on Meta. We develop ad concepts, copy, and design direction, static images, carousels, and video concepts, tailored to each audience segment and funnel stage. We run structured creative testing programmes to continuously identify winning concepts and retire underperformers."
          }
        },
        {
          "@type": "Question",
          "name": "What budget do you recommend for Meta ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend a minimum of £1,500 per month in ad spend to generate enough data for meaningful optimisation. Larger budgets allow faster creative and audience testing. We set spend levels relative to your POAS target so you are always operating within a profitable band."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Meta Ads", "item": "https://visible-ads.com/paid-social" }
      ]
    }
  ]
};
---

<Layout title="Meta Ads Agency | Facebook & Instagram | Visible Ads" description="Meta Business Partner. We run Facebook and Instagram campaigns tracking Profit on Ad Spend (POAS) and unit economics, not just ROAS. Get a free Meta ads audit." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-pink-900 to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Meta Business Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Meta Ads That Scale on Unit Profit, Not Vanity Metrics</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">We run Facebook and Instagram ad campaigns for ecommerce brands, with Profit on Ad Spend (POAS) and unit economics at the centre of every campaign decision. Paid social is now the fastest-growing ad channel for ecommerce. We are built for it.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Meta Ads Audit</a>
          <a href="#poas" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">Why POAS Matters</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Nicolas intro -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-4">Meet the Specialist</span>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Specialist Meta Ads Expertise, Now In-House</h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">We have brought in Nicolas Whipp as our dedicated Meta Ads specialist. Nicolas has hands-on experience running Facebook and Instagram campaigns for ecommerce brands, from creative strategy and audience architecture through to profit-first campaign optimisation.</p>
            <p class="text-lg text-gray-700 leading-relaxed">Paid social is now bigger than paid search for many ecommerce categories. Having a specialist who lives and breathes Meta, not a generalist managing it alongside ten other channels, makes a material difference to performance.</p>
          </div>
          <div class="bg-sky-tint rounded-2xl p-8 border border-gray-100">
            <img src="/images/nicolas.jpg" alt="Nicolas Whipp, Meta Ads Specialist at Visible Ads" class="w-20 h-20 rounded-full mb-6 object-cover ring-4 ring-electric/20" loading="lazy" />
            <h3 class="text-xl font-heading font-bold text-navy mb-1">Nicolas Whipp</h3>
            <p class="text-sm font-semibold text-electric mb-4">Meta Ads Specialist</p>
            <p class="text-gray-700 text-sm leading-relaxed">Meta Ads specialist with deep experience running Facebook and Instagram campaigns for ecommerce brands. Leads on creative strategy, audience targeting, and profit-first optimisation on Meta's advertising platforms.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- POAS Section -->
  <section id="poas" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">We Optimise for POAS, Profit on Ad Spend</h2>
          <p class="text-lg text-gray-700 max-w-2xl mx-auto">ROAS tells you revenue. POAS tells you whether you are making money. We build every Meta campaign around the metric that actually matters.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
            <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mb-4">
              <span class="text-sm font-bold text-gray-400">ROAS</span>
            </div>
            <h3 class="text-xl font-heading font-bold text-navy mb-3">Return on Ad Spend</h3>
            <p class="text-gray-700 leading-relaxed mb-4">Revenue generated per pound spent on ads. A useful weekly signal, but incomplete on its own.</p>
            <p class="text-gray-600 text-sm leading-relaxed">A 5x ROAS on a 15% margin product means you are losing money on every sale. ROAS ignores product cost, fulfilment, fees, and returns, it cannot tell you whether a campaign is actually profitable.</p>
          </div>
          <div class="bg-navy rounded-2xl p-8 border border-electric/20 shadow-sm relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-electric/10 rounded-full -translate-y-8 translate-x-8"></div>
            <div class="relative z-10">
              <div class="w-12 h-12 bg-electric/20 rounded-xl flex items-center justify-center mb-4">
                <span class="text-sm font-bold text-electric">POAS</span>
              </div>
              <h3 class="text-xl font-heading font-bold text-white mb-3">Profit on Ad Spend</h3>
              <p class="text-slate-light leading-relaxed mb-4">Gross profit generated per pound spent on ads, after product cost, fees, and fulfilment.</p>
              <p class="text-slate-light/80 text-sm leading-relaxed">POAS is the target. ROAS is the lever we use week-to-week to hit it. We set a POAS target before campaigns launch, so scaling decisions are always grounded in what the business can actually afford to spend.</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-electric/20">
          <h3 class="text-xl font-heading font-bold text-navy mb-4">Unit Economics First</h3>
          <p class="text-gray-700 leading-relaxed">Before we build a single campaign, we map your unit economics, product cost, Meta fees, fulfilment, and return rate, to calculate your break-even ROAS and your target POAS. Every budget decision, every bid, every creative test is measured against that number. We never recommend scaling spend that pushes you below your profit threshold.</p>
          <p class="text-lg text-gray-700 mt-6 leading-relaxed">For help comparing channels for your ecommerce business, read <a href="/blog/meta-ads-vs-google-ads-ecommerce/" class="text-electric underline hover:text-electric-dark">Meta Ads vs Google Ads for ecommerce</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Meta Ads Services</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Full-funnel Facebook and Instagram advertising, from brand awareness to purchase to repeat customer.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Facebook & Instagram Ads</h3>
          <p class="text-gray-700 text-sm">Prospecting and conversion campaigns across Feed, Stories, and Reels, with audience structures built around your ideal customer profile and POAS targets.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Creative Strategy & Testing</h3>
          <p class="text-gray-700 text-sm">Creative is the primary performance lever on Meta. We develop static, carousel, and video ad concepts, then run structured tests to find winners fast and retire underperformers before they drain budget.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Audience Architecture</h3>
          <p class="text-gray-700 text-sm">Interest, lookalike, and Advantage+ audience builds, mapped to funnel stage. We find who your best customers are, then build audiences that find more of them at your POAS target.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Retargeting Sequences</h3>
          <p class="text-gray-700 text-sm">Warm audiences, add-to-cart, view-content, past purchasers, served tailored ads matched to their stage in the buying journey. Retargeting consistently delivers the highest POAS of any Meta campaign type.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Conversions API (CAPI)</h3>
          <p class="text-gray-700 text-sm">Server-side event tracking via Conversions API for accurate attribution even with iOS privacy changes and cookie restrictions. Reliable data is the foundation of reliable optimisation.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-100">
          <div class="w-10 h-10 bg-electric/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="font-heading font-bold text-navy mb-2">Performance Reporting</h3>
          <p class="text-gray-700 text-sm">Monthly reporting against POAS targets, not just ROAS. We show you what the campaigns are actually costing per unit of profit, and what we are doing to improve it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TikTok & LinkedIn -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">We Also Run TikTok Ads & LinkedIn Ads</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Paid social extends beyond Meta. We run TikTok campaigns for ecommerce brands reaching younger audiences, and LinkedIn campaigns for B2B and <a href="/ppc-for-professional-services/" class="text-electric underline hover:text-electric-dark">professional-services clients and agency partners</a>.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-black flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.29 6.29 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">TikTok Ads</h3>
          <p class="text-gray-700 leading-relaxed text-sm">Short-form video advertising for ecommerce brands reaching 18-34 audiences. In-Feed Ads and TopView placements managed with the same creative-first, POAS-grounded approach we apply on Meta. Best for visually compelling products with strong creative potential.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-blue-700 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">LinkedIn Ads</h3>
          <p class="text-gray-700 leading-relaxed text-sm">Sponsored Content, Lead Gen Forms, and Message Ads for B2B and professional-services clients. Precise targeting by job title, seniority, company size, and industry. The highest-cost-per-click social platform, only worth it when the deal value justifies it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Meta Ads Process</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Creative-led, data-driven, built around your profit threshold from day one.</p>
      </div>
      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="hidden lg:block absolute top-10 left-[calc(12.5%+24px)] right-[calc(12.5%+24px)] h-0.5 bg-electric/20"></div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Unit Economics Mapping</h3>
          <p class="text-gray-700">We calculate your break-even ROAS and target POAS before a single campaign goes live. Every subsequent decision is measured against this number.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Creative & Audience Build</h3>
          <p class="text-gray-700">We develop ad creative concepts and audience structures, matched to your product, your customer, and your funnel stage. Creative is the lever; we treat it like one.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Launch & Test</h3>
          <p class="text-gray-700">Campaigns launch with CAPI tracking in place. We test creative and audiences systematically, identifying winners quickly and cutting underperformers before they drain budget.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Scale Within Profit</h3>
          <p class="text-gray-700">We scale winning campaigns within your POAS threshold, increasing budget where profit allows, pulling back where it does not. Growth that pays for itself.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What is POAS and how is it different from ROAS?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">ROAS measures revenue against ad spend. POAS measures profit against ad spend, after product cost, fulfilment and fees. A campaign can deliver strong ROAS while still being unprofitable if margins are thin. We set POAS targets before campaigns launch so every pound of ad spend is measured against a real profit outcome.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              Which Meta platforms do you advertise on?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">We run campaigns across Facebook, Instagram, and Messenger. For ecommerce clients, Instagram and Facebook Feed and Reels typically deliver the strongest returns. We recommend placements based on where your audience spends time and where creative performs best for your product category.</div>
          </details>
