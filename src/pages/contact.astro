---
import Layout from '../layouts/Layout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Turnstile from '../components/Turnstile.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Visible Ads",
      "description": "Contact Visible Ads for Google Ads, Bing Ads, SEO, and Amazon advertising enquiries.",
      "url": "https://visible-ads.com/contact",
      "mainEntity": {
        "@type": "Organization",
        "name": "Visible Ads",
        "email": "Boh@Visible-Ads.com",
        "telephone": "+447810477679",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Kingston-Upon-Thames",
          "addressRegion": "Surrey",
          "addressCountry": "GB"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://visible-ads.com/contact" }
      ]
    }
  ]
};
---

<Layout title="Contact Visible Ads | Get In Touch" description="Contact Visible Ads for Google Ads, Bing Ads, SEO, and Amazon advertising enquiries. Kingston-Upon-Thames, UK." schema={schema}>


  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">

        <div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-navy mb-6 leading-tight">Get In Touch</h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-10">Whether you have a question about our services, want to discuss a project, or are ready to get started, we would love to hear from you.</p>

          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Email</h3>
                <a href="mailto:Boh@Visible-Ads.com" class="text-electric hover:text-electric-dark transition-colors">Boh@Visible-Ads.com</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Phone</h3>
                <a href="tel:+447810477679" class="text-electric hover:text-electric-dark transition-colors">+44 7810 477679</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Location</h3>
                <p class="text-gray-700">Kingston-Upon-Thames, Surrey, UK</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-electric" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">LinkedIn</h3>
                <a href="https://www.linkedin.com/company/visibleads/" target="_blank" rel="noopener" class="text-electric hover:text-electric-dark transition-colors">Follow us on LinkedIn</a>
              </div>
            </div>
          </div>

          <div class="mt-12">
            <GoogleReviews compact />
          </div>

          <div class="mt-8 bg-sky-tint rounded-2xl p-6 border border-gray-100">
            <p class="text-gray-700 text-sm leading-relaxed">
              <span class="font-semibold text-navy">Prefer a comprehensive review?</span> Skip the enquiry and go straight to our <a href="/free-ads-audit" class="text-electric hover:text-electric-dark font-semibold transition-colors">free ads audit</a>. We will analyse your campaigns and deliver a detailed report with actionable recommendations.
            </p>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 sm:p-10 shadow-xl border border-gray-200 ring-1 ring-electric/10 h-fit mb-24 lg:mb-0">
          <h2 class="text-2xl font-heading font-bold text-navy mb-6">Send Us a Message</h2>
          <form id="contact-form" action="/api/submit" method="POST" data-astro-reload class="space-y-5">
            <input type="hidden" name="_form" value="contact" />
            <input type="hidden" name="_next" value="https://visible-ads.com/contact?thanks=1&form=contact" />
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none" />
            <div>
              <label for="contact-name" class="block text-sm font-medium text-navy mb-1.5">Name</label>
              <input type="text" id="contact-name" name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="Your full name" />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-navy mb-1.5">Email</label>
              <input type="email" id="contact-email" name="email" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="you@company.com" />
            </div>
            <div>
              <label for="contact-message" class="block text-sm font-medium text-navy mb-1.5">Message</label>
              <textarea id="contact-message" name="message" rows="6" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700 resize-none" placeholder="How can we help?"></textarea>
            </div>
            <Turnstile />
            <button type="submit" class="w-full px-6 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25 text-lg">
              Send Message
            </button>
          </form>
          <script>
            if (window.location.search.includes('thanks=1')) {
              const form = document.getElementById('contact-form');
              if (form) form.innerHTML = '<div class="text-center py-12"><div class="w-16 h-16 rounded-full bg-success/10 flex items-center justify-center mx-auto mb-4"><svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div><h3 class="text-xl font-heading font-bold text-navy mb-2">Thank You!</h3><p class="text-gray-700">We\'ve received your message. Boh will reply within 24 hours.</p></div>';
            }
          </script>
        </div>

      </div>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-20" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-3">Find Us</h2>
        <p class="text-gray-600">Based in Kingston-Upon-Thames, working with businesses across the UK</p>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-lg ring-1 ring-gray-200">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2494.5!2d-0.3007!3d51.4123!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0xc19421e998217581!2sVisible%20Ads!5e0!3m2!1sen!2suk!4v1700000000000!5m2!1sen!2suk"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Visible Ads, Google Business Profile"
          class="w-full"
        ></iframe>
      </div>
    </div>
  </section>

</Layout>
