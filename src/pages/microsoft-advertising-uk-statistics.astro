---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import data from '../data/ms-advertising-uk-stats.json';

const pageUrl = 'https://visible-ads.com/microsoft-advertising-uk-statistics/';
const csvUrl = 'https://visible-ads.com/downloads/microsoft-advertising-uk-statistics.csv';
const title = 'Microsoft Advertising UK Statistics | Visible Ads';
const description = 'Bing UK search share (StatCounter), Microsoft\'s own comScore audience claim and Ofcom reach, side by side with what each one measures. Sourced and dated.';
const pct = (v: number) => `${v}%`;

const faqs = [
  { question: 'What is Bing\'s search share in the UK?', answer: 'StatCounter put Bing at 6.08% of UK search engine referrals across all platforms in September 2026. On desktop it was 18.33% and on mobile 0.43%. StatCounter counts search engine referrals to the sites in its network, not the number of searches performed.' },
  { question: 'How many people use Bing in the UK?', answer: 'Ofcom reported that 39% of UK online adults visited Bing in May 2024, which is 18.5 million adults. That was down from 46% in May 2023. The 2025 Ofcom report gave a Google figure (82% in May 2025) but we found no Bing reach figure in it.' },
  { question: 'Why does Microsoft say 33.5% when StatCounter says 6.08%?', answer: 'They count different things. Microsoft\'s 33.5% is a PC market share for the Microsoft Advertising Network for Search in December 2025, from comScore, desktop traffic only. StatCounter\'s 6.08% is a share of search engine referrals across all platforms in September 2026. Different measure, different devices, different month.' },
  { question: 'Is 33.5% Bing\'s market share in the UK?', answer: 'No. Microsoft labels it the PC market share of its advertising network for search, from comScore, desktop traffic only. Microsoft\'s page does not break the network down, so it should not be quoted as the share of bing.com.' },
  { question: 'How big is the Microsoft Advertising audience in the UK?', answer: 'Microsoft\'s search data page lists 43 million unique PC users and 1.5 billion monthly PC searches in the United Kingdom, citing comScore qSearch for December 2025, desktop traffic only. It is a vendor figure and covers PCs only.' },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Microsoft Advertising UK statistics: Bing share, reach and audience",
      "description": description,
      "url": pageUrl,
      "mainEntityOfPage": pageUrl,
      "datePublished": "2026-10-19",
      "dateModified": "2026-10-19",
      "author": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/visible-ads-og.png"
    },
    {
      "@type": "Dataset",
      "name": "Microsoft Advertising and Bing UK statistics: share, audience and reach",
      "description": "UK search engine share from StatCounter (September 2026), Microsoft Advertising's comScore PC search data (December 2025) and Ofcom Online Nation reach figures (May 2023 to May 2025), each with source, URL, data date and retrieved date.",
      "url": pageUrl,
      "creator": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "dateModified": "2026-10-19",
      "keywords": ["Bing UK market share", "Microsoft Advertising audience UK", "Ofcom Online Nation search reach"],
      "spatialCoverage": "United Kingdom",
      "temporalCoverage": "2023-04/2026-09",
      "isBasedOn": [
        "https://gs.statcounter.com/search-engine-market-share/all/united-kingdom",
        "https://about.ads.microsoft.com/en/tools/planning/search-data",
        "https://www.ofcom.org.uk/siteassets/resources/documents/research-and-data/online-research/online-nation/2024/online-nation-2024-report.pdf",
        "https://www.ofcom.org.uk/siteassets/resources/documents/research-and-data/online-research/online-nation/2025/online-nations-report-2025.pdf"
      ],
      "distribution": { "@type": "DataDownload", "encodingFormat": "text/csv", "contentUrl": csvUrl }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Microsoft Advertising UK statistics", "item": pageUrl }
      ]
    }
  ]
};

const comparison = [
  { source: 'StatCounter', counts: 'Search engine referrals to sites in its network', who: 'Page views on sites running StatCounter code', devices: 'All, desktop or mobile, shown separately', period: 'Sep 2026', value: '6.08% (all), 18.33% (desktop), 0.43% (mobile)' },
  { source: 'Microsoft, citing comScore', counts: 'PC market share for the Microsoft Advertising Network for Search, plus searches and users', who: 'comScore qSearch, custom cut', devices: 'PC only', period: 'Dec 2025', value: '33.5% PC market share, 43 million users' },
  { source: 'Ofcom, using Ipsos iris', counts: 'UK online adults who visited bing.com in the month', who: 'Ipsos iris panel, adults 18+', devices: 'Smartphones, tablets and computers', period: 'May 2024', value: '39% of UK online adults (18.5 million)' },
];
---

<Layout title={title} description={description} schema={schema}>

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <nav class="text-sm text-slate-light mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Microsoft Advertising UK statistics</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">UK data, sourced and dated</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Microsoft Advertising UK statistics: Bing share, reach and audience</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed mb-4">Bing had 6.08% of UK search engine referrals in September 2026 (StatCounter), but 18.33% on desktop and 0.43% on mobile. Microsoft's own comScore figure gives its search network a 33.5% PC market share (December 2025). Ofcom found 39% of UK online adults visited Bing in May 2024. Each number measures something different.</p>
        <p class="text-sm text-slate-light">Last checked {data.checkedLabel}. Every figure below was read from the publisher's own page or report.</p>
      </div>
    </div>
  </section>

  <!-- StatCounter -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">How much of UK search does Bing have?</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed max-w-3xl">Bing had 6.08% of UK search engine referrals across all platforms in September 2026 (StatCounter), with Google ahead of every other engine. The device split is the part to notice.</p>

      <table class="stat-table">
        <thead>
          <tr><th>Device</th><th>Google</th><th>Bing</th><th>Yahoo!</th><th>DuckDuckGo</th><th>Ecosia</th><th>Source and URL</th><th>Data date</th><th>Retrieved</th></tr>
        </thead>
        <tbody>
          {data.statcounter.map((r) => (
            <tr>
              <th scope="row" data-label="Device">{r.device}</th>
              <td data-label="Google">{pct(r.google)}</td>
              <td data-label="Bing" class="hl">{pct(r.bing)}</td>
              <td data-label="Yahoo!">{pct(r.yahoo)}</td>
              <td data-label="DuckDuckGo">{pct(r.duckduckgo)}</td>
              <td data-label="Ecosia">{pct(r.ecosia)}</td>
              <td data-label="Source and URL" class="src"><a href={r.sourceUrl} rel="noopener">StatCounter Global Stats</a><span class="url">{r.sourceUrl}</span></td>
              <td data-label="Data date">{r.dataLabel}</td>
              <td data-label="Retrieved">19 Oct 2026</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-sm text-gray-600 mt-3 mb-8">Yandex is in the CSV download and is not shown here. Shares are of search engine referrals, per StatCounter.</p>

      <div class="max-w-3xl">
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Bing is at 18.33% on desktop and 0.43% on mobile. The all-platforms figure of 6.08% sits between the two, so it depends on how much of the tracked traffic comes from each device.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Ofcom gives a reason in its 2024 report: Bing's reach is probably relatively high on computers because it is the default search engine in Microsoft Edge and Internet Explorer. Google's reach is probably high on smartphones because it is the default on Android devices and in Safari on Apple devices.</p>
      </div>
    </div>
  </section>

  <!-- Microsoft -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What does Microsoft say about its UK audience?</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed max-w-3xl">Microsoft Advertising lists 43 million unique PC users, 1.5 billion monthly PC searches and a 33.5% PC market share for its search network in the UK (comScore, December 2025). We read the page in a browser with the United Kingdom selected, and the United States and global views for comparison.</p>

      <table class="stat-table">
        <thead>
          <tr><th>Market</th><th>Monthly PC searches</th><th>Unique PC users</th><th>PC market share</th><th>Source and URL</th><th>Data date</th><th>Retrieved</th></tr>
        </thead>
        <tbody>
          {data.microsoft.map((r) => (
            <tr>
              <th scope="row" data-label="Market">{r.market}</th>
              <td data-label="Monthly PC searches">{r.searches}</td>
              <td data-label="Unique PC users">{r.users}</td>
              <td data-label="PC market share" class="hl">{r.share}</td>
              <td data-label="Source and URL" class="src"><a href={r.sourceUrl} rel="noopener">Microsoft Advertising search data</a><span class="url">{r.sourceUrl}</span></td>
              <td data-label="Data date">{r.dataLabel}</td>
              <td data-label="Retrieved">19 Oct 2026</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-sm text-gray-600 mt-3 mb-8">Microsoft's footnote for the UK row reads: "Comscore qSearch (custom), December 2025, United Kingdom, desktop traffic only."</p>

      <div class="max-w-3xl">
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Three things limit how far this can be pushed. It is Microsoft's own page, so it is a vendor claim. The label is the Microsoft Advertising Network for Search, so the 33.5% is not the share of bing.com on its own. And it covers PCs only, with no mobile or tablet view.</p>
        <p class="text-lg text-gray-700 leading-relaxed">The page does not say what the share is a share of, so we do not try to reverse it into a market size. If you are deciding where this network fits in a paid search plan, our <a href="/bing-ads/" class="text-electric underline hover:text-electric-dark">Microsoft Advertising management</a> starts with how much extra demand your own keywords can reach.</p>
      </div>
    </div>
  </section>

  <!-- Ofcom -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">How many UK adults use Bing?</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed max-w-3xl">39% of UK online adults, or 18.5 million people, visited Bing in May 2024, according to Ofcom's Online Nation report. Ofcom uses Ipsos iris panel data and counts the share of UK online adults (18+) who visited a service in the month. That is reach, which is a count of people, not a count of searches.</p>

      <table class="stat-table">
        <thead>
          <tr><th>Search engine</th><th>Reach of UK online adults</th><th>Adult visitors</th><th>Source and URL</th><th>Data date</th><th>Retrieved</th></tr>
        </thead>
        <tbody>
          {data.ofcom.map((r) => (
            <tr>
              <th scope="row" data-label="Search engine">{r.engine}</th>
              <td data-label="Reach of UK online adults" class="hl">{r.reach}</td>
              <td data-label="Adult visitors">{r.visitors || 'Not stated in the text we read'}</td>
              <td data-label="Source and URL" class="src"><a href={r.sourceUrl} rel="noopener">{r.sourceName.split(' (')[0]}</a><span class="url">{r.sourceUrl}</span></td>
              <td data-label="Data date">{r.period}</td>
              <td data-label="Retrieved">19 Oct 2026</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="text-sm text-gray-600 mt-3 mb-8">Ofcom's 2024 report lists Bing as the only search engine other than Google that reached more than 3% of UK online adults in May 2024. Google Search excludes Maps, Shopping, Play and News.</p>

      <div class="max-w-3xl">
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Ofcom ties the 2023 peak to Microsoft adding an AI chat tool to Bing in February 2023. Reach hit 46% in April 2023, then slowly declined and stabilised in April 2024 at a level Ofcom says is still higher than before the AI tool. It also warns that some visitors to bing.com may be using Copilot rather than Bing search.</p>
        <p class="text-lg text-gray-700 leading-relaxed">This is the oldest of the three sets of figures. Ofcom's 2025 report gives Google's May 2025 reach as 82%, but we found no Bing reach figure in the text, so May 2024 is the latest Bing figure here.</p>
      </div>
    </div>
  </section>

  <!-- Reconcile -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Why do the three numbers differ?</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed max-w-3xl">6.08%, 33.5% and 39% all get quoted as "Bing's share". None of them is. Here they are on one line each.</p>

      <table class="stat-table">
        <thead>
          <tr><th>Source</th><th>What is counted</th><th>Who is measured</th><th>Devices</th><th>Period</th><th>Bing headline</th></tr>
        </thead>
        <tbody>
          {comparison.map((r) => (
            <tr>
              <th scope="row" data-label="Source">{r.source}</th>
              <td data-label="What is counted">{r.counts}</td>
              <td data-label="Who is measured">{r.who}</td>
              <td data-label="Devices">{r.devices}</td>
              <td data-label="Period">{r.period}</td>
              <td data-label="Bing headline" class="hl">{r.value}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="max-w-3xl mt-8">
        <ul class="list-disc pl-6 text-lg text-gray-700 space-y-3 leading-relaxed">
          <li><strong class="text-navy">The unit is different.</strong> StatCounter says its search engine stats are based on referrals, "not the number of searches performed". Microsoft reports searches and users. Ofcom reports the share of people who visited in a month.</li>
          <li><strong class="text-navy">The population is different.</strong> StatCounter draws on sites that run its code, comScore on its own panel and Ipsos iris on a panel of UK adults described by Ofcom as representative of the UK online adult population.</li>
          <li><strong class="text-navy">The device is different.</strong> Microsoft's figure is PC only. Bing's desktop share on StatCounter is 18.33%, and its mobile share is 0.43%. Ofcom's reach covers all three device types.</li>
          <li><strong class="text-navy">The thing measured is different.</strong> Microsoft's label is a search network. StatCounter and Ofcom name Bing.</li>
          <li><strong class="text-navy">The month is different.</strong> The three headline figures run from May 2024 to September 2026.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Which to quote -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Which number should you quote?</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Pick the one that matches your sentence, and name it.</p>
      <ul class="list-disc pl-6 text-lg text-gray-700 mb-6 space-y-3 leading-relaxed">
        <li>For Bing's share of UK search engine referrals, quote StatCounter and give the device and month.</li>
        <li>For the number of people Bing reaches, quote Ofcom and give the year, which is May 2024.</li>
        <li>For the size of Microsoft's advertising network on PCs, quote Microsoft and call it a vendor figure.</li>
      </ul>
      <p class="text-lg text-gray-700 leading-relaxed">Do not average them, subtract one from another or put 33.5% next to 6.08% as if both were Bing's share. Share figures also do not tell you what Microsoft traffic will cost or convert for your products. Our <a href="/blog/google-ads-vs-bing-ads/" class="text-electric underline hover:text-electric-dark">comparison of the two ad platforms</a> covers how to test that with your own data.</p>
    </div>
  </section>

  <!-- Limits and method -->
  <section class="py-16 lg:py-20 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What these figures do not cover</h2>
      <ul class="list-disc pl-6 text-lg text-gray-700 mb-6 space-y-3 leading-relaxed">
        <li>There is no cost per click or conversion rate here. We did not find an official UK figure for either from Microsoft, so we have left them out.</li>
        <li>StatCounter is a sample of sites that use its code, not a census of UK searches.</li>
        <li>The Ofcom reach figure is from May 2024, more than two years before the StatCounter month.</li>
        <li>Microsoft's search data page is a vendor claim, and its comScore cut is custom.</li>
      </ul>
      <h3 class="text-xl font-heading font-bold text-navy mb-3">Method</h3>
      <p class="text-lg text-gray-700 leading-relaxed">On {data.checkedLabel} we opened each source. StatCounter and Microsoft's page load their values with JavaScript, so we read them in a browser with the right market selected. The Ofcom figures come from the text and tables of its two PDF reports. We calculated nothing: every number is shown as the publisher printed it.</p>
    </div>
  </section>

  <!-- Download and cite -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Download the data and cite it</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">All three tables are in one CSV, one row per figure, with the source, URL, data date and retrieved date.</p>
      <p class="mb-8"><a href="/downloads/microsoft-advertising-uk-statistics.csv" download class="inline-flex items-center justify-center bg-electric text-white font-semibold px-6 py-3 rounded-xl hover:bg-electric-dark transition-colors">Download the CSV</a></p>
      <h3 class="text-xl font-heading font-bold text-navy mb-3">How to cite this page</h3>
      <p class="text-gray-700 leading-relaxed mb-4">Visible Ads, "Microsoft Advertising UK statistics: Bing share, reach and audience", https://visible-ads.com/microsoft-advertising-uk-statistics/, last checked {data.checkedLabel}.</p>
      <p class="text-gray-700 leading-relaxed">If you quote a number, cite the publisher named in its table row as well.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Frequently asked questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              {faq.question}
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner badges -->
  <section class="py-12 bg-white border-y border-gray-100" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-24 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">See what Microsoft traffic does in your account</h2>
      <p class="text-lg text-slate-light mb-8">Market figures show the size of the audience, and only your account shows whether it pays. We will review your Microsoft Advertising data against your margins.</p>
      <a href="/free-bing-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Request a free Microsoft Ads audit</a>
    </div>
  </section>

</Layout>

<style>
  .stat-table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--color-gray-200); border-radius: 1rem; overflow: hidden; font-size: 0.95rem; }
  .stat-table thead th { background: var(--color-navy); color: #fff; text-align: left; font-family: var(--font-heading); font-weight: 600; font-size: 0.8rem; padding: 0.85rem 0.9rem; vertical-align: bottom; }
  .stat-table tbody th, .stat-table tbody td { text-align: left; padding: 0.85rem 0.9rem; border-top: 1px solid var(--color-gray-200); vertical-align: top; color: #374151; }
  .stat-table tbody th { color: var(--color-navy); font-family: var(--font-heading); font-weight: 700; }
  .stat-table tbody tr:nth-child(even) { background: var(--color-gray-50); }
  .stat-table .hl { color: var(--color-electric-dark); font-weight: 700; }
  .stat-table .src a { color: var(--color-electric-dark); text-decoration: underline; }
  .stat-table .url { display: block; margin-top: 0.25rem; font-size: 0.72rem; color: var(--color-slate-dark); overflow-wrap: anywhere; word-break: break-all; }
  @media (max-width: 767px) {
    .stat-table, .stat-table tbody, .stat-table tr, .stat-table th, .stat-table td { display: block; width: 100%; }
    .stat-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .stat-table { border: 0; background: transparent; }
    .stat-table tbody tr { background: #fff !important; border: 1px solid var(--color-gray-200); border-radius: 0.75rem; margin-bottom: 1rem; overflow: hidden; }
    .stat-table tbody th { background: var(--color-sky-tint); border-top: 0; font-size: 1.05rem; }
    .stat-table tbody td { display: flex; justify-content: space-between; gap: 1rem; text-align: right; }
    .stat-table tbody td::before { content: attr(data-label); flex: 0 0 38%; text-align: left; font-weight: 600; color: var(--color-slate-dark); }
    .stat-table tbody td.src { display: block; text-align: left; }
    .stat-table tbody td.src::before { display: block; margin-bottom: 0.25rem; }
  }
</style>
