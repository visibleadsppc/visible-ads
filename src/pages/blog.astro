---
import Layout from '../layouts/Layout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Insights & Guides | Visible Ads Blog",
      "description": "Expert perspectives on paid search, eCommerce advertising, and digital growth strategy.",
      "url": "https://visible-ads.com/blog",
      "publisher": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" }
      ]
    }
  ]
};

const posts = [
  { slug: 'target-roas-by-margin', category: 'Strategy', title: 'Target ROAS by Margin: Setting Profit Goals in Google Ads', excerpt: 'Stop guessing your target ROAS. Derive it from your contribution margin and the profit you want to keep, with a worked example and the mistakes to avoid.' },
  { slug: 'value-based-bidding', category: 'Strategy', title: 'Value-Based Bidding: Feeding Profit Into Google Ads', excerpt: 'Google bids to the conversion value you send it. Feed profit instead of revenue with margin-adjusted values, and let automated bidding optimise to profit.' },
  { slug: 'break-even-roas', category: 'Strategy', title: 'Break-Even ROAS: The Number Every Advertiser Should Know', excerpt: 'Break-even ROAS is 1 divided by your margin. How to calculate it for your account, gross versus contribution margin, and how to find campaigns below it.' },
  { slug: 'profit-first-ppc', category: 'Strategy', title: 'Profit-First PPC: Run Google Ads for Profit, Not Revenue', excerpt: 'Revenue targets quietly lose money. Learn profit-first PPC, POAS, break-even ROAS by margin, and the weekly rulebook we use to scale Google Ads on profit.' },
  { slug: 'sephra-europe-case-study', category: 'Case Study', title: 'Sephra Europe: 1149% ROAS Through Google & Amazon Ads', excerpt: 'How we generated £2.31M conversion value and 1149% ROAS for Sephra Europe through integrated Google and Amazon advertising.' },
  { slug: 'food-beverage-case-study', category: 'Case Study', title: 'F&B eCommerce Brand: 1118% ROAS While Cutting Spend', excerpt: 'How we transformed a UK food & beverage brand\'s Google Ads, achieving 1118% ROAS while actually reducing ad costs by £805.' },
  { slug: 'luxury-architecture-case-study', category: 'Case Study', title: 'Luxury Architecture: £255 to £16 Cost Per Lead', excerpt: 'How we slashed cost-per-lead from £255 to £16 for a luxury architectural finishes brand through targeted Google Ads.' },
  { slug: 'chatgpt-ads', category: 'AI & Advertising', title: 'ChatGPT Ads and Shopping for Ecommerce', excerpt: 'A source-backed guide to ChatGPT ads, shopping product results, availability and practical ecommerce readiness.' },
  { slug: 'ads-in-the-age-of-ai-summaries', category: 'AI & Advertising', title: 'Ads in the Age of AI Summaries', excerpt: 'How AI summaries from ChatGPT and Gemini are reshaping paid advertising and what UK businesses should do to adapt.' },
  { slug: 'meta-ads-vs-google-ads-ecommerce', category: 'Comparison', title: 'Meta Ads vs Google Ads for eCommerce', excerpt: 'Head-to-head comparison of Meta Ads and Google Ads for UK eCommerce, costs, ROAS data, and when to use each platform.' },
  { slug: 'google-ads-vs-bing-ads', category: 'Comparison', title: 'Google Ads vs Bing Ads: Which Platform Delivers Better ROI?', excerpt: 'A data-driven comparison of audience reach, cost-per-click, features, and ROI across both platforms.' },
  { slug: 'strategic-amazon-presence', category: 'Amazon', title: 'Why Amazon Advertising Is Non-Negotiable', excerpt: 'Why UK brands need a strategic Amazon presence, marketplace data and advertising tactics for sustainable growth.' },
  { slug: '7-tips-boost-amazon-sales', category: 'Amazon', title: '7 Insider Tips to Boost Amazon Sales', excerpt: 'Seven insider strategies to increase your Amazon sales, from Sponsored Products to listing optimisation.' },
  { slug: 'google-ads-and-cro', category: 'Google Ads', title: 'Google Ads + CRO: The Indispensable Duo', excerpt: 'How combining Google Ads with conversion rate optimisation multiplies your ROI, the strategy most agencies miss.' },
  { slug: 'google-ads-strategy-business-growth', category: 'Google Ads', title: 'Google Ads Strategy for Business Growth', excerpt: 'A strategic approach to Google Ads for UK businesses, campaign structure and bidding tactics that drive profitable growth.' },
  { slug: '24-google-ads-strategies', category: 'Google Ads', title: '24 Expert Google Ads Strategies', excerpt: '24 expert strategies to maximise your Google Ads sales, bidding tactics and campaign structure tips that drive ROI.' },
  { slug: 'how-much-google-ads-cost-uk', category: 'Google Ads', title: 'How Much Do Google Ads Cost in the UK?', excerpt: 'Average CPC data by industry, campaign type breakdowns, and bidding strategy guidance for UK businesses.' },
  { slug: 'performance-max-lead-generation', category: 'Google Ads', title: 'Performance Max for Lead Gen: A Guide', excerpt: 'How to use Google Performance Max campaigns for lead generation, setup and optimisation tactics that work.' },
  { slug: 'click-fraud-strategies', category: 'Google Ads', title: 'Click Fraud: 13 Strategies to Combat It', excerpt: 'The growing problem of click fraud in Google Ads, 13 proven strategies to protect your ad spend from invalid clicks.' },
  { slug: '7-ways-paid-search-business-goals', category: 'Paid Search', title: '7 Ways Paid Search Achieves Business Goals', excerpt: 'Seven proven ways paid search advertising drives business growth, from lead generation to brand awareness.' },
  { slug: 'cro-crucial-for-google-ads', category: 'Conversion', title: 'Why CRO Is Crucial for Google Ads', excerpt: 'Stop wasting ad spend, why conversion rate optimisation is the missing piece in your Google Ads strategy.' },
  { slug: 'what-is-ecro', category: 'Conversion', title: 'What Is eCRO? How CRO Multiplies Your Ad Spend', excerpt: 'How eCommerce conversion rate optimisation turns existing traffic into more revenue without increasing budgets.' },
  { slug: 'ppc-vs-seo', category: 'Strategy', title: 'PPC vs SEO: Why the Best Strategy Uses Both', excerpt: 'Compare timelines, costs, and compounding effects of PPC and SEO, and learn why an integrated approach wins.' },
  { slug: 'amazon-ads-cost-uk', category: 'Amazon', title: 'How Much Do Amazon Ads Cost in the UK?', excerpt: 'CPC ranges, ACOS benchmarks, and a full breakdown of Sponsored Products, Brands, and Display costs for UK sellers.' },
  { slug: 'deepseek-ai-digital-marketing', category: 'AI & Advertising', title: 'DeepSeek: AI Disruptor Reshaping Marketing', excerpt: 'How DeepSeek is disrupting AI and what it means for digital marketing and paid advertising strategies.' },
  { slug: 'cfw-case-study', category: 'Case Study', title: 'CFW: Amazon & Google Ads Case Study', excerpt: 'CFW generated £6M in return from £500K in Google Ads spend: a 12x ROAS. Amazon performance is reported separately.' },
  { slug: 'iwholesales-case-study', category: 'Case Study', title: 'iWholesales: 450% Sales Growth', excerpt: 'iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.' },
  { slug: 'uk-ecommerce-awards-nomination', category: 'News', title: 'UK eCommerce Awards Nomination', excerpt: 'Visible Ads nominated for the UK eCommerce Awards, recognition of our results-driven approach.' },
];
---

<Layout title="Insights & Guides | Visible Ads Blog" description="Expert perspectives on paid search, eCommerce advertising, and digital growth strategy from Visible Ads." schema={schema}>

  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white mb-6 leading-tight">Insights & Guides</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">Expert perspectives on paid search, eCommerce advertising, and digital growth strategy.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
            <div class="p-8">
              <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-xs font-semibold rounded-full mb-4">{post.category}</span>
              <h2 class="font-heading text-lg font-bold text-navy mb-3 group-hover:text-electric transition-colors leading-snug">{post.title}</h2>
              <p class="text-slate text-sm leading-relaxed mb-4">{post.excerpt}</p>
              <span class="text-electric font-semibold text-sm group-hover:underline inline-flex items-center gap-1">
                Read More
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Put These Insights Into Action?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free, no-obligation audit of your advertising and discover exactly where you can improve.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
