---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const faqs = [
  {
    question: 'What does an ecommerce PPC agency do?',
    answer: 'Visible Ads covers Google Ads, Google Shopping, Amazon Ads, Microsoft Advertising and paid social on Meta, TikTok and LinkedIn. Each channel is judged against your margin.',
  },
  {
    question: 'Do you run Amazon and Google ads for the same brand?',
    answer: 'Yes. Our Amazon and Google Ads page explains how the two work together.',
    link: { phrase: 'Amazon and Google Ads', href: '/amazon-google-ads/' },
  },
  {
    question: 'How do we start?',
    answer: 'Book a free profit audit. It covers the paid channels you already run.',
  },
  {
    question: 'Is ROAS or profit the target?',
    answer: "Profit's the target. We use ROAS each week to decide where the budget goes.",
  },
  {
    question: 'How much does ecommerce PPC management cost?',
    answer: 'A free audit shows which tier fits your ad budget. The tiers are listed on our PPC management page.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Ecommerce PPC Agency',
      serviceType: 'Ecommerce PPC management',
      provider: { '@type': 'Organization', name: 'Visible Ads', url: 'https://visible-ads.com' },
      description: 'Ecommerce PPC management for online shops across paid search, Amazon and paid social. Every channel is judged against margin.',
      url: 'https://visible-ads.com/ecommerce-ppc-agency/',
      areaServed: 'GB',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://visible-ads.com/' },
        { '@type': 'ListItem', position: 2, name: 'Ecommerce PPC Agency', item: 'https://visible-ads.com/ecommerce-ppc-agency/' },
      ],
    },
  ],
};

const channels = [
  { name: 'Google Ads', href: '/google-ads/', text: 'Search, Shopping, Performance Max, Display and YouTube campaigns.' },
  { name: 'Google Shopping', href: '/google-shopping-ads/', text: 'Shopping ads built from your product data.' },
  { name: 'Amazon Ads', href: '/amazon/', text: 'Sponsored Products, Brands and Display campaigns.' },
  { name: 'Microsoft Advertising', href: '/bing-ads/', text: 'Bing search, with eligible ads shown in Copilot.' },
  { name: 'Meta, TikTok and LinkedIn', href: '/paid-social/', text: 'Paid social that creates demand.' },
  { name: 'Large catalogues', href: '/high-sku-advertising/', text: 'Advertising for catalogues of thousands of products.' },
];

const faqParts = (faq) => {
  if (!faq.link) return [faq.answer, '', ''];
  const i = faq.answer.indexOf(faq.link.phrase);
  return [faq.answer.slice(0, i), faq.link.phrase, faq.answer.slice(i + faq.link.phrase.length)];
};
---

<Layout title="Ecommerce PPC Agency | Visible Ads" description="Ecommerce PPC agency running Google, Amazon, Microsoft and paid social against your margin. Weekly budget rules, clear pricing and a free audit to start." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-light mb-8"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span class="text-white">Ecommerce PPC Agency</span></nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Google Partner, Microsoft Advertising Partner, Amazon Ads Verified Partner, Meta Business Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Ecommerce PPC Agency</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">Visible Ads is an ecommerce PPC agency. Our ecommerce PPC services cover paid search, marketplace ads and paid social for online shops. We judge every channel against your margin.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free ecommerce ads audit</a>
          <a href="#channels" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See what we manage</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Channels -->
  <section id="channels" class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What our ecommerce PPC management covers</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Ecommerce PPC management is the ongoing running of pay-per-click ads for an online shop. Our ecommerce paid media agency work covers the six channels below.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {channels.map((c) => (
          <a href={c.href} class="group bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
            <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">{c.name}</h3>
            <p class="text-gray-700 text-sm">{c.text}</p>
          </a>
        ))}
      </div>
      <p class="text-gray-700 mt-8 max-w-3xl leading-relaxed">Our ecommerce advertising agency team plans the channels together. Our <a href="/multi-channel-services/" class="text-electric underline hover:text-electric-dark">multi-channel services</a> explain how.</p>
    </div>
  </section>

  <!-- Who -->
  <section class="py-16 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">Who we work with</h2>
      <p class="text-lg text-gray-700 leading-relaxed">Most of our clients are ecommerce and B2B businesses turning over £1M to £20M. They sell in the UK, the US or Europe.</p>
    </div>
  </section>

  <!-- Profit -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Profit decides the budget</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Profit's the target. We use ROAS each week to decide where the budget goes.</p>
      <p class="text-lg text-gray-700 leading-relaxed">A strong ROAS can still lose money once margin is counted. You can work out your break-even point with the <a href="/roas-vs-profit/" class="text-electric underline hover:text-electric-dark">ROAS vs profit calculator</a>.</p>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-16 bg-sky-tint" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Proof from Google and Amazon accounts</h2>
      <p class="text-lg text-gray-700 leading-relaxed mb-4">CFW's Google Ads rebuild turned £500K of spend into £6M of return. That's a 12x ROAS across the whole Google account.</p>
      <p class="text-lg text-gray-700 leading-relaxed mb-4">The CFW Amazon account is one we've managed. All-time ad spend is £91,902.91 and sales are £769,025.79 across 17,566 purchases.</p>
      <p class="text-gray-700">Full detail is in the <a href="/case-studies/cfw/" class="text-electric underline hover:text-electric-dark">CFW case study</a>.</p>
    </div>
  </section>

  <!-- Pricing pointer -->
  <section class="py-16 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">What it costs</h2>
      <p class="text-lg text-gray-700 leading-relaxed">We charge a monthly fee for each channel we manage plus VAT. That fee covers as many campaigns as you need on that channel. Your ad budget is paid to the platforms separately.</p>
      <p class="text-lg text-gray-700 leading-relaxed mt-4">See the tiers and terms under <a href="/ppc-management/#pricing" class="text-electric underline hover:text-electric-dark">PPC management pricing</a>.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Ecommerce PPC questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group border border-gray-200 rounded-xl p-6">
            <summary class="cursor-pointer font-heading font-semibold text-navy">{faq.question}</summary>
            <p class="mt-4 text-gray-700 leading-relaxed">{faqParts(faq)[0]}{faq.link && <a href={faq.link.href} class="text-electric underline hover:text-electric-dark">{faq.link.phrase}</a>}{faqParts(faq)[2]}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Find out which channel is earning your next pound</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit of your ecommerce ad accounts.</p>
      <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free ecommerce ads audit</a>
    </div>
  </section>

</Layout>
