---
import Layout from '../layouts/Layout.astro';
import AiAnswerPanel from '../components/visuals/AiAnswerPanel.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const canonical = "https://visible-ads.com/seo/";

const faqs = [
  {
    q: "What is GEO?",
    a: "GEO (generative engine optimisation) is the work of making a brand easy for AI answer engines to find, understand and name accurately, then measuring whether they do. It sits on top of normal SEO and uses the same site, content and profiles."
  },
  {
    q: "Do I need llms.txt or special schema to appear in AI answers?",
    a: "No. Google Search Central says: \"You don't need to create new machine readable files, AI text files, or markup to appear in these features.\" It also says: \"There's also no special schema.org structured data that you need to add.\" We do not sell either as a route into AI answers."
  },
  {
    q: "Can you guarantee that ChatGPT will recommend my business?",
    a: "No. Nobody controls what an AI engine writes. We measure the answers, fix the causes we can reach on your site and profiles, and report the result next to your enquiries. We do not guarantee citations, rankings or traffic."
  },
  {
    q: "How do you measure GEO results?",
    a: "We run a fixed panel of buyer prompts across ChatGPT, Perplexity, Google AI Overviews and Copilot, where each is available. Runs where an engine gives no answer, or no AI Overview appears, are recorded separately. Retained clients get the same panel every month. Mentions and citations are counted separately and can overlap. We read them next to AI referral sessions in GA4 and your enquiries."
  },
  {
    q: "How much do SEO and GEO cost?",
    a: "No price is published. The monthly SEO and GEO fee is quoted after the free check."
  },
  {
    q: "Which areas do you work in?",
    a: "We are based in Kingston upon Thames. We work with businesses in Kingston, Surbiton, New Malden, Richmond, Twickenham, Wimbledon, Esher, Thames Ditton, Epsom, Leatherhead, Woking and Guildford, and with ecommerce and B2B brands across the UK."
  },
  {
    q: "How does SEO and GEO fit with Google Ads?",
    a: "Paid search can reach buyers while campaigns are running. SEO and GEO aim to build organic visibility that can continue after paid campaigns stop. Search terms from paid campaigns also give us real buyer questions for the prompt panel."
  },
  {
    q: "How long until I see results?",
    a: "We give no date. Fixes to crawling and indexing can be seen soon after they go live. Changes in rankings and AI answers vary by site and competition. For retained clients we repeat the same panel monthly and report what changed."
  }
];

const areas = [
  { name: "Kingston upon Thames", line: "Where Visible Ads is based. We test prompts that name Kingston and prompts that do not. We record which brings your business up." },
  { name: "Surbiton", line: "Part of the Royal Borough of Kingston. Buyers may write Surbiton or Kingston. We test both place names." },
  { name: "New Malden", line: "Also in the Royal Borough of Kingston. We check that your site and your profiles give the same address and service area." },
  { name: "Richmond", line: "Richmond upon Thames is its own borough. We test whether answers place your business in Richmond or in neighbouring Kingston." },
  { name: "Twickenham", line: "In the London Borough of Richmond upon Thames. We compare how Google results and AI answers describe your service area." },
  { name: "Wimbledon", line: "In the London Borough of Merton, close to Kingston. We record which firms the engines name for Wimbledon prompts." },
  { name: "Esher", line: "In Surrey, close to Kingston. We test prompts with Surrey and London place names. The panel then reflects how your buyers describe you." },
  { name: "Thames Ditton", line: "In Surrey, next to Kingston. We test prompts that name Thames Ditton, Kingston or both." },
  { name: "Epsom", line: "In Surrey. We test local prompts and prompts from buyers who compare firms across several Surrey towns." },
  { name: "Leatherhead", line: "In Surrey. We check that your listings and your site state the same service area and the same services." },
  { name: "Woking", line: "In Surrey. We test whether answers name local firms or national ones for Woking prompts." },
  { name: "Guildford", line: "In Surrey. We map which directories and review sites the answers cite for Guildford prompts." }
];

const signals = [
  { signal: "Mentions", counts: "Runs where an engine names your brand, whether or not it cites your site.", source: "Prompt panel" },
  { signal: "Citations", counts: "Runs where an answer cites a URL on your site, whether or not it names your brand.", source: "Prompt panel" },
  { signal: "Recommendations", counts: "Runs where an engine explicitly recommends your brand.", source: "Prompt panel" },
  { signal: "AI referral sessions", counts: "Visits that arrive from AI assistants and carry a referrer.", source: "GA4" },
  { signal: "Enquiries", counts: "Form, call and email enquiries, plus how the buyer says they found you.", source: "Your enquiry tracking" }
];

const steps = [
  { t: "Technical SEO foundations", d: "Crawling, indexing, page speed and internal links come first. Google and the AI search products must be able to read the site and reach the pages that bring enquiries." },
  { t: "Content that answers buyer questions", d: "Each section opens with the answer and keeps its evidence close. Pages are built around the question a buyer asks. The prompts from your check supply those questions." },
  { t: "Entity consistency", d: "One set of facts for your name, services, location and people. We make the site and your profiles say the same thing. Consistent site and profile information can reduce conflicting details." },
  { t: "Mentions on the sources answers cite", d: "The check lists the sources each answer cites. Answers may lean on directories, review sites or trade publications. Where they do, accurate listings may be a next step. We promise no links and no coverage." }
];

const places = areas.map((a) => a.name);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://visible-ads.com/#organization",
      "name": "Visible Ads",
      "url": "https://visible-ads.com/",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kingston-Upon-Thames",
        "addressCountry": "GB"
      }
    },
    {
      "@type": "Service",
      "name": "SEO and GEO",
      "serviceType": "Search engine optimisation and generative engine optimisation",
      "description": "SEO and AI search visibility (GEO) for UK ecommerce and B2B brands, starting with a free AI search visibility check.",
      "url": canonical,
      "provider": { "@id": "https://visible-ads.com/#organization" },
      "areaServed": [
        { "@type": "Country", "name": "United Kingdom" },
        { "@type": "AdministrativeArea", "name": "Surrey" },
        ...places.map((n) => ({ "@type": "Place", "name": n }))
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "SEO and GEO", "item": canonical }
      ]
    }
  ]
};

const related = [
  { href: "/local-seo/", t: "Local SEO", d: "The map results and the Google Business Profile, for businesses that sell to a place." },
  { href: "/google-ads/", t: "Google Ads management", d: "Paid search that buys demand today." },
  { href: "/ppc-management/", t: "PPC management", d: "Multi-channel paid media management." },
  { href: "/chatgpt-ads-ecommerce/", t: "ChatGPT ads and commerce readiness", d: "The paid side of ChatGPT, kept apart from organic visibility." },
  { href: "/blog/chatgpt-ads/", t: "ChatGPT ads in the UK", d: "Availability, rules and a controlled test." },
  { href: "/blog/ads-in-the-age-of-ai-summaries/", t: "Ads in the age of AI summaries", d: "Why ads, organic links and citations are reported separately." }
];
---

<Layout title="SEO Agency Kingston and Surrey | SEO and GEO | Visible Ads" description="SEO and GEO agency in Kingston upon Thames and Surrey. Start with a free AI search visibility check across ChatGPT, Perplexity, Google AI Overviews and Copilot." canonical={canonical} schema={schema}>

  <!-- Hero: the first screen is the offer and a picture of its report -->
  <section class="relative py-14 lg:py-20 overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-light mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2 text-slate">/</span>
        <span class="text-white" aria-current="page">SEO and GEO</span>
      </nav>
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-14 items-start">
        <div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-5">SEO and GEO agency in Kingston upon Thames and Surrey</h1>
          <p class="text-lg sm:text-xl text-slate-light mb-6 leading-relaxed">Visible Ads helps UK ecommerce and B2B brands improve their visibility in Google and measures how they appear in AI answers. We start with a free AI search visibility check.</p>
          <ol class="space-y-3 mb-8 text-white">
            <li class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-white text-navy font-bold text-sm flex items-center justify-center" aria-hidden="true">1</span><span>We test a fixed set of buyer prompts in ChatGPT, Perplexity, Google AI Overviews and Copilot, where each is available.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-white text-navy font-bold text-sm flex items-center justify-center" aria-hidden="true">2</span><span>You see where your brand appears and who is named instead.</span></li>
            <li class="flex gap-3"><span class="shrink-0 w-7 h-7 rounded-full bg-white text-navy font-bold text-sm flex items-center justify-center" aria-hidden="true">3</span><span>You see which sources the answers cite.</span></li>
          </ol>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/contact/?topic=seo-geo-check" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-bold px-8 py-4 rounded-xl hover:bg-cta-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors text-lg">Book your free check</a>
            <a href="#measure" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/30 hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors">See how we measure it</a>
          </div>
          <p class="text-sm text-slate-light mt-5">The check is free. If you want ongoing support, we quote a monthly fee after the check. First reply to your enquiry within 1 working day.</p>
        </div>

        <AiAnswerPanel>For each prompt and engine the worst run sets the result shown: absent, mentioned, cited or recommended. Mentions and citations are also counted as separate signals and can overlap. The report also lists who is named instead and the sources cited. The entries above are placeholders.</AiAnswerPanel>
      </div>
    </div>
  </section>

  <section class="py-8 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What the check is -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What the free AI search visibility check covers</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The check tests the questions your buyers ask AI engines in ChatGPT, Perplexity, Google AI Overviews and Copilot, where each is available, and records what each engine says. Prompts are based on the words your buyers use for the need. Prompts that name Kingston or Surrey are added when your buyers are local.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Each prompt runs at least three times over at least two days. The worst run sets the score for that prompt and engine. Runs where an engine gives no answer, or where no AI Overview appears, are recorded separately and are not counted as your brand being absent.</p>
      <p class="text-lg text-gray-700 leading-relaxed">The check records where your brand appears, who is named instead and the sources each answer cites. For retained clients the same panel is repeated monthly.</p>
    </div>
  </section>

  <!-- Measurement -->
  <section id="measure" class="py-16 lg:py-20 bg-sky-tint scroll-mt-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">How we measure GEO</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">We report five separate signals and never merge them into one score. For the three panel signals, the worst run sets the result for each prompt and engine. None of them is read as proof of revenue.</p>
      <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
        <table class="w-full text-left">
          <caption class="sr-only">The five signals used to measure GEO</caption>
          <thead class="hidden sm:table-header-group bg-navy text-white text-sm">
            <tr>
              <th scope="col" class="px-5 py-3 font-semibold">Signal</th>
              <th scope="col" class="px-5 py-3 font-semibold">What it counts</th>
              <th scope="col" class="px-5 py-3 font-semibold">Where it comes from</th>
            </tr>
          </thead>
          <tbody>
            {signals.map((s) => (
              <tr class="block sm:table-row border-b border-gray-200 last:border-b-0 px-5 py-4 sm:p-0">
                <th scope="row" class="block sm:table-cell sm:px-5 sm:py-4 font-heading font-bold text-navy">{s.signal}</th>
                <td class="block sm:table-cell sm:px-5 sm:py-4 text-gray-700">{s.counts}</td>
                <td class="block sm:table-cell sm:px-5 sm:py-4 text-gray-700 text-sm sm:text-base"><span class="sm:hidden font-semibold text-navy">Source: </span>{s.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-lg text-gray-700 mt-8 mb-6 leading-relaxed">For retained clients we repeat the same prompt panel every month, so a change is something we can observe, not proof of cause. A citation is not a recommendation. A mention is not a citation, though one run can be both.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Counts under about 30 are reported as counts with no percentage growth. GA4 only sees visits that carry a referrer. We record the gap. We read the panel next to your enquiries and report both.</p>
      <AiAnswerPanel mode="method" id="method" class="mt-8" />
    </div>
  </section>

  <!-- Work -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What the SEO and GEO work involves</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">The work is four jobs, done in this order. Each one is on your site or in profiles you control.</p>
      <ol class="space-y-6 mb-10">
        {steps.map((s, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 w-9 h-9 rounded-full bg-navy text-white font-heading font-bold flex items-center justify-center" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="text-xl font-heading font-bold text-navy mb-1">{s.t}</h3>
              <p class="text-gray-700 leading-relaxed">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <blockquote class="border-l-4 border-electric bg-sky-tint rounded-r-xl p-6">
        <p class="text-lg text-navy leading-relaxed mb-3">"There are no additional requirements to appear in AI Overviews or AI Mode, nor other special optimizations necessary."</p>
        <footer class="text-sm text-gray-700">Google Search Central, <a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noopener noreferrer" class="text-electric underline hover:text-electric-dark">AI features and your website</a></footer>
      </blockquote>
      <p class="text-lg text-gray-700 mt-6 leading-relaxed">Google's line sets the limit of what any agency can do. The work is good SEO plus honest measurement of what AI answers say. We do not sell llms.txt or schema as a way into AI answers.</p>
    </div>
  </section>

  <!-- Areas -->
  <section id="areas" class="py-16 lg:py-20 bg-sky-tint scroll-mt-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">SEO and GEO for Kingston upon Thames and Surrey businesses</h2>
      <p class="text-lg text-gray-700 mb-10 max-w-3xl leading-relaxed">Visible Ads is based in Kingston upon Thames and works with businesses in the places below and across the UK. <a href="/local-seo/" class="text-electric underline hover:text-electric-dark">Local SEO</a> and GEO start with the place names your buyers use. The areas below show what we test for each.</p>
      <ul class="grid sm:grid-cols-2 gap-x-10">
        {areas.map((a) => (
          <li class="py-4 border-t border-slate-light/50">
            <h3 class="font-heading font-bold text-navy mb-1">{a.name}</h3>
            <p class="text-gray-700 leading-relaxed">{a.line}</p>
          </li>
        ))}
      </ul>
      <div class="mt-10 pt-6 border-t border-slate-light/50">
        <h3 class="font-heading font-bold text-navy mb-3">Paid search in these areas</h3>
        <p class="text-gray-700 mb-3">PPC and Google Ads for local businesses sit on their own pages.</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li><a href="/kingston-upon-thames/" class="text-electric underline hover:text-electric-dark">PPC agency in Kingston upon Thames</a></li>
          <li><a href="/surrey/" class="text-electric underline hover:text-electric-dark">PPC agency in Surrey</a></li>
          <li><a href="/richmond-upon-thames/" class="text-electric underline hover:text-electric-dark">PPC agency in Richmond upon Thames</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Profit and paid -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Why SEO and GEO are judged on enquiries and profit</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Visible Ads is a profit-first agency. SEO and GEO follow the same rule as our paid search. Visibility that brings no enquiry or sale is a cost. After the check, fixes are prioritised towards the pages that bring enquiries. Pages that do not lead to an enquiry come later.</p>
      <p class="text-lg text-gray-700 mb-10 leading-relaxed">Enquiries are counted from your own tracking. If that tracking is missing, fixing it is the first job.</p>

      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">How SEO and GEO work alongside paid search</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Paid search can reach buyers while campaigns are running. SEO and GEO aim to build organic visibility that can continue after paid campaigns stop. When we manage both, search terms from paid campaigns give the prompt panel real buyer questions.</p>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Paid placements in AI products follow separate rules from organic visibility. They are covered on their own pages. We keep their results out of the GEO signals above.</p>
      <ul class="grid sm:grid-cols-2 gap-4">
        {related.map((r) => (
          <li>
            <a href={r.href} class="block h-full rounded-xl border border-gray-200 p-5 hover:border-electric/40 hover:shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-electric transition-colors">
              <span class="block font-heading font-bold text-navy mb-1">{r.t}</span>
              <span class="block text-sm text-gray-700">{r.d}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-sky-tint">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">SEO and GEO questions</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 font-heading font-semibold text-navy text-lg hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-electric">
              {f.q}
              <svg class="w-5 h-5 text-electric shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 text-gray-700 leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Next step -->
  <section class="relative py-16 lg:py-24 bg-navy">
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-5">Start with the free AI search visibility check</h2>
      <p class="text-lg text-slate-light mb-4 leading-relaxed">After the check you get the findings and a quote for a monthly SEO and GEO plan. The check itself is free.</p>
      <p class="text-slate-light mb-8 leading-relaxed">We guarantee no citations, rankings or traffic.</p>
      <a href="/contact/?topic=seo-geo-check" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-bold px-10 py-4 rounded-xl hover:bg-cta-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors text-lg">Book your free check</a>
    </div>
  </section>

</Layout>
