---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServiceLinks from '../components/ServiceLinks.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "SEO Services",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "description": "Strategic SEO services that complement your paid campaigns. Technical audits, content strategy, and sustainable organic growth.",
      "url": "https://visible-ads.com/seo",
      "serviceType": "Search Engine Optimisation",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What's the difference between SEO and PPC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PPC delivers immediate traffic by paying for each click. SEO builds organic visibility over time, you earn clicks without paying per visit. The smartest strategy uses both: PPC for immediate results and testing, SEO for long-term compounding growth. Together, they dominate the search results page."
          }
        },
        {
          "@type": "Question",
          "name": "How long does SEO take to show results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Technical fixes can show impact within weeks. Content and authority building typically takes 3-6 months to produce measurable organic growth. SEO is a compounding investment, the longer you invest, the greater the returns. We provide monthly reports so you can track progress from day one."
          }
        },
        {
          "@type": "Question",
          "name": "What's included in your SEO services?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our SEO service covers technical site audits, on-page optimisation, content strategy and creation, internal linking architecture, and authority building through digital PR and link acquisition. We also provide monthly reporting, keyword tracking, and strategic recommendations."
          }
        },
        {
          "@type": "Question",
          "name": "How do you report on SEO performance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide monthly SEO reports covering keyword rankings, organic traffic, conversion data, and technical health metrics. Reports include plain-English commentary on what's working, what's changed, and what we're focusing on next. You also get access to live dashboards for real-time visibility."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "SEO", "item": "https://visible-ads.com/seo" }
      ]
    }
  ]
};
---

<Layout title="SEO Services | Organic Search Growth | Visible Ads" description="Strategic SEO services that complement your paid campaigns. Technical audits, content strategy, and sustainable organic growth." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-purple-900 to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Organic Search Growth</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">SEO That Compounds Your Paid Search Investment</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-4 leading-relaxed">PPC captures demand. SEO creates it. Together, they own the search results page. Our SEO services are built to amplify the ROI of your entire digital marketing stack.</p>
        <p class="text-sm text-slate-light/80 mb-8">Part of our integrated <a href="/multi-channel-services" class="text-electric-light underline hover:text-white">multi-channel growth strategy</a></p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free SEO Audit</a>
          <a href="#approach" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See Our Approach</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What We Do -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">What We Do</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We deliver SEO that works alongside your paid campaigns to dominate the search results page. When prospects see your brand in both paid and organic results, click-through rates increase by up to 30%. That synergy is what makes our approach different, we don't treat SEO as a separate channel, we treat it as a force multiplier for your entire search strategy.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Our technical audits uncover the crawling, indexing, and performance issues that silently throttle your organic visibility. From Core Web Vitals and site architecture to structured data and internal linking, we fix the foundations before building on top of them. Every technical recommendation is prioritised by impact so you see results, not just a list of issues.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Content strategy is where SEO compounds. We identify the topics, questions, and intent patterns your audience searches for, then build content that earns rankings and drives conversions. Combined with our <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads management</a> and <a href="/ecro" class="text-electric underline hover:text-electric-dark">conversion rate optimisation</a>, your organic presence grows month over month, reducing your long-term dependence on paid traffic while increasing overall profitability.</p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Approach</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Systematic SEO that builds sustainable organic growth.</p>
      </div>
      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="hidden lg:block absolute top-10 left-[calc(12.5%+24px)] right-[calc(12.5%+24px)] h-0.5 bg-electric/20"></div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Technical Audit</h3>
          <p class="text-gray-700">We crawl your entire site to identify technical barriers, crawl errors, slow pages, broken links, missing structured data, and indexing issues that suppress your rankings.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Content Strategy</h3>
          <p class="text-gray-700">We map your keyword landscape, identify content gaps, and build an editorial calendar targeting topics with proven commercial intent and realistic ranking potential.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">On-Page Optimisation</h3>
          <p class="text-gray-700">We optimise titles, meta descriptions, headings, internal links, and content structure across your priority pages to maximise relevance and click-through rate.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Link Building & Authority</h3>
          <p class="text-gray-700">We earn high-quality backlinks through digital PR, strategic partnerships, and content-led outreach that builds your domain authority and reinforces topical relevance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Why Choose Us</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">SEO built for businesses that already run paid search.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">+30%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Combined CTR Lift</div>
          <p class="text-gray-700 text-sm">Brands appearing in both paid and organic results see significantly higher click-through rates than either channel alone.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">£0</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Cost Per Organic Click</div>
          <p class="text-gray-700 text-sm">Once you rank, every click is free. SEO compounds over time, the investment today pays dividends for years.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">PPC+SEO</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Integrated Strategy</div>
          <p class="text-gray-700 text-sm">We use your PPC data to inform SEO priorities and vice versa, no siloed channels, just coordinated growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Study -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 sm:p-12 lg:p-16 max-w-4xl mx-auto">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-6">Case Study</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">Organic Growth That Amplifies Paid Performance</h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">For clients running both SEO and PPC with us, the combined effect consistently outperforms either channel alone. By aligning keyword targeting, sharing conversion data between channels, and ensuring total SERP coverage, our integrated clients see organic traffic grow 40-60% within six months, while their paid campaigns become more efficient as organic picks up high-volume head terms.</p>
        <div class="flex flex-wrap gap-8">
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">+52%</div>
            <div class="text-sm text-gray-700">Organic Traffic Growth</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">-23%</div>
            <div class="text-sm text-gray-700">Blended CPA Reduction</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">6 Months</div>
            <div class="text-sm text-gray-700">Time to Measurable Impact</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What's the difference between SEO and PPC?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">PPC delivers immediate traffic by paying for each click. SEO builds organic visibility over time, you earn clicks without paying per visit. The smartest strategy uses both: PPC for immediate results and testing, SEO for long-term compounding growth. Together, they dominate the search results page.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How long does SEO take to show results?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Technical fixes can show impact within weeks. Content and authority building typically takes 3-6 months to produce measurable organic growth. SEO is a compounding investment, the longer you invest, the greater the returns. We provide monthly reports so you can track progress from day one.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What's included in your SEO services?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Our SEO service covers technical site audits, on-page optimisation, content strategy and creation, internal linking architecture, and authority building through digital PR and link acquisition. We also provide monthly reporting, keyword tracking, and strategic recommendations.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How do you report on SEO performance?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">We provide monthly SEO reports covering keyword rankings, organic traffic, conversion data, and technical health metrics. Reports include plain-English commentary on what's working, what's changed, and what we're focusing on next. You also get access to live dashboards for real-time visibility.</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-navy text-center mb-8">Related Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/google-ads" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Our core PPC service, capture demand instantly while your organic rankings build.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/ecro" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Conversion Rate Optimisation</h3>
          <p class="text-gray-700 text-sm mb-3">Convert more of your organic traffic into revenue through data-driven testing.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos compact />
    </div>
  </section>

  <!-- Service Links -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServiceLinks current="/seo" />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Own the Organic Results?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free technical SEO audit that shows you exactly where your organic visibility is being held back, and how to fix it.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free SEO Audit</a>
    </div>
  </section>

</Layout>
