---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const faqs = [
  {
    question: 'What does a PPC consultant do?',
    answer: 'A PPC consultant plans, builds and runs your paid advertising and is accountable for what it earns. That means checking tracking against your real orders or leads, structuring accounts, cutting wasted spend, deciding budgets every week, testing ads and landing pages, and explaining the numbers in plain English.',
  },
  {
    question: 'How much does a PPC consultant cost?',
    answer: 'Visible Ads charges per channel managed plus VAT. Silver is £1,000 a month for ad budgets up to £3,000 (10 hours a month). Gold is £1,500 a month for budgets up to £20,000 (20 hours). Platinum is £2,000 a month plus 5% for budgets over £20,000 (35 hours and click-fraud protection). Creative is not included. Meta and Google need a one-off £1,000 tracking setup. The minimum term is three months and then it rolls monthly on 30 days notice.',
  },
  {
    question: 'Is a PPC consultant better than a PPC agency?',
    answer: 'Neither is better in every case. A large agency can offer more people and more services. A founder-led consultancy keeps the people who set your strategy close to your account. Ask any firm you are considering who makes the weekly budget decisions on your account and how many hours a month are contracted.',
  },
  {
    question: 'Do you work with businesses outside London?',
    answer: 'Yes. Visible Ads is London-based and works with ecommerce and B2B clients in the UK, US and Europe. Calls and video updates run weekly. Location does not limit the service.',
  },
  {
    question: 'Which platforms do you manage as a Google Ads consultant?',
    answer: 'Google Ads is the most common starting point and covers Search, Shopping, Performance Max, Display and YouTube. The same service extends to Microsoft Advertising, Amazon Ads, Meta, TikTok and LinkedIn when those channels make sense for your business.',
  },
  {
    question: 'How quickly will you reply to an enquiry?',
    answer: 'A first reply comes within one working day. That covers weekends. It refers to the first reply to your enquiry and carries no turnaround promise for the audit.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'PPC Consultant',
      serviceType: 'PPC Consultancy',
      provider: {
        '@type': 'Organization',
        name: 'Visible Ads',
        url: 'https://visible-ads.com',
        founder: { '@type': 'Person', name: 'Boh Tjarks', jobTitle: 'Founder' },
      },
      description: 'Founder-led PPC consultancy in London. Google Ads, Microsoft Advertising, Amazon Ads and Meta management judged against margin, with weekly budget rules and a free audit to start.',
      url: 'https://visible-ads.com/ppc-consultant/',
      areaServed: { '@type': 'Country', name: 'United Kingdom' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://visible-ads.com/' },
        { '@type': 'ListItem', position: 2, name: 'PPC Consultant', item: 'https://visible-ads.com/ppc-consultant/' },
      ],
    },
  ],
};

const glance = [
  'Founder-led PPC consultancy, London-based, founded by Boh Tjarks.',
  'Google Ads, Microsoft Advertising, Amazon Ads, Meta, TikTok and LinkedIn under one profit target.',
  'Fees from £1,000 a month per channel plus VAT. Monthly hours are stated for every tier.',
  'Weekly calls or video updates and a fixed set of weekly budget rules.',
  'A free profit audit to start. First reply inside one working day.',
];

const weekly = [
  { title: 'Tracking checked against real orders.', text: 'Platform conversions are compared with your shop, CRM or GA4 so decisions rest on sales that happened.' },
  { title: 'Waste removed.', text: 'Search terms, placements and audiences that spend without returning are excluded.' },
  { title: 'Budget moved on fixed rules.', text: 'Spend rises where the return supports it and drops where it does not.' },
  { title: 'Ads and landing pages tested.', text: 'New copy, creative and offers run as controlled tests. Conversion rate work runs alongside.' },
  { title: 'A plain English update.', text: 'A weekly call or video update, a KPI dashboard and a quarterly review.' },
];

const rules = [
  { roas: 'Above 1,200%', action: 'Raise budget 20% a week' },
  { roas: '900% to 1,100%', action: 'Raise budget 10% a week' },
  { roas: '600% to 800%', action: 'Hold budget' },
  { roas: '300% to 500%', action: 'Cut budget 20%' },
  { roas: 'Below 300%', action: 'Switch spend off' },
];

const compare = [
  { q: 'Who decides your weekly budget?', a: 'The founder-led team that wrote your plan. It applies the published rules below.', b: 'Often an account manager who reports to someone else.' },
  { q: 'How are hours stated?', a: '10, 20 or 35 hours a month, depending on the tier.', b: 'Often unstated, or shared across many accounts.' },
  { q: 'Who is on your calls?', a: 'The people doing the work, weekly.', b: 'Often account management. Specialists join as needed.' },
  { q: 'What suits it best?', a: 'Ecommerce and B2B brands with enough spend that waste shows on the P&L.', b: 'Very large multi-country programmes that need many specialists.' },
];
---

<Layout title="PPC Consultant London | Google Ads Consultancy | Visible Ads" description="Founder-led PPC consultant in London. Google Ads and multi-channel management judged against margin, from £1,000 a month, with a free audit to start." schema={schema}>

  <!-- Hero -->
  <section class="relative py-16 lg:py-24 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-light mb-8"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span class="text-white">PPC Consultant</span></nav>
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
        <div class="lg:col-span-3">
          <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Google Partner, Microsoft Advertising Partner, Amazon Ads Verified Partner, Meta Business Partner</span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">PPC Consultant in London for Ecommerce and B2B Brands</h1>
          <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">Boh Tjarks founded Visible Ads. It is a founder-led PPC consultancy that manages your Google Ads and other paid channels every week and judges them against your margin. Fees start at £1,000 a month per channel plus VAT.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
            <a href="/contact/" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">Talk to Boh</a>
          </div>
        </div>
        <aside class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-xl" aria-label="At a glance">
          <div class="flex items-center gap-4 mb-4">
            <img src="/images/boh.jpg" alt="Boh Tjarks, founder of Visible Ads" width="800" height="1034" class="w-16 h-20 rounded-lg object-cover" style="object-position: center 20%;" />
            <div>
              <h2 class="text-lg font-heading font-bold text-navy">At a glance</h2>
              <p class="text-sm text-gray-600">Boh Tjarks, Founder, Visible Ads</p>
            </div>
          </div>
          <ol class="list-decimal pl-5 space-y-2 text-gray-700 text-sm">
            {glance.map((g) => <li>{g}</li>)}
          </ol>
        </aside>
      </div>
    </div>
  </section>

  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Who you get -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Who you actually work with</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Visible Ads is a founder-led, London-based PPC consultancy. Boh Tjarks founded it. Your account sits with the people who set the strategy. The agency is a Google Partner, Microsoft Advertising Partner, Amazon Ads Verified Partner and Meta Business Partner. It won at the UK Search Awards in 2022.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Visible Ads manages £3M of annual ad spend. The clients are mostly ecommerce and B2B businesses turning over £1M to £20M a year in the UK, US and Europe. Clients in the UK, US and Europe work with Visible Ads the same way through weekly calls or video updates. You can read more about the people on the <a href="/about/" class="text-electric underline hover:text-electric-dark">about page</a>.</p>
    </div>
  </section>

  <!-- Why the model works -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Why a founder-led consultancy works for PPC</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">PPC rewards fast, well informed decisions. Search terms change daily. Margins differ by product. A budget rule is only useful if the person applying it understands why it exists. Every handover between a strategist, an account manager and a specialist adds delay and loses detail.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">A consultancy keeps that chain short. The people who wrote your plan review your numbers each week. A tracking problem or a wasteful campaign gets fixed in the conversation where it is spotted. Each tier states its monthly hours. You know what you are paying for.</p>
      <ul class="space-y-4 text-lg text-gray-700 leading-relaxed">
        <li class="border-l-4 border-electric pl-5"><strong class="text-navy">Silver at £1,000 a month.</strong> 10 hours a month for ad budgets up to £3,000.</li>
        <li class="border-l-4 border-electric pl-5"><strong class="text-navy">Gold at £1,500 a month.</strong> 20 hours a month for budgets up to £20,000.</li>
        <li class="border-l-4 border-electric pl-5"><strong class="text-navy">Platinum at £2,000 a month plus 5%.</strong> 35 hours a month and click-fraud protection for budgets over £20,000.</li>
      </ul>
      <p class="text-gray-700 mt-6 leading-relaxed">All fees are per channel plus VAT and cover unlimited campaigns on that channel. Creative is not included. Meta and Google need a one-off £1,000 tracking setup. The minimum term is three months and then it rolls monthly on 30 days notice. A performance model with a reduced or zero retainer and a revenue share is available by application. The full breakdown sits on the <a href="/ppc-management/" class="text-electric underline hover:text-electric-dark">PPC management services</a> page.</p>
    </div>
  </section>

  <!-- Comparison -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">PPC consultant or large agency: what to compare</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed max-w-3xl">Ask any firm these questions before you sign. The table shows how Visible Ads answers them and what is often the case elsewhere.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200">
        <table class="w-full text-left text-base">
          <caption class="sr-only">Founder-led consultancy compared with a typical large agency</caption>
          <thead class="bg-navy text-white"><tr><th class="p-4">Question</th><th class="p-4">Visible Ads</th><th class="p-4">Typical large agency</th></tr></thead>
          <tbody class="text-gray-700">
            {compare.map((c, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th class="p-4 font-semibold text-navy align-top">{c.q}</th><td class="p-4 align-top">{c.a}</td><td class="p-4 align-top">{c.b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Weekly work -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What a Google Ads consultant does for you each week</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Most clients begin with Google Ads and add Microsoft Advertising, Amazon, Meta or other channels later. The weekly routine is the same on each.</p>
      <ul class="space-y-4 text-lg text-gray-700 leading-relaxed">
        {weekly.map((w) => (
          <li class="border-l-4 border-electric pl-5"><strong class="text-navy">{w.title}</strong> {w.text}</li>
        ))}
      </ul>
      <p class="text-gray-700 mt-6 leading-relaxed">The service page for <a href="/google-ads/" class="text-electric underline hover:text-electric-dark">Google Ads management</a> covers the platform in detail.</p>
    </div>
  </section>

  <!-- Budget rules -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">The rules behind every budget decision</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Profit is the goal and ROAS is the control the account is managed to. Each campaign sits in one weekly band and its budget moves to match. The decision does not depend on mood or on the temptation to keep spending.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200">
        <table class="w-full text-left text-base">
          <caption class="sr-only">Weekly budget rules by return on ad spend</caption>
          <thead class="bg-navy text-white"><tr><th class="p-4">Weekly ROAS</th><th class="p-4">What happens</th></tr></thead>
          <tbody class="text-gray-700">
            {rules.map((r, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th class="p-4 font-semibold text-navy">{r.roas}</th><td class="p-4">{r.action}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 mt-6 leading-relaxed">The bands sit alongside your margin. Use the <a href="/roas-vs-profit/" class="text-electric underline hover:text-electric-dark">ROAS vs profit calculator</a> to find your break-even point, and read <a href="/how-we-audit/" class="text-electric underline hover:text-electric-dark">how we audit an account</a> to see the method in full.</p>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What the work has produced</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Google Ads for CFW.co.uk between 1 August 2023 and 30 September 2026 returned £6,735,546.63 in conversion value on £554,818.75 of spend. That is about 12x ROAS across 686,404 clicks. The figure is Google's reported conversion value. It measures revenue and excludes profit.</p>
      <p class="text-lg text-gray-700 leading-relaxed">The <a href="/case-studies/" class="text-electric underline hover:text-electric-dark">case studies</a> list more examples with the channel and time window for each.</p>
    </div>
  </section>

  <!-- Who it suits -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Who this suits</h2>
      <ul class="space-y-3 text-lg text-gray-700 leading-relaxed list-disc pl-6 mb-6">
        <li>Ecommerce and B2B businesses spending enough on ads that waste shows up on the P&amp;L.</li>
        <li>Teams who want accountable people looking at the numbers every week.</li>
        <li>Owners who want to know the monthly hours and the fee before they sign.</li>
      </ul>
      <p class="text-lg text-gray-700 leading-relaxed">Agencies looking for delivery under their own brand should see the <a href="/white-label-ppc-seo-pricing-uk/" class="text-electric underline hover:text-electric-dark">white-label PPC pricing</a>. Start with a <a href="/free-ads-audit/" class="text-electric underline hover:text-electric-dark">free audit of your Google Ads, Amazon or Meta account</a> if you are comparing options. You see the findings before you commit to anything.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">PPC consultant questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group border border-gray-200 bg-white rounded-xl p-6">
            <summary class="cursor-pointer font-heading font-semibold text-navy">{faq.question}</summary>
            <p class="mt-4 text-gray-700 leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Start with a free profit audit</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">See where your ad spend is going against your margin. Book the audit or send an enquiry and you will get a first reply within one working day.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
        <a href="/contact/" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-10 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">Contact Boh</a>
      </div>
    </div>
  </section>

</Layout>
