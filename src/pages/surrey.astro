---
import Layout from '../layouts/Layout.astro';
import CountUp from '../components/CountUp.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';

const faqs = [
  { q: "Which Surrey towns does Visible Ads cover?", a: "We work with businesses across Surrey, in towns including Guildford, Woking, Godalming, Farnham, Epsom, Reigate, Redhill, Dorking, Staines and Camberley, and we also serve customers into South West London. Campaigns are built around the towns you sell into, not treated as one county postcode." },
  { q: "How much does PPC management cost for Surrey businesses?", a: "Fees are set per channel and rise with your ad budget, from £1,000 a month plus VAT on the entry tier. A free audit comes first, so you see a proposal before agreeing the three-month minimum term." },
  { q: "Can a small Surrey business use a PPC agency?", a: "Yes. The entry tier is built for ad budgets up to £3,000 a month and includes 10 hours of work a month, a KPI dashboard and weekly calls or video updates. The free audit shows whether your budget can support management, so you know before you commit." },
  { q: "Do you work with Surrey ecommerce brands as well as local service firms?", a: "Yes, and the setup differs. For ecommerce we start from product margin and set the target ROAS before choosing locations, while local service firms need call and form tracking so enquiries can be traced to the campaign that produced them." },
  { q: "What does Google Ads management in Surrey include?", a: "Search, Shopping and Performance Max campaigns, conversion tracking, search term and feed reviews, weekly budget decisions and regular reporting. We also run Microsoft Advertising, Meta, Amazon and LinkedIn where they fit." },
  { q: "Where is Visible Ads based, and can we meet?", a: "We're based in Kingston upon Thames, a London borough, and have no Surrey office. Most account work runs by weekly call or video." },
  { q: "Is a Surrey PPC agency different from a London one?", a: "Yes, the targeting differs, although the discipline is the same. Surrey firms often sell across several market towns and into South West London, while London firms usually need borough or postcode control.", link: { href: "/ppc-london/", text: "See how we handle PPC for London businesses" } },
];

const surreyTowns = ["Surrey", "Guildford", "Woking", "Godalming", "Farnham", "Epsom", "Reigate", "Redhill", "Dorking", "Staines", "Camberley"];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://visible-ads.com/#organization",
      "name": "Visible Ads",
      "description": "PPC and Google Ads agency serving Surrey businesses from Kingston upon Thames. Google Partner running Google Ads, Microsoft Advertising, Meta and Amazon for businesses across Guildford, Woking, Epsom, Staines, Camberley and the wider commuter belt.",
      "url": "https://visible-ads.com/",
      "telephone": "+447810477679",
      "email": "Boh@Visible-Ads.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kingston upon Thames",
        "addressRegion": "Greater London",
        "addressCountry": "GB"
      },
      "areaServed": surreyTowns.map((n, i) => ({ "@type": i === 0 ? "AdministrativeArea" : "City", "name": n })),
      "knowsAbout": ["Google Ads", "PPC Management", "SEO", "Amazon Advertising", "Paid Social", "Conversion Rate Optimisation"]
    },
    {
      "@type": "Service",
      "serviceType": "PPC and Google Ads management",
      "name": "PPC and Google Ads management for Surrey businesses",
      "provider": { "@id": "https://visible-ads.com/#organization" },
      "areaServed": { "@type": "AdministrativeArea", "name": "Surrey" },
      "url": "https://visible-ads.com/surrey/"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Surrey", "item": "https://visible-ads.com/surrey/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.link ? f.a + " " + f.link.text + ": https://visible-ads.com" + f.link.href : f.a }
      }))
    }
  ]
};
---

<Layout title="PPC Agency Surrey | Google Ads Agency | Visible Ads" description="PPC and Google Ads agency for Surrey businesses in Guildford, Woking, Epsom and more. From £1,000 a month per channel plus VAT, with a free audit first." schema={schema}>


  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <nav class="text-sm text-slate-light mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="mx-2 text-slate">/</span>
          <span class="text-white">Surrey</span>
        </nav>
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Surrey</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">PPC and Google Ads Agency in Surrey for Local and Ecommerce Businesses</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">Visible Ads is a Google Partner PPC agency that manages Google Ads, Microsoft Advertising, Meta and Amazon for Surrey businesses, from Guildford and Woking to Epsom, Staines and Camberley. Management starts at £1,000 a month per channel plus VAT, and the audit that comes first is free.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
          <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Why Surrey Businesses Choose Us -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Why Surrey Businesses Choose Visible Ads</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Surrey customers are spread over market towns such as Guildford, Woking, Epsom, Reigate, Farnham, Staines and Camberley, so one flat county target wastes budget in the busiest town and starves the rest.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Visible Ads is a founder-led Google Partner, Microsoft Advertising Partner, Amazon Ads Verified Partner and Meta Business Partner. We manage £3M a year in ad spend, and we won at the UK Search Awards 2022.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Visible Ads suits businesses whose ad spend is not returning what it should, or that plan to scale across several towns. We start with a free audit, then set the strategy and manage it weekly.</p>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section id="services" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">PPC Services for Surrey Businesses</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Pick the channels that fit your business.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/google-ads" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Search, Shopping, Performance Max, and remarketing campaigns engineered for profitable growth.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/bing-ads" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Bing Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Reach Surrey searchers on Microsoft's network, which runs as a separate auction from Google.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/seo" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">SEO Services</h3>
          <p class="text-gray-700 text-sm mb-3">Sustainable organic growth through technical SEO, content strategy, and authority building.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/paid-social" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.7 48.7 0 0 0 5.232-.537c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.4 48.4 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Paid Social Advertising</h3>
          <p class="text-gray-700 text-sm mb-3">Creative-led campaigns on Meta, TikTok, and LinkedIn that turn scrollers into buyers.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/amazon" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Amazon Ads & Marketplace</h3>
          <p class="text-gray-700 text-sm mb-3">Sponsored Products, Brands and DSP campaigns for Amazon sellers.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/ecro" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Conversion Rate Optimisation</h3>
          <p class="text-gray-700 text-sm mb-3">Turn more visitors into customers through data-driven A/B testing and UX improvements.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>


  <!-- How Surrey campaigns are built -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">How We Build Google Ads Campaigns Across Surrey Towns</h2>
        <p class="text-lg text-gray-700 leading-relaxed">We split the county into clusters before any money is spent, because a campaign that treats Surrey as one block tends to overspend in the busiest town. Each cluster below gets its own budget and report line.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-12">
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-200">
          <h3 class="font-heading font-bold text-navy mb-3">West Surrey</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Guildford, Godalming, Farnham and Woking, planned as one cluster.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-200">
          <h3 class="font-heading font-bold text-navy mb-3">East Surrey</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Epsom, Reigate, Redhill and Dorking, where many customers also look towards South West London.</p>
        </div>
        <div class="bg-sky-tint rounded-2xl p-6 border border-gray-200">
          <h3 class="font-heading font-bold text-navy mb-3">Thames corridor and north-west</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Staines and Camberley, grouped separately because demand can differ from the rest of the county.</p>
        </div>
      </div>
      <div class="max-w-3xl mx-auto">
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">That split shows which towns return profit, and budget then moves weekly under our scaling rules. We exclude areas you cannot serve, and locations are set to people in or regularly in the area.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Ecommerce brands in Surrey usually sell UK-wide, so for them the county matters less than product margin. We set target ROAS from your margin using the <a href="/roas-vs-profit/" class="text-electric underline hover:text-electric-dark">ROAS vs profit calculator</a> and keep county targeting for collection or local delivery.</p>
      </div>
    </div>
  </section>


  <!-- Surrey in numbers -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The South East Business Market in Numbers</h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">This bulletin reports business counts by region, so Surrey sits inside the South East figure. It counts businesses registered for VAT and/or PAYE.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm text-center">
            <p class="text-3xl font-heading font-extrabold text-electric mb-1">412,000</p>
            <p class="text-gray-700 text-sm">VAT and/or PAYE businesses in the South East</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm text-center">
            <p class="text-3xl font-heading font-extrabold text-electric mb-1">14.8%</p>
            <p class="text-gray-700 text-sm">of the 2.79 million in the UK</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm text-center">
            <p class="text-3xl font-heading font-extrabold text-electric mb-1">+7,000</p>
            <p class="text-gray-700 text-sm">more than in March 2025 (405,000)</p>
          </div>
        </div>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">The bulletin does not give a Surrey-only count, so we do not quote one. What the regional figure shows is a large and growing pool of firms competing for the same local searches, which is why we start a Surrey account with an audit of where spend currently goes.</p>
        <p class="text-sm text-gray-600 leading-relaxed">Source: Office for National Statistics, <a href="https://www.ons.gov.uk/businessindustryandtrade/business/activitysizeandlocation/bulletins/ukbusinessactivitysizeandlocation/2026" class="text-electric underline hover:text-electric-dark" rel="noopener">UK business: activity, size and location: 2026</a>, Table 4, published 24 September 2026; March 2025 comparison from the 2025 edition of the same bulletin. Retrieved 18 October 2026. Counts are rounded to the nearest thousand.</p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What PPC Management Costs for a Surrey Business</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">PPC management for a Surrey business costs from £1,000 a month plus VAT per channel, with unlimited campaigns on that channel. Your ad budget is paid to the platforms separately.</p>
        <ul class="list-disc pl-6 space-y-2 text-lg text-gray-700 mb-6 leading-relaxed">
          <li>Silver is £1,000 a month for ad budgets up to £3,000, with 10 hours of work a month.</li>
          <li>Gold is £1,500 a month for budgets up to £20,000, with 20 hours.</li>
          <li>Platinum is £2,000 a month plus 5% for budgets over £20,000, with 35 hours and click fraud protection.</li>
        </ul>
        <p class="text-lg text-gray-700 leading-relaxed">Your ad budget, creative and a one-off £1,000 tracking setup for Meta and Google sit outside the fee. We ask for three months to start, then it's month to month with 30 days' notice. A performance model with a reduced retainer is available by application, and the <a href="/ppc-management/#pricing" class="text-electric underline hover:text-electric-dark">full pricing breakdown</a> lists what each tier includes.</p>
      </div>
    </div>
  </section>

  <!-- Working from Kingston -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Where We Work From and How Surrey Accounts Run</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We're based in Kingston upon Thames, a London borough just over the Surrey border. We have no Surrey office. Most Surrey accounts run by weekly call or video, with a quarterly review.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Some Surrey campaigns cross into South West London. If your customers are on the London side, see our <a href="/kingston-upon-thames/" class="text-electric underline hover:text-electric-dark">PPC agency in Kingston upon Thames</a> page.</p>
      </div>
    </div>
  </section>



  <!-- Proof -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">Results from Accounts We Manage</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">These are examples from our client accounts rather than Surrey-specific results, and what you see depends on your margins and market.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="12" suffix="x" label="Google Ads ROAS" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">CFW</h3>
          <p class="text-gray-700 font-medium mb-6">£6.7M in return from £555K in Google Ads spend, from 1 August 2023 to 30 September 2026. Return is Google's conversion value, not profit.</p>
          <a href="/case-studies/cfw" class="text-electric font-semibold text-sm hover:underline">Read Case Study &rarr;</a>
        </div>
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="11" suffix="x" label="Google Ads ROAS" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">Japan Centre</h3>
          <p class="text-gray-700 font-medium">£32K in sales from £2.9K of spend in three weeks after the relaunch, up from 2x with the previous agency.</p>
        </div>
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="18" suffix="x" label="Lead Growth" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">Kitchen and Worktops</h3>
          <p class="text-gray-700 font-medium">Leads rose from 6 to 107 in four months on the same budget, a lead-generation account.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos />
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((f) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              {f.q}
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">{f.a}{f.link && (<> <a href={f.link.href} class="text-electric underline hover:text-electric-dark">{f.link.text}</a>.</>)}</div>
          </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Grow Your Surrey Business?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">The audit is free. We will show you where your ad spend is leaking, and how to fix it.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
