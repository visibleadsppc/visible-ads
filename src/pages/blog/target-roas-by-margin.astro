---
import Layout from '../../layouts/Layout.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';

const faqs = [
  { question: 'How do I calculate my target ROAS from margin?', answer: 'Start with your break-even ROAS, which is 1 divided by your contribution margin. A 40 percent margin gives a 2.5x break-even. Then lift the target above that floor by the profit you want to keep. If a 40 percent margin product breaks even at 2.5x and you want to hold back roughly 15 percent of revenue as profit, you aim for about a 4x target. The exact figure depends on your margin and profit goal, but the method is always break-even first, then add the profit you want on top.' },
  { question: 'What is a good target ROAS?', answer: 'It depends on your margin, so no single number is good for everyone. The answer above on what counts as a high target ROAS shows how to read a figure against your break-even.' },
  { question: 'Should I use one target ROAS for the whole account?', answer: 'Usually not. A single blended target across every product forces high-margin and low-margin lines to the same goal, which underspends the profitable ones and overspends the thin ones. Group products into margin bands and set a target ROAS for each band. High-margin lines can run a lower target and take more volume, while thin-margin lines are held to a stricter target that protects profit.' },
  { question: 'Why did my sales drop when I raised my target ROAS?', answer: 'Raising a target ROAS tells the bidding system to buy only cheaper conversions, so it stops entering more expensive auctions and volume falls. Push the target too high too fast and the campaign re-enters its learning phase and volume can collapse. Move a target in steps of around 10 to 15 percent, wait for the algorithm to settle over a week or two, then adjust again if the profit maths still supports it.' },
  { question: 'What is the difference between a new-customer and a blended target ROAS?', answer: 'A blended target treats every order the same, whether it comes from a first-time buyer or a repeat customer. A new-customer target looks at what a first order is worth once you account for the repeat orders that customer is likely to place. If your average customer buys three times, a first order that only breaks even can still be worth winning, so you can set a lower, more aggressive target on new customers and collect the profit on the repeats.' },
];

const highTarget = {
  question: 'What counts as a high target ROAS?',
  lead: 'A high target ROAS is one set well above your break-even ROAS, not a fixed number. The same 4x is a cautious target on a 50 percent margin and a loss-making one on a 20 percent margin, so read it against your own floor.',
  items: [
    'Work out break-even ROAS as 1 divided by your contribution margin.',
    'Add the profit you want to keep. The gap between target and break-even is your profit, so a higher target is only high relative to that floor.',
    'Expect volume to fall as you raise it. A very high target tells Google to bid only on the cheapest conversions, so check the sales you lose are not worth more than the profit you gain.',
  ],
  after: 'If you send profit rather than revenue as the conversion value, the maths simplifies. A target of 100 percent (1.0) is break-even, and anything above it is profit after ad spend.',
};

const allQa = [...faqs, highTarget];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Target ROAS by margin: setting profit goals in Google Ads",
      "description": "How to set your Google Ads target ROAS from contribution margin and the profit you want to keep, with a worked example and the mistakes to avoid.",
      "url": "https://visible-ads.com/blog/target-roas-by-margin",
      "datePublished": "2026-07-05",
      "dateModified": "2026-10-18",
      "author": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/og/target-roas-by-margin.png"
    },
    {
      "@type": "FAQPage",
      "mainEntity": allQa.map((q) => ({
        "@type": "Question",
        "name": q.question,
        "acceptedAnswer": { "@type": "Answer", "text": q.lead ? `${q.lead} ${q.items.map((t, i) => `${i + 1}. ${t}`).join(' ')}${q.after ? ' ' + q.after : ''}` : q.answer }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" },
        { "@type": "ListItem", "position": 3, "name": "Target ROAS by Margin", "item": "https://visible-ads.com/blog/target-roas-by-margin" }
