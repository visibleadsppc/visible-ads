---
import Layout from '../../layouts/Layout.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "CFW: Amazon & Google Ads Case Study",
      "description": "CFW generated £6M in return from £500K in Google Ads spend with Visible Ads: a 12x ROAS. Amazon performance is reported separately.",
      "url": "https://visible-ads.com/blog/cfw-case-study",
      "datePublished": "2024-10-17",
      "dateModified": "2026-05-26",
      "author": { "@type": "Person", "name": "Joe Short" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/visible-ads-og.png"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" },
        { "@type": "ListItem", "position": 3, "name": "CFW Case Study", "item": "https://visible-ads.com/blog/cfw-case-study" }
      ]
    }
  ]
};
---

<Layout title="CFW: Amazon & Google Ads Case Study | Visible Ads" description="CFW generated £6M in return from £500K in Google Ads spend with Visible Ads: a 12x ROAS. Amazon performance is reported separately." schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <nav class="text-sm text-slate-light mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">CFW Case Study</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Case Study</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">CFW: £6M Return From £500K Google Ads Spend</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">How Visible Ads helped Chocolate Fountain Warehouse recover from post-COVID stagnation with a strategic paid search approach across Google and Amazon.</p>
      </div>
    </div>
  </section>

  <!-- The Challenge -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The Challenge: Navigating a Changing Landscape</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Like many businesses, Chocolate Fountain Warehouse (CFW) -- a leading catering equipment and supplies provider -- faced significant challenges including stagnant post-COVID sales and the loss of a key supermarket client. Recognising the potential of direct-to-consumer eCommerce, they sought a partner to help them capitalise on this opportunity.</p>
      <p class="text-lg text-gray-700 leading-relaxed">CFW needed an agency that could build their D2C channel from the ground up, with expertise across both <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads</a> and <a href="/amazon" class="text-electric underline hover:text-electric-dark">Amazon Ads</a> to maximise their reach.</p>
    </div>
  </section>

  <!-- Strategic Approach -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Our Strategic Approach</h2>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">Targeted Audience Engagement</h3>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We identified and engaged high-income households and catering businesses through tailored Google and Amazon Ads campaigns, focusing spend on the audiences most likely to convert.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">Performance-Driven Optimisation</h3>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We continuously scaled ad budgets to maximise visibility and sales while maintaining a strict minimum Return on Ad Spend (ROAS) target. Every budget increase was justified by performance data.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">Conversion Rate Enhancement</h3>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We optimised product listings, implemented promotions, and introduced "Subscribe & Save" options to encourage repeat purchases -- turning one-time buyers into recurring customers.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">Transparent Data Insights</h3>
      <p class="text-lg text-gray-700 leading-relaxed">We provided CFW with real-time performance data through custom dashboards and reports, ensuring complete visibility into how their budget was performing.</p>
    </div>
  </section>

  <!-- Overcoming Obstacles -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Overcoming Obstacles</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We addressed CFW's initial lack of D2C expertise through comprehensive training and support. We resolved technical challenges including data feed errors and tracking implementation, and ensured full compliance with Amazon's HFSS regulations.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Our <a href="/seo" class="text-electric underline hover:text-electric-dark">SEO training</a> helped CFW build organic traffic alongside their paid campaigns, creating a sustainable multi-channel growth strategy.</p>
    </div>
  </section>

  <!-- Results -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The Results</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-xl p-6 shadow-md border border-gray-100">
          <p class="text-3xl font-heading font-bold text-electric mb-2">12x</p>
          <p class="text-gray-700 font-semibold mb-3">Google Ads ROAS</p>
          <p class="text-gray-700">£6M return from £500K in Google Ads spend.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-md border border-gray-100">
          <p class="text-3xl font-heading font-bold text-electric mb-2">8.5</p>
          <p class="text-gray-700 font-semibold mb-3">All-time Amazon ROAS</p>
          <p class="text-gray-700">£769,025.79 sales on £91,902.91 cost, with 17,566 purchases.</p>
        </div>
      </div>
      <blockquote class="border-l-4 border-electric pl-6 italic text-lg text-gray-700 leading-relaxed">"Our experience with Visible Ads has been exceptional. Their commitment to results, professionalism, and expertise has made them a trusted partner. We highly recommend them to any company seeking to enhance their digital marketing and achieve outstanding online performance." -- David Archer, Managing Director, Sephra Europe Limited & Chocolate Fountain Warehouse</blockquote>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-white border-y border-gray-100" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Achieve Results Like CFW?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit and discover how our Conversion Growth Blueprint can transform your eCommerce performance.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
