---
import Layout from '../../layouts/Layout.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "iWholesales: 450% Sales Growth",
      "description": "iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.",
      "url": "https://visible-ads.com/blog/iwholesales-case-study",
      "datePublished": "2025-02-25",
      "dateModified": "2025-04-10",
      "author": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/visible-ads-og.png"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" },
        { "@type": "ListItem", "position": 3, "name": "iWholesales Case Study", "item": "https://visible-ads.com/blog/iwholesales-case-study" }
      ]
    }
  ]
};
---

<Layout title="iWholesales: 450% Sales Growth | Visible Ads" description="iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience." schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <nav class="text-sm text-slate-light mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">iWholesales Case Study</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Case Study</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">iWholesales: 450% Sales Growth</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.</p>
      </div>
    </div>
  </section>

  <!-- The Challenge -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The Challenge: Navigating a Niche Market</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The airsoft market in the UK is competitive, with enthusiasts constantly searching for the latest gear and best deals. For iWholesales, the parent company behind OnlyBBGuns and Bespoke Airsoft, capturing this audience online was crucial.</p>
      <p class="text-lg text-gray-700 leading-relaxed">iWholesales faced the common challenges of eCommerce businesses: driving organic traffic, improving website visibility, and converting visitors into paying customers. However, the airsoft market presented unique considerations, a niche community with specific terminology and search behaviours, requiring a tailored <a href="/seo" class="text-electric underline hover:text-electric-dark">SEO</a> approach.</p>
    </div>
  </section>

  <!-- The Solution -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Website Visibility and Conversion Work</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The website work described here covers content creation, on-page optimisation and conversion rate optimisation. These activities focus on online visibility and the conversion experience.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">1. Content That Engages the Airsoft Community</h3>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We crafted in-depth articles covering topics the community actively searches for, beginner pistol guides, rifle reviews for UK skirmishing, playing style recommendations, and maintenance guides. These articles targeted relevant keywords as part of the wider work on website visibility and the conversion experience.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">2. Category and Product Page Optimisation</h3>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We meticulously optimised category pages with keyword research to identify high-volume, low-competition terms, optimised meta descriptions and title tags for click-through rates, created compelling category descriptions, and improved internal linking. Each product page was refined with detailed, keyword-rich descriptions, optimised alt text, and structured data markup.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">3. Conversion Rate Optimisation</h3>
      <p class="text-lg text-gray-700 leading-relaxed">We focused on improving the overall user experience to increase <a href="/ecro" class="text-electric underline hover:text-electric-dark">conversion rates</a>, streamlining the checkout process, improving website speed and mobile responsiveness, implementing clear calls to action, and adding customer reviews and testimonials. A/B testing on button colours, page layouts, and other elements identified what resonated best with users.</p>
    </div>
  </section>

  <!-- The Results -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The Results: 450% Sales Growth</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.</p>
      <h3 class="text-xl font-heading font-bold text-navy mb-4">Key Takeaways</h3>
      <ul class="list-disc list-inside text-lg text-gray-700 mb-6 space-y-3 leading-relaxed">
        <li>A comprehensive strategy combining content creation, on-page optimisation, and CRO is essential for driving organic growth</li>
        <li>Understanding the target audience and their search behaviour is crucial for success in niche markets</li>
        <li>Providing valuable and engaging content builds trust and authority</li>
        <li>Continuous optimisation and testing are necessary to maintain and improve results</li>
      </ul>
      <p class="text-lg text-gray-700 leading-relaxed">The work focused on helping relevant visitors find the website and improving their experience through to checkout.</p>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Want Results Like These for Your Business?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit of your ads and website, we will show you exactly where the growth opportunities are.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
