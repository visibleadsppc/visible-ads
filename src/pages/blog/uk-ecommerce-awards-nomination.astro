---
import Layout from '../../layouts/Layout.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "UK eCommerce Awards Nomination",
      "description": "Visible Ads has been shortlisted for eCommerce Search Campaign of the Year at the UK eCommerce Awards 2024 for our Google and Amazon Ads work with CFW.",
      "url": "https://visible-ads.com/blog/uk-ecommerce-awards-nomination",
      "datePublished": "2024-09-03",
      "dateModified": "2026-05-26",
      "author": { "@type": "Person", "name": "Boh Tjarks" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/visible-ads-og.png"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" },
        { "@type": "ListItem", "position": 3, "name": "UK eCommerce Awards", "item": "https://visible-ads.com/blog/uk-ecommerce-awards-nomination" }
      ]
    }
  ]
};
---

<Layout title="UK eCommerce Awards Nomination | Visible Ads" description="Visible Ads shortlisted for eCommerce Search Campaign of the Year at the UK eCommerce Awards 2024 for our Google and Amazon Ads campaign with CFW." schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <nav class="text-sm text-slate-light mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">UK eCommerce Awards</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">News</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Visible Ads Nominated for UK eCommerce Awards</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">Shortlisted for eCommerce Search Campaign of the Year at the UK eCommerce Awards 2024.</p>
      </div>
    </div>
  </section>

  <!-- Announcement -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">eCommerce Search Campaign of the Year</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We are delighted to announce that Visible Ads has been shortlisted for eCommerce Search Campaign of the Year at the UK eCommerce Awards 2024.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The campaign we entered is a combined <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads</a> and <a href="/amazon" class="text-electric underline hover:text-electric-dark">Amazon Ads</a> campaign for Chocolate Fountain Warehouse, a catering equipment supplier. Read the <a href="/blog/cfw-case-study" class="text-electric underline hover:text-electric-dark">full CFW case study</a> for the reported Google and Amazon results.</p>
    </div>
  </section>

  <!-- Strongest Year -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Our Strongest Year Yet</h2>
      <p class="text-lg text-gray-700 leading-relaxed">2024 has been our strongest year to date. Despite challenging economic conditions, our eCommerce offering continues to grow and thrive. This nomination is a testament to our team's dedication and the exceptional results we deliver for our clients across <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads</a>, <a href="/amazon" class="text-electric underline hover:text-electric-dark">Amazon Ads</a>, and <a href="/paid-social" class="text-electric underline hover:text-electric-dark">paid social</a>.</p>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Want Award-Winning Results for Your Business?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit and see how our team can deliver exceptional eCommerce performance for your brand.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
