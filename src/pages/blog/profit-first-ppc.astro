---
import Layout from '../../layouts/Layout.astro';
import PartnerBadges from '../../components/PartnerBadges.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Profit-First PPC: How to Run Google Ads for Profit, Not Revenue",
      "description": "A complete guide to profit-first PPC. Learn why revenue targets quietly lose money, how POAS and break-even ROAS work, and the weekly rulebook we use to scale Google Ads on profit.",
      "url": "https://visible-ads.com/blog/profit-first-ppc",
      "datePublished": "2026-07-04",
      "dateModified": "2026-07-04",
      "author": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "publisher": { "@type": "Organization", "name": "Visible Ads", "url": "https://visible-ads.com" },
      "image": "https://visible-ads.com/images/og/profit-first-ppc.png"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is profit-first PPC?",
          "acceptedAnswer": { "@type": "Answer", "text": "Profit-first PPC manages paid search against contribution, not revenue alone. Start with the direct costs attached to each sale, set a revenue ROAS floor from that contribution margin, and use contribution-valued conversion data only when the account can report it accurately. Budget then flows to products and campaigns that contribute profit." }
        },
        {
          "@type": "Question",
          "name": "Why does a high ROAS still lose money?",
          "acceptedAnswer": { "@type": "Answer", "text": "ROAS measures revenue returned per pound of spend, and revenue is not profit. A 4x ROAS on a product with a 20 percent contribution-margin rate can lose money once direct costs and ad spend are included. Revenue-only conversion values can favour low-margin volume; contribution-valued conversion data gives the platform a more useful signal." }
        },
        {
          "@type": "Question",
          "name": "How do I set a profit target for Google Ads?",
          "acceptedAnswer": { "@type": "Answer", "text": "Start with contribution amount: revenue less direct costs such as cost of goods, payment fees, shipping and returns. Divide it by revenue to calculate the contribution-margin rate. If Google Ads receives revenue as conversion value, break-even ROAS is 1 divided by that rate: a 40 percent contribution margin needs a 2.5x revenue ROAS. If it receives contribution before ad spend as conversion value, break-even is 1x. Set a higher target for overhead and desired profit." }
        },
        {
          "@type": "Question",
          "name": "What is break-even ROAS?",
          "acceptedAnswer": { "@type": "Answer", "text": "Break-even ROAS is the return-per-pound-of-spend figure at which advertising spend is covered by the contribution remaining after the included direct costs. For revenue-valued conversions, it equals 1 divided by the contribution-margin rate: a 25 percent rate needs a 4x revenue ROAS and a 50 percent rate needs 2x. For contribution-before-ad-spend conversion values, break-even is 1x. Set a higher target for overhead and desired profit." }
        },
        {
          "@type": "Question",
          "name": "When should I scale a profitable campaign?",
          "acceptedAnswer": { "@type": "Answer", "text": "Scale on a weekly cadence tied to profit, not on a single good day. Our rulebook increases budget by 20 percent a week above 1,200 percent ROAS, by 10 percent between 900 and 1,100 percent, holds between 600 and 800 percent, reduces spend between 300 and 500 percent, and switches off below 300 percent. Apply the rule alongside the account's verified contribution-margin floor." }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://visible-ads.com/blog" },
        { "@type": "ListItem", "position": 3, "name": "Profit-First PPC", "item": "https://visible-ads.com/blog/profit-first-ppc" }
      ]
    }
  ]
};
---

<Layout title="Profit-First PPC: Google Ads for Profit | Visible Ads" description="Revenue targets quietly lose money. Learn profit-first PPC: POAS, break-even ROAS by margin, and the weekly rulebook we use to scale on profit." image="/images/og/profit-first-ppc.png" schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <nav class="text-sm text-slate-light mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-white">Profit-First PPC</span>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Strategy</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Profit-First PPC: Run Google Ads for Profit, Not Revenue</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">Most Google Ads accounts are optimised to the wrong number. They chase revenue and report a healthy ROAS while the bank balance quietly shrinks. This guide shows you how to flip the target to profit, and manage spend to the number that actually pays your bills.</p>
      </div>
    </div>
  </section>

  <!-- The revenue trap -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The revenue trap</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Ask most advertisers how their Google Ads are doing and they will quote a ROAS: 4x, 6x, 10x. It sounds like a scoreboard, and it feels like winning. The problem is that ROAS measures revenue, and revenue is not the same as profit. A campaign can post a strong ROAS every single week and still lose money on every order it brings in.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The cause sits in the conversion value you send. A revenue-based conversion value tells the algorithm that a sale is worth its full sticker price. The bidding system then does exactly what you asked and hunts for the cheapest possible revenue. That usually means low-margin bestsellers, heavily discounted lines and products that sell easily but return almost nothing once you subtract cost of goods, payment fees, shipping and returns. The revenue looks great. The contribution to profit is thin or negative.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Profit-first PPC fixes the incentive at its root. You optimise to profit rather than revenue, so every bidding decision is weighed against what the sale is actually worth. Nothing else about the account has to change for this to move the needle. The lever is the target.</p>

      <figure class="content-visual mt-10">
        <svg role="img" aria-labelledby="chart-title-1 chart-desc-1" viewBox="0 0 720 430" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:720px;height:auto;">
          <title id="chart-title-1">A 4x ROAS can still lose money on a 20 percent contribution margin</title>
          <desc id="chart-desc-1">On 1,000 pounds of ad spend a 4x ROAS returns 4,000 pounds of revenue, but a 20 percent contribution margin leaves only 800 pounds after direct costs. After the 1,000 pounds of ad spend is paid, the campaign is 200 pounds in the red.</desc>
          <rect width="720" height="430" fill="#EFF6FF"/>
          <text x="360" y="36" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" fill="#0A1628">A 4x ROAS can still lose money</text>
          <text x="360" y="60" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="#64748B">1,000 pounds ad spend, 4x ROAS, 20 percent contribution margin</text>
          <line x1="70" y1="350" x2="660" y2="350" stroke="#94A3B8" stroke-width="1.5"/>
          <text x="64" y="354" text-anchor="end" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#94A3B8">0</text>
          <!-- Revenue -->
          <rect x="110" y="90" width="120" height="260" fill="#2563EB"/>
          <text x="170" y="82" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="700" fill="#2563EB">£4,000</text>
          <text x="170" y="372" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0A1628">Revenue</text>
          <text x="170" y="390" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#64748B">what ROAS reports</text>
          <!-- Gross profit -->
          <rect x="300" y="298" width="120" height="52" fill="#34A853"/>
          <text x="360" y="290" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="700" fill="#2E8B4A">£800</text>
          <text x="360" y="372" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0A1628">Gross profit</text>
          <text x="360" y="390" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#64748B">20 percent margin</text>
          <!-- Profit after ad spend (negative) -->
          <rect x="490" y="350" width="120" height="13" fill="#EA4335"/>
          <text x="550" y="404" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="700" fill="#EA4335">-£200</text>
          <text x="550" y="424" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0A1628">Profit after ad spend</text>
        </svg>
        <figcaption>The revenue looks healthy, but once ad spend is paid a 4x ROAS on a 20 percent margin leaves a 200 pound loss on every 1,000 pounds spent.</figcaption>
      </figure>
    </div>
  </section>

  <!-- What profit-first means -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What profit-first PPC actually means</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Profit-first PPC uses ROAS as a control metric, not a substitute for profit. ROAS is revenue divided by ad cost. First calculate contribution before advertising: revenue less direct costs such as cost of goods, fees, fulfilment and returns. In this guide, POAS means that pre-ad contribution divided by ad spend. Report the contribution remaining after ad spend separately, rather than treating it as the same metric.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">The two numbers can tell opposite stories on the same account. A 4x ROAS looks like a win, yet on a product carrying a 20 percent contribution margin it is a loss once the ad spend is paid. We walk through that exact scenario in <a href="/roas-vs-profit" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">ROAS vs profit: why a high ROAS can still lose money</a>, with a calculator you can run against your own figures. That page makes the gap between the two numbers concrete in about thirty seconds.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Everything that follows in this guide is about turning that single idea into an operating system: the numbers you need before you spend, how to feed profit into the platform, how to scale on it, and how to structure an account so the profitable products get the budget.</p>
    </div>
  </section>

  <!-- Four numbers -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">The four numbers to fix before you spend</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Profit-first PPC starts before a single bid is placed. You need four numbers on the table, because they set the targets everything else is measured against.</p>
      <div class="overflow-x-auto mb-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-navy text-white">
              <th class="px-5 py-4 font-heading font-semibold text-sm">Number</th>
              <th class="px-5 py-4 font-heading font-semibold text-sm">What it is</th>
              <th class="px-5 py-4 font-heading font-semibold text-sm">Why it matters</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="bg-white border-b border-gray-100">
              <td class="px-5 py-4 font-semibold text-navy">Contribution margin</td>
              <td class="px-5 py-4">Contribution amount: price minus direct costs; contribution-margin rate: that amount divided by price</td>
              <td class="px-5 py-4">The real money left to cover ads and profit</td>
            </tr>
            <tr class="bg-gray-50 border-b border-gray-100">
              <td class="px-5 py-4 font-semibold text-navy">Break-even ROAS</td>
              <td class="px-5 py-4">For revenue-valued conversions: 1 divided by contribution-margin rate (as a decimal)</td>
              <td class="px-5 py-4">The floor for the direct costs included in the calculation; set a higher target for overhead and desired profit</td>
            </tr>
            <tr class="bg-white border-b border-gray-100">
              <td class="px-5 py-4 font-semibold text-navy">Target POAS</td>
              <td class="px-5 py-4">Contribution before ad spend divided by ad spend</td>
              <td class="px-5 py-4">A value-aligned efficiency metric; post-ad contribution is reported separately</td>
            </tr>
            <tr class="bg-gray-50">
              <td class="px-5 py-4 font-semibold text-navy">CAC to LTV</td>
              <td class="px-5 py-4">Cost to acquire a customer versus their lifetime value</td>
              <td class="px-5 py-4">Lets you spend more on first orders that repeat</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Break-even ROAS depends on the value sent to Google Ads. When the conversion value is revenue, divide one by the contribution-margin rate: a 25 percent rate needs a 4x revenue ROAS and a 50 percent rate needs 2x. When the conversion value is contribution before ad spend, break-even is 1x because the margin is already inside the value. These are floors for the direct costs included in the calculation; set a higher target for overhead and desired profit.</p>
      <p class="text-lg text-gray-700 leading-relaxed">The CAC-to-LTV number is what lets profit-first accounts spend aggressively where it is justified. If a first order breaks even but the customer typically comes back three times, you can afford to bid up front and collect the profit on the repeat orders. Revenue-only accounts never see this, because they treat every sale as a one-off.</p>
    </div>
  </section>

  <!-- PCF framework -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Map the profit before you touch the bids</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">A blended account-wide margin is a useful starting point but hides the real picture. A catalogue of hundreds of products has hundreds of margins. The spread between the best and worst is usually enormous. Some products fund the account. Others drain it while posting a flattering ROAS. You cannot manage to profit until you can see which is which.</p>
      <p class="text-lg text-gray-700 leading-relaxed">That mapping exercise is the first thing we do on any account, and it is the backbone of our <a href="/how-we-audit" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">Profit Contribution Framework</a>. It joins your margin data to your ad data so that every campaign, product group and search term can be read in profit terms rather than revenue terms. Once the map exists, the decisions about where to add budget and where to pull it become obvious.</p>

      <figure class="content-visual mt-10">
        <svg role="img" aria-labelledby="chart-title-2 chart-desc-2" viewBox="0 0 720 360" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:720px;height:auto;">
          <title id="chart-title-2">Revenue ROAS break-even by contribution margin</title>
          <desc id="chart-desc-2">Revenue ROAS break-even is one divided by contribution margin. A 20 percent margin needs a 5x ROAS just to break even, a 25 percent margin needs 4x, a 40 percent margin needs 2.5x, and a 50 percent margin needs only 2x. Lower margins need a far higher ROAS to avoid losing money.</desc>
          <rect width="720" height="360" fill="#FFFFFF"/>
          <text x="360" y="34" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="700" fill="#0A1628">Revenue ROAS break-even by contribution margin</text>
          <text x="360" y="56" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" fill="#64748B">The ROAS you need just to break even, before any profit</text>
          <!-- 20% margin -> 5.0x -->
          <text x="140" y="103" text-anchor="end" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#0A1628">20% margin</text>
          <rect x="150" y="86" width="510" height="30" fill="#EA4335"/>
          <text x="672" y="107" text-anchor="start" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#EA4335">5.0x</text>
          <!-- 25% margin -> 4.0x -->
          <text x="140" y="157" text-anchor="end" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#0A1628">25% margin</text>
          <rect x="150" y="140" width="408" height="30" fill="#F59E0B"/>
          <text x="570" y="161" text-anchor="start" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#B87400">4.0x</text>
          <!-- 40% margin -> 2.5x -->
          <text x="140" y="211" text-anchor="end" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#0A1628">40% margin</text>
          <rect x="150" y="194" width="255" height="30" fill="#2563EB"/>
          <text x="417" y="215" text-anchor="start" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#2563EB">2.5x</text>
          <!-- 50% margin -> 2.0x -->
          <text x="140" y="265" text-anchor="end" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="600" fill="#0A1628">50% margin</text>
          <rect x="150" y="248" width="204" height="30" fill="#34A853"/>
          <text x="366" y="269" text-anchor="start" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="700" fill="#2E8B4A">2.0x</text>
          <line x1="150" y1="86" x2="150" y2="278" stroke="#94A3B8" stroke-width="1.5"/>
          <text x="360" y="322" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" fill="#64748B">Revenue ROAS break-even = 1 divided by contribution-margin rate</text>
        </svg>
        <figcaption>The thinner your margin, the higher the ROAS you need just to break even, which is why a blended account-wide target hides where the money is really made and lost.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Feed profit into the platform -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Feed profit into the platform</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Google Ads bids to the conversion value you send it. If that value is revenue, it optimises to revenue. The single most powerful move in profit-first PPC is to change what the platform sees, so its automated bidding works for you instead of against you.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">There are three practical levers, in rough order of impact:</p>
      <ul class="space-y-4 mb-6 text-lg text-gray-700">
        <li class="flex gap-3"><span class="text-electric font-bold shrink-0">1.</span><span><strong class="text-navy">Contribution-valued conversion data.</strong> Pass contribution before ad spend as the conversion value when direct cost data is accurate. A high-margin sale then carries more value than a low-margin sale of the same price.</span></li>
        <li class="flex gap-3"><span class="text-electric font-bold shrink-0">2.</span><span><strong class="text-navy">A target that matches the conversion value.</strong> Revenue-valued conversions need a target above their margin-derived revenue ROAS floor. Contribution-valued conversions break even at 1x, so their target needs to sit above 1x by the contribution you want to retain.</span></li>
        <li class="flex gap-3"><span class="text-electric font-bold shrink-0">3.</span><span><strong class="text-navy">Clean conversion tracking.</strong> None of the above works if the data is wrong. Deduplicated conversions, accurate values and a sensible attribution window are the foundation everything else sits on.</span></li>
      </ul>
      <p class="text-lg text-gray-700 leading-relaxed">This is also where profit-first PPC meets conversion rate optimisation. Every extra point of conversion rate lowers your effective cost per sale and lifts POAS without spending a penny more. We cover that side of the equation in <a href="/blog/what-is-ecro" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">what is eCRO</a>.</p>
    </div>
  </section>

  <!-- Weekly rulebook -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Scale on profit, not on a good day</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Once an account is profitable, the instinct is to pour on budget. Done wrong, that shocks the bidding algorithm and performance falls off a cliff. We scale in controlled weekly steps, tied to how far ROAS sits above or below target. This is the rulebook we run against live accounts managing millions in annual spend.</p>
      <div class="overflow-x-auto mb-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-navy text-white">
              <th class="px-5 py-4 font-heading font-semibold text-sm">Weekly revenue ROAS</th>
              <th class="px-5 py-4 font-heading font-semibold text-sm">Action</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <tr class="bg-white border-b border-gray-100"><td class="px-5 py-4 font-semibold text-navy">Above 1,200%</td><td class="px-5 py-4">Increase budget by 20 percent</td></tr>
            <tr class="bg-gray-50 border-b border-gray-100"><td class="px-5 py-4 font-semibold text-navy">900% to 1,100%</td><td class="px-5 py-4">Increase budget by 10 percent</td></tr>
            <tr class="bg-white border-b border-gray-100"><td class="px-5 py-4 font-semibold text-navy">600% to 800%</td><td class="px-5 py-4">Hold and let it stabilise</td></tr>
            <tr class="bg-gray-50 border-b border-gray-100"><td class="px-5 py-4 font-semibold text-navy">300% to 500%</td><td class="px-5 py-4">Reduce budget by 20 percent</td></tr>
            <tr class="bg-white"><td class="px-5 py-4 font-semibold text-navy">Below 300%</td><td class="px-5 py-4">Switch off and rebuild</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-lg text-gray-700 leading-relaxed">The rulebook keeps budget changes controlled and protects profit before a soft week becomes a bad month. The thresholds apply to revenue ROAS, so each decision must also clear the account's verified contribution-margin floor. Results between the stated bands need an account review before budget changes. Campaigns below 300 percent are switched off and rebuilt.</p>
    </div>
  </section>

  <!-- Structure by margin -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Structure the account around margin</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Profit-first management is much easier when the account is built for it. If every product sits in one undifferentiated campaign, the algorithm blends your best and worst margins together and you lose the ability to bid them differently. The answer is to group products by margin band, so high-margin lines can be pushed harder and thin-margin lines are held to a stricter target.</p>
      <p class="text-lg text-gray-700 leading-relaxed">This matters most for retailers with large catalogues, where the margin spread across thousands of SKUs is where the profit is won or lost. We go deep on that in <a href="/high-sku-advertising" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">advertising a high-SKU catalogue</a>, which covers how to segment thousands of products without drowning in campaigns.</p>
    </div>
  </section>

  <!-- Profit leaks -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Profit leaks worth fixing this week</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">You do not need a full rebuild to start managing to profit. A handful of leaks show up in almost every account, and each one is worth checking before your next reporting cycle:</p>
      <ul class="space-y-4 mb-6 text-lg text-gray-700">
        <li class="flex gap-3"><span class="text-electric shrink-0">•</span><span><strong class="text-navy">Revenue conversion values.</strong> If Google still sees order value rather than profit, it is bidding to the wrong goal every hour of the day.</span></li>
        <li class="flex gap-3"><span class="text-electric shrink-0">•</span><span><strong class="text-navy">No break-even floor.</strong> Campaigns running under their break-even ROAS are losing money invisibly. Work out the floor and find them.</span></li>
        <li class="flex gap-3"><span class="text-electric shrink-0">•</span><span><strong class="text-navy">Thin-margin bestsellers eating budget.</strong> The products with the most spend are often the least profitable. Read spend in profit terms and the picture changes.</span></li>
        <li class="flex gap-3"><span class="text-electric shrink-0">•</span><span><strong class="text-navy">Brand and non-brand blended together.</strong> Brand terms flatter the account-wide ROAS. Separate them so you can see what the working budget really returns.</span></li>
        <li class="flex gap-3"><span class="text-electric shrink-0">•</span><span><strong class="text-navy">Wasted spend on converting-but-unprofitable search terms.</strong> A term can convert well and still lose money. The search terms report, read against margin, surfaces them.</span></li>
      </ul>
      <p class="text-lg text-gray-700 leading-relaxed">Fixing even two or three of these usually lifts profit without touching the budget, because the same spend is simply pointed at better sales.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Frequently asked questions</h2>
      <div class="space-y-4">
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
            What is profit-first PPC?
            <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-gray-700 leading-relaxed">Profit-first PPC manages paid search against contribution, not revenue alone. Start with the direct costs attached to each sale, set a revenue ROAS floor from that contribution margin, and use contribution-valued conversion data only when the account can report it accurately. Budget then flows to products and campaigns that contribute profit.</div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
            Why does a high ROAS still lose money?
            <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-gray-700 leading-relaxed">ROAS measures revenue returned per pound of spend, and revenue is not profit. A 4x ROAS on a product with a 20 percent contribution-margin rate can lose money once direct costs and ad spend are included. Because Google optimises to the conversion value you give it, a revenue-only feed can favour low-margin volume. Contribution-valued conversion data gives it a more useful signal.</div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
            How do I set a profit target for Google Ads?
            <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-gray-700 leading-relaxed">Start with contribution amount: revenue less direct costs such as cost of goods, payment fees, shipping and returns. Divide it by revenue to calculate the contribution-margin rate. If Google Ads receives revenue as conversion value, break-even ROAS is 1 divided by that rate: a 40 percent contribution margin needs a 2.5x revenue ROAS. If it receives contribution before ad spend as conversion value, break-even is 1x. Set a higher target for overhead and desired profit.</div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
            What is break-even ROAS?
            <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-gray-700 leading-relaxed">Break-even ROAS is the return-per-pound-of-spend figure at which advertising spend is covered by the contribution remaining after the included direct costs. For revenue-valued conversions, it equals 1 divided by the contribution-margin rate: a 25 percent rate needs a 4x revenue ROAS and a 50 percent rate needs 2x. For contribution-before-ad-spend conversion values, break-even is 1x. Set a higher target for overhead and desired profit.</div>
        </details>
        <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
            When should I scale a profitable campaign?
            <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-6 text-gray-700 leading-relaxed">Scale on a weekly cadence tied to profit, not on a single good day. Our rulebook increases budget by 20 percent a week above 1,200 percent ROAS, by 10 percent between 900 and 1,100 percent, holds between 600 and 800 percent, reduces spend between 300 and 500 percent, and switches off below 300 percent. Apply the rule alongside the account's verified contribution-margin floor.</div>
        </details>
      </div>
    </div>
  </section>

