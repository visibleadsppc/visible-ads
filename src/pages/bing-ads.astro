---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServiceLinks from '../components/ServiceLinks.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Bing Ads Management",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "description": "Microsoft Advertising Partner. Reach high-value audiences on Bing, Yahoo, and DuckDuckGo with lower CPCs.",
      "url": "https://visible-ads.com/bing-ads",
      "serviceType": "Microsoft Advertising Management",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How much does Bing Ads management cost?", "acceptedAnswer": { "@type": "Answer", "text": "The same tier ladder applies to Bing management. These tiers apply per channel managed. SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo); GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo); PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection); PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated. All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice." } },
        {
          "@type": "Question",
          "name": "How does Bing Ads compare to Google Ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bing Ads typically delivers 20-35% lower cost-per-click than Google Ads for the same keywords. While the search volume is smaller, the audience tends to skew older, more affluent, and more likely to convert. Many of our clients run both platforms and find Bing delivers superior ROAS."
          }
        },
        {
          "@type": "Question",
          "name": "Who uses Bing for search?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bing powers search across Microsoft Edge, Windows devices, Yahoo, DuckDuckGo, and AOL. The audience skews 35-64 years old with above-average household income. Bing users are less likely to use ad blockers and often work in corporate environments where Edge is the default browser."
          }
        },
        {
          "@type": "Question",
          "name": "How much budget do I need for Bing Ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because CPCs are lower on Bing, you can start with a smaller budget and still see meaningful results. We typically recommend starting with £500-£1,500 per month in ad spend to generate enough data for optimisation. Your management fee is separate and based on campaign complexity."
          }
        },
        {
          "@type": "Question",
          "name": "Can you import my existing Google Ads campaigns to Bing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Microsoft Advertising has a direct import tool for Google Ads campaigns. However, we never do a blind import. We review and adapt campaign structure, bids, and targeting specifically for the Bing audience. What works on Google doesn't always translate directly to Bing."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Bing Ads", "item": "https://visible-ads.com/bing-ads" }
      ]
    }
  ]
};
---

<Layout title="Bing Ads Agency | Microsoft Advertising | Visible Ads" description="Microsoft Advertising Partner. Reach high-value audiences on Bing, Yahoo, and DuckDuckGo with lower CPCs." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-cyan-900 to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Microsoft Advertising Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Bing Ads Management, Reach Audiences Your Competitors Miss</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-4 leading-relaxed">Most advertisers ignore Bing. That's exactly why it works. Lower CPCs, higher-income demographics, and less competition mean your budget goes further on Microsoft's search network.</p>
        <p class="text-sm text-slate-light/80 mb-8">Part of our integrated <a href="/google-ads" class="text-electric-light underline hover:text-white">Google Ads-led growth strategy</a></p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-bing-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Bing Ads Audit</a>
          <a href="#approach" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See Our Approach</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What We Do -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">What We Do</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We manage Microsoft Advertising campaigns that tap into a massive, underutilised audience. Bing powers search on Microsoft Edge, Windows devices, Yahoo, DuckDuckGo, and AOL, reaching over 14 million UK searchers that most advertisers completely overlook. These aren't bargain hunters: Bing's audience skews older, more affluent, and statistically more likely to convert.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">The competitive landscape on Bing is fundamentally different from Google. Fewer advertisers means less auction pressure, which translates directly into lower CPCs, typically 20-35% cheaper for the same keywords. Businesses already running profitable <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads</a> campaigns find that adding Bing is one of the highest-impact moves you can make with minimal incremental effort.</p>
        <p class="text-lg text-gray-700 leading-relaxed">We don't just mirror your Google campaigns and hope for the best. We build Bing-specific strategies that account for platform differences in audience behaviour, device split, and conversion patterns. From Shopping campaigns and audience network ads to LinkedIn profile targeting (a Bing exclusive), we use every tool the platform offers to maximise your return. Pair Bing with our <a href="/seo" class="text-electric underline hover:text-electric-dark">SEO services</a> for total search coverage across paid and organic.</p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Approach</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">A methodical process to unlock Bing's full potential for your business.</p>
        <p class="text-lg text-gray-700 mt-6 leading-relaxed">For a platform comparison before you plan your campaigns, read <a href="/blog/google-ads-vs-bing-ads/" class="text-electric underline hover:text-electric-dark">Google Ads vs Bing Ads</a>.</p>
      </div>
      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="hidden lg:block absolute top-10 left-[calc(12.5%+24px)] right-[calc(12.5%+24px)] h-0.5 bg-electric/20"></div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Audit Existing PPC</h3>
          <p class="text-gray-700">We review your current Google Ads data to identify which campaigns, keywords, and audiences are most likely to perform well on Bing's network.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Identify Bing Opportunity</h3>
          <p class="text-gray-700">We analyse Bing-specific search volumes, competitor activity, and CPC estimates to build a business case and forecast expected returns before launching.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Launch & Test</h3>
          <p class="text-gray-700">Campaigns launch with Bing-optimised structures, tailored bids, and platform-specific features like LinkedIn profile targeting and audience network placement.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Optimise & Scale</h3>
          <p class="text-gray-700">We refine based on Bing-specific conversion data, scale winning campaigns, and continuously test new opportunities across the Microsoft network.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Why Choose Us</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Bing expertise that delivers real competitive advantage.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">20-35%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Lower CPCs</div>
          <p class="text-gray-700 text-sm">Consistently cheaper clicks than Google for the same keywords, your budget stretches further.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">14M+</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">UK Bing Searchers</div>
          <p class="text-gray-700 text-sm">A massive audience of high-income professionals your competitors are completely ignoring.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">2x</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Cross-Platform Synergy</div>
          <p class="text-gray-700 text-sm">Clients running Google + Bing together see measurably better total ROAS than either platform alone.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">How much does Bing Ads management cost?</summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">
              <p class="mb-4">The same tier ladder applies to Bing management. These tiers apply per channel managed.</p>
              <ul class="list-disc pl-5 space-y-2 mb-4">
                <li>SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo)</li>
                <li>GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo)</li>
                <li>PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection)</li>
                <li>PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated</li>
              </ul>
              <p>All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice.</p>
            </div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How does Bing Ads compare to Google Ads?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Bing Ads typically delivers 20-35% lower cost-per-click than Google Ads for the same keywords. While the search volume is smaller, the audience tends to skew older, more affluent, and more likely to convert. Many of our clients run both platforms and find Bing delivers superior ROAS.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              Who uses Bing for search?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Bing powers search across Microsoft Edge, Windows devices, Yahoo, DuckDuckGo, and AOL. The audience skews 35-64 years old with above-average household income. Bing users are less likely to use ad blockers and often work in corporate environments where Edge is the default browser.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How much budget do I need for Bing Ads?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Because CPCs are lower on Bing, you can start with a smaller budget and still see meaningful results. We typically recommend starting with £500-£1,500 per month in ad spend to generate enough data for optimisation. Your management fee is separate and based on campaign complexity.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              Can you import my existing Google Ads campaigns to Bing?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Yes, Microsoft Advertising has a direct import tool for Google Ads campaigns. However, we never do a blind import. We review and adapt campaign structure, bids, and targeting specifically for the Bing audience. What works on Google doesn't always translate directly to Bing.</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-navy text-center mb-8">Related Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/google-ads" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Our core PPC service, the hub that powers your entire paid search strategy.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/seo" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">SEO Services</h3>
          <p class="text-gray-700 text-sm mb-3">Own the organic results alongside your paid placements for total SERP dominance.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos compact />
    </div>
  </section>

  <!-- Service Links -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServiceLinks current="/bing-ads" />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Tap Into Bing's Untapped Audience?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Find out how much you're leaving on the table by ignoring Microsoft's search network. Free audit, no obligation.</p>
      <a href="/free-bing-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Bing Ads Audit</a>
    </div>
  </section>

</Layout>
