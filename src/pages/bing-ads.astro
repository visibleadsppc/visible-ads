---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServiceLinks from '../components/ServiceLinks.astro';

const faqs = [
  {
    question: 'What does a Bing Ads agency do?',
    answer: 'A Bing Ads agency manages your Microsoft Advertising account for you. You may also see it called a Microsoft Advertising agency, a Microsoft Ads agency or a Bing PPC agency. At Visible Ads the work covers Search, Shopping and Audience campaigns. Performance Max is added where it suits the account. Conversion tracking and reporting are part of the service.',
  },
  {
    question: 'How much does Bing Ads management cost?',
    answer: "Fees are per channel managed plus VAT. Each fee covers unlimited campaigns on that channel. The tiers and the performance model are on our PPC management page. The fee doesn't cover creative. We confirm the Microsoft Advertising fee when we scope your account.",
    link: { text: 'PPC management page', href: '/ppc-management/#pricing' },
  },
  {
    question: 'Can you import my existing Google Ads campaigns to Bing?',
    answer: 'Yes. Microsoft Advertising has an import tool for Google Ads. Shopping campaigns need a Microsoft Merchant Center store. You link it to the campaign during the import. After the import we check structure, bids, budgets and conversion goals for Microsoft Advertising.',
  },
  {
    question: 'How much budget do I need for Bing Ads?',
    answer: "There is no fixed minimum. We size a trial budget from your Bing search volume and CPC estimates so it can collect enough conversions to judge. Conversion lag and your profit target decide how long the trial runs. Management fees are separate.",
  },
  {
    question: 'Do you manage Microsoft Advertising alongside Google Ads?',
    answer: 'Yes. We can manage Microsoft Advertising next to Google Ads under one profit target. You see its results beside your own order records.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Bing Ads Agency',
      provider: { '@type': 'Organization', name: 'Visible Ads', url: 'https://visible-ads.com' },
      description: 'Bing Ads agency for ecommerce brands: Microsoft Advertising Search, Shopping, Audience and Performance Max campaigns, Google Ads import and reporting against your own sales.',
      url: 'https://visible-ads.com/bing-ads/',
      serviceType: 'Bing Ads Management',
      areaServed: 'GB',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://visible-ads.com/' },
        { '@type': 'ListItem', position: 2, name: 'Bing Ads', item: 'https://visible-ads.com/bing-ads/' },
      ],
    },
  ],
};

const scope = [
  { title: 'Search campaigns', text: 'Keywords, match types, ads and negative keywords on Bing and the Microsoft Advertising Network. We review the account every week and act on what the search terms show.' },
  { title: 'Shopping and product ads', text: 'We run your Merchant Center feed and Shopping campaigns with your margins in view.' },
  { title: 'Audience ads', text: 'Display and native ads that reach people beyond search results. Microsoft groups them under Audience ads. We add them when they suit the account.' },
  { title: 'Performance Max', text: 'Microsoft says one Performance Max campaign can serve Search, Audience and Product ads. We use it where it suits the account.' },
  { title: 'Import from Google Ads', text: 'Microsoft imports Search, Shopping and Performance Max campaigns. We then review what came across and adjust it for Microsoft Advertising.' },
  { title: 'Reporting', text: 'Microsoft Advertising results sit beside your own order or lead records in our reporting.' },
];

const steps = [
  { title: 'Review the account', text: 'We start with your Google Ads data and your conversion tracking.' },
  { title: 'Size the opportunity', text: 'We look at Bing search volume and CPC estimates to see where Microsoft Advertising fits.' },
  { title: 'Launch on a trial budget', text: 'Campaigns go live on a trial budget once tracking is checked.' },
  { title: 'Review every week', text: 'We go through the account weekly and adjust from what the data shows.' },
];

const faqHtml = (f) => f.link ? f.answer.replace(f.link.text, `<a href="${f.link.href}" class="text-electric underline hover:text-electric-dark">${f.link.text}</a>`) : f.answer;
---

<Layout title="Bing Ads Agency | Microsoft Ads Management | Visible Ads" description="Bing Ads agency for ecommerce brands. We manage Microsoft Advertising Search, Shopping, Audience and Performance Max campaigns against your margin." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-cyan-900 to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Microsoft Advertising Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Bing Ads Agency: Microsoft Advertising Management</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">Visible Ads is a Bing Ads agency for ecommerce brands. As a Microsoft Advertising agency we manage your Search, Shopping, Audience and Performance Max campaigns. Each one is judged against your margin.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Talk to us about Microsoft Ads</a>
          <a href="#covers" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See what we manage</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What we manage -->
  <section id="covers" class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What our Bing Ads management covers</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">We manage your Microsoft Advertising account from setup to reporting. Conversion tracking and profit targets are agreed first.</p>
      <dl class="space-y-6 text-lg text-gray-700 leading-relaxed">
        {scope.map((s) => (
          <div>
            <dt class="font-heading font-bold text-navy">{s.title}</dt>
            <dd>{s.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Fit with Google -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Where Microsoft Advertising fits beside Google Ads</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Microsoft Advertising can run as a second channel next to Google Ads. We manage the two together under one profit target.</p>
      <p class="text-lg text-gray-700 leading-relaxed">We start on a trial budget and compare the sales Microsoft reports with your own order records. We keep budget where it pays its way on contribution. Our <a href="/microsoft-advertising-uk-statistics/" class="text-electric underline hover:text-electric-dark">Microsoft Advertising UK statistics</a> page sources and dates each figure for Bing's UK share and reach.</p>
    </div>
  </section>

  <!-- Copilot -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Ads in Copilot come from the account you already run</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Microsoft serves ads in Copilot from existing campaign text and images. Its documented eligible types include Multimedia ads, Product ads from Shopping and Performance Max, Search ads with a logo and some Vertical ad types.</p>
        <p class="text-lg text-gray-700 leading-relaxed">Microsoft says eligible campaigns are opted in automatically and that advertisers cannot opt out. Microsoft doesn't promise an ad will show, and it has no Copilot-only metrics yet, so we read results from the standard reports.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-sky-tint">
        <table class="w-full text-left text-sm"><caption class="sr-only">Copilot campaign review checklist</caption><thead class="bg-navy text-white"><tr><th scope="col" class="p-4">Check</th><th scope="col" class="p-4">Why it matters</th></tr></thead><tbody class="text-gray-700"><tr class="border-t"><th scope="row" class="p-4 font-semibold text-navy">Ad assets and feeds</th><td class="p-4">Search ads need a logo to be eligible. Images, product feeds and landing pages still shape how the ads look and perform.</td></tr><tr class="border-t bg-white"><th scope="row" class="p-4 font-semibold text-navy">Relevance and controls</th><td class="p-4">Negative keyword matching applies in Copilot as it does on web search. Search terms and negatives still matter.</td></tr><tr class="border-t"><th scope="row" class="p-4 font-semibold text-navy">Measurement</th><td class="p-4">Copilot has no metrics of its own. Conversion reports are read beside your own orders or qualified leads.</td></tr></tbody></table>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">How we manage Microsoft Advertising</h2>
        <p class="text-lg text-gray-700">Four steps take an account from review to regular optimisation.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {steps.map((st, n) => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm">
            <div class="w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">{n + 1}</div>
            <h3 class="text-xl font-heading font-bold text-navy mb-3">{st.title}</h3>
            <p class="text-gray-700">{st.text}</p>
          </div>
        ))}
      </div>
      <p class="text-lg text-gray-700 mt-10 max-w-3xl mx-auto text-center leading-relaxed">Deciding between the two platforms first? Read <a href="/blog/google-ads-vs-bing-ads/" class="text-electric underline hover:text-electric-dark">Google Ads vs Bing Ads</a>.</p>
    </div>
  </section>

  <!-- Judging results -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">How we judge Microsoft Advertising results</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">Visible Ads works profit first. Microsoft Advertising is judged against your margin and your own sales records. Platform ROAS is one input.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Request a <a href="/free-bing-ads-audit/" class="text-electric underline hover:text-electric-dark">free Microsoft Ads audit</a> to see where an account stands first.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Bing Ads agency questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              {faq.question}
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed" set:html={faqHtml(faq)} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section class="py-10 bg-white"><div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-xl font-heading font-bold text-navy mb-4">Sources</h2><ul class="list-disc pl-6 text-gray-700 space-y-2"><li><a class="text-electric underline" href="https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_conc_adsforcopilot">Microsoft Advertising: About ads in Copilot</a>, eligible formats, opt-in and reporting limits.</li><li><a class="text-electric underline" href="https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_proc_aboutpmax">Microsoft Advertising: About Performance Max campaigns</a>, serving Search, Audience and Product ads.</li><li><a class="text-electric underline" href="https://learn.microsoft.com/en-us/advertising/msa-help/hlp_ba_conc_importwhatinfo">Microsoft Advertising: What gets imported from Google Ads</a>, campaign types and the Shopping store requirement.</li><li><a class="text-electric underline" href="https://about.ads.microsoft.com/en/solutions/ad-products-formats/display">Microsoft Advertising: Display and native ads</a>, the Audience ads definition.</li></ul></div></section>

  <!-- Related Services -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-navy text-center mb-8">Related Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <a href="/google-ads" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Our core paid search service, run alongside Microsoft Advertising.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/seo" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">SEO Services</h3>
          <p class="text-gray-700 text-sm mb-3">Organic results that support your paid placements.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos compact />
    </div>
  </section>

  <!-- Service Links -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServiceLinks current="/bing-ads" />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Talk to a Bing Ads agency</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Tell us about your account and we will say where Microsoft Advertising fits beside your other channels.</p>
      <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Talk to us about Microsoft Ads</a>
    </div>
  </section>

</Layout>
