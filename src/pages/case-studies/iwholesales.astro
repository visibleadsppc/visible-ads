---
import Layout from '../../layouts/Layout.astro';
import CountUp from '../../components/CountUp.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "iWholesales Case Study, Airsoft eCommerce Growth",
      "description": "iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.",
      "datePublished": "2026-05-01",
      "dateModified": "2026-05-25",
      "author": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://visible-ads.com/case-studies/iwholesales"
      },
      "about": {
        "@type": "Organization",
        "name": "iWholesales"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Case Studies", "item": "https://visible-ads.com/case-studies" },
        { "@type": "ListItem", "position": 3, "name": "iWholesales", "item": "https://visible-ads.com/case-studies/iwholesales" }
      ]
    }
  ]
};
---

<Layout title="iWholesales Case Study: Airsoft Growth | Visible Ads" description="iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience." schema={schema}>

  <section class="relative py-20 lg:py-28 overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-light mb-8">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/case-studies" class="hover:text-white transition-colors">Case Studies</a>
        <span class="mx-2">/</span>
        <span class="text-white">iWholesales</span>
      </nav>
      <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">eCommerce, Airsoft & Outdoor</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white leading-tight mb-6">450% Sales Growth in a Competitive Niche</h1>
      <p class="text-lg sm:text-xl text-slate-light max-w-3xl leading-relaxed">iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.</p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6">
        <CountUp value="450" prefix="+" suffix="%" label="Sales Growth" />
      </div>
    </div>
  </section>

  <div class="relative h-64 sm:h-80 overflow-hidden">
    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80" alt="iWholesales case study, eCommerce advertising growth" class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>
  </div>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-4">The Challenge</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">Invisible in a Crowded Marketplace</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">iWholesales had built a solid reputation in the airsoft and outdoor equipment space, but their online presence told a different story. They were heavily reliant on marketplace listings where margins were razor-thin, and competitors with bigger budgets consistently outbid them for visibility. Without a structured paid search strategy, they were leaving significant revenue on the table.</p>
        <p class="text-lg text-gray-700 leading-relaxed">The challenge was compounded by the niche nature of their market. Airsoft equipment buyers are knowledgeable, price-sensitive, and comparison-shop extensively before purchasing. iWholesales needed a strategy that could capture these high-intent buyers at the exact moment they were ready to buy, not just drive traffic for the sake of impressions.</p>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-4">Our Strategy</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Advertising and Conversion Work</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
          <div class="w-10 h-10 bg-electric/10 text-electric rounded-lg flex items-center justify-center text-lg font-bold mb-4">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Google Shopping Campaign Buildout</h3>
          <p class="text-gray-700 leading-relaxed">We built a comprehensive Google Shopping presence with optimised product feeds, custom labels for margin-based bidding, and segmented campaigns by product category. High-margin products received aggressive bids while low-margin items maintained efficiency targets.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
          <div class="w-10 h-10 bg-electric/10 text-electric rounded-lg flex items-center justify-center text-lg font-bold mb-4">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">High-Intent Search Campaigns</h3>
          <p class="text-gray-700 leading-relaxed">The search work focused on product-specific keywords, including model numbers and accessory combinations.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
          <div class="w-10 h-10 bg-electric/10 text-electric rounded-lg flex items-center justify-center text-lg font-bold mb-4">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Amazon Sponsored Products</h3>
          <p class="text-gray-700 leading-relaxed">We optimised iWholesales' Amazon presence with targeted Sponsored Products campaigns, improved product listings with conversion-focused copy, and implemented a competitor-targeting strategy.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200">
          <div class="w-10 h-10 bg-electric/10 text-electric rounded-lg flex items-center justify-center text-lg font-bold mb-4">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Remarketing Funnel</h3>
          <p class="text-gray-700 leading-relaxed">We built a sophisticated remarketing funnel that segmented visitors by browsing behaviour and purchase intent. Cart abandoners received dynamic product ads within hours, while category browsers were served curated product collections that matched their interests.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-4">The Results</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">450% Sales Growth</h2>
      </div>
      <p class="text-lg text-gray-700 leading-relaxed max-w-3xl">iWholesales achieved 450% sales growth alongside work on its online visibility and conversion experience.</p>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-4">
        <p class="text-sm font-medium text-slate uppercase tracking-widest mb-2">Services Used</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/google-ads" class="inline-flex items-center px-4 py-2 bg-white rounded-full text-sm font-semibold text-electric hover:bg-electric hover:text-white transition-colors border border-electric/20">Google Ads</a>
          <a href="/amazon" class="inline-flex items-center px-4 py-2 bg-white rounded-full text-sm font-semibold text-electric hover:bg-electric hover:text-white transition-colors border border-electric/20">Amazon Ads</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy text-center mb-10">Related Case Studies</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <a href="/case-studies/cfw" class="group bg-sky-tint rounded-2xl p-6 hover:shadow-lg transition-all">
          <span class="text-xs font-semibold text-electric uppercase tracking-wide">Food & Beverage</span>
          <h3 class="text-lg font-heading font-bold text-navy mt-2 mb-2 group-hover:text-electric transition-colors">CFW</h3>
          <p class="text-sm text-gray-700">1,165% all-time Google Ads ROAS over three years.</p>
        </a>
        <a href="/case-studies/sephra" class="group bg-sky-tint rounded-2xl p-6 hover:shadow-lg transition-all">
          <span class="text-xs font-semibold text-electric uppercase tracking-wide">Multi-Channel</span>
          <h3 class="text-lg font-heading font-bold text-navy mt-2 mb-2 group-hover:text-electric transition-colors">Sephra Europe</h3>
          <p class="text-sm text-gray-700">£2.31M in ad-driven revenue and 1,149% ROAS.</p>
        </a>
        <a href="/case-studies/luxury-architecture" class="group bg-sky-tint rounded-2xl p-6 hover:shadow-lg transition-all">
          <span class="text-xs font-semibold text-electric uppercase tracking-wide">Lead Generation</span>
          <h3 class="text-lg font-heading font-bold text-navy mt-2 mb-2 group-hover:text-electric transition-colors">Luxury Architecture</h3>
          <p class="text-sm text-gray-700">12x more qualified leads for high-value projects.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-navy" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready for Results Like These?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free, no-obligation audit of your advertising accounts. We'll show you exactly where the opportunities are.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
    </div>
  </section>

</Layout>
