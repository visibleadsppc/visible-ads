---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ServiceLinks from '../components/ServiceLinks.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "eCommerce Conversion Rate Optimisation",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "description": "eCommerce conversion rate optimisation. Turn more of your existing traffic into paying customers through data-driven testing.",
      "url": "https://visible-ads.com/ecro",
      "serviceType": "Conversion Rate Optimisation",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is eCRO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "eCRO stands for eCommerce Conversion Rate Optimisation. It's the systematic process of increasing the percentage of website visitors who complete a desired action, whether that's making a purchase, adding to cart, or submitting an enquiry. We use data analysis, user research, and A/B testing to identify and remove friction points in your customer journey."
          }
        },
        {
          "@type": "Question",
          "name": "What kind of conversion rate improvement can I expect?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Results vary by industry and starting point, but most clients see a 15-30% improvement in conversion rate within the first six months. Even a small uplift can have a dramatic impact on revenue, a 0.5% improvement on a site doing £500k annually can add £25k+ in revenue with zero additional ad spend."
          }
        },
        {
          "@type": "Question",
          "name": "What testing tools do you use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We work with industry-leading tools including Google Optimize alternatives like VWO and Convert, plus analytics platforms like Hotjar and Microsoft Clarity for heatmaps and session recordings. The specific tooling depends on your platform, traffic volume, and budget. We recommend the best fit during our initial audit."
          }
        },
        {
          "@type": "Question",
          "name": "How does CRO work alongside our ad campaigns?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CRO is the ultimate force multiplier for paid advertising. If your current conversion rate is 2% and we improve it to 2.5%, every pound you spend on ads is now 25% more effective. Most businesses focus on driving more traffic when the real opportunity is converting more of the traffic they already have. CRO makes all your other marketing channels more profitable."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "eCRO", "item": "https://visible-ads.com/ecro" }
      ]
    }
  ]
};
---

<Layout title="Conversion Rate Optimisation | eCRO Services | Visible Ads" description="eCommerce conversion rate optimisation. Turn more of your existing traffic into paying customers through data-driven testing." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-emerald-900 to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Data-Driven Testing</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">eCRO, Convert More of Your Existing Traffic</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-4 leading-relaxed">Most businesses pour money into driving more traffic. The smarter play? Convert more of the traffic you already have. A 0.5% conversion rate improvement can add tens of thousands in annual revenue without spending a single extra pound on ads.</p>
        <p class="text-sm text-slate-light/80 mb-8">Part of our integrated <a href="/multi-channel-services" class="text-electric-light underline hover:text-white">multi-channel growth strategy</a></p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free eCRO Audit</a>
          <a href="#approach" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See Our Approach</a>
        </div>
      </div>
    </div>
  </section>


  <!-- What We Do -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">What We Do</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We help eCommerce businesses convert more visitors into customers through systematic, data-driven testing. Most businesses focus almost exclusively on acquisition, driving more traffic through ads, SEO, and social. But if your site converts at 2% instead of 3%, you're leaving a third of your potential revenue on the table. eCRO closes that gap by identifying and removing the friction points that stop visitors from buying.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Our process starts with data, not opinions. We analyse your analytics, set up heatmaps and session recordings, audit your checkout funnel, and identify exactly where visitors drop off and why. Every hypothesis we test is grounded in real user behaviour, not best-practice checklists or gut feelings. This evidence-based approach means we test things that are likely to move the needle, not cosmetic changes that look impressive in a presentation.</p>
        <p class="text-lg text-gray-700 leading-relaxed">The compounding effect of CRO is what makes it so powerful. Each winning test permanently improves your baseline conversion rate, which means every future pound spent on <a href="/google-ads" class="text-electric underline hover:text-electric-dark">Google Ads</a> or <a href="/paid-social" class="text-electric underline hover:text-electric-dark">paid social</a> generates more revenue. For businesses already investing in advertising, CRO is the single highest-ROI investment you can make, it amplifies the return on everything else.</p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Approach</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Systematic testing that turns data into revenue.</p>
      </div>
      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="hidden lg:block absolute top-10 left-[calc(12.5%+24px)] right-[calc(12.5%+24px)] h-0.5 bg-electric/20"></div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Data Audit</h3>
          <p class="text-gray-700">We deep-dive into your analytics, heatmaps, session recordings, and funnel data to identify where visitors drop off and quantify the revenue impact of each leak.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Hypothesis Mapping</h3>
          <p class="text-gray-700">We build a prioritised test backlog based on potential revenue impact, confidence level, and implementation effort. High-impact, high-confidence tests run first.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">A/B Testing</h3>
          <p class="text-gray-700">We run statistically rigorous A/B tests, proper sample sizes, clear success metrics, and sufficient run time. No premature winners, no cherry-picked results.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Implementation & Iteration</h3>
          <p class="text-gray-700">Winning tests get implemented permanently. Losing tests generate learning that informs the next round. The cycle repeats, compounding improvements over time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Why Choose Us</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">CRO that pays for itself many times over.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">15-30%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Typical CVR Uplift</div>
          <p class="text-gray-700 text-sm">Most clients see a 15-30% conversion rate improvement within six months of starting our CRO programme.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">£0</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Extra Ad Spend</div>
          <p class="text-gray-700 text-sm">CRO improves revenue from your existing traffic. No additional advertising budget required to see results.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">Data</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Driven Decisions</div>
          <p class="text-gray-700 text-sm">Every change is tested and validated with real user data. No guesswork, no opinions, just evidence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Study -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 sm:p-12 lg:p-16 max-w-4xl mx-auto">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-6">Case Study</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">How CRO Transformed Ad Campaign Profitability</h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">For clients running paid advertising alongside our CRO programme, the combined impact is transformative. By improving the on-site conversion rate, every pound spent on Google Ads, Bing, and paid social generates more revenue. One client saw their blended ROAS improve by 45% in three months, not because we changed their ad campaigns, but because the website converted better. The same traffic, the same spend, dramatically better results.</p>
        <div class="flex flex-wrap gap-8">
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">+45%</div>
            <div class="text-sm text-gray-700">ROAS Improvement</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">+22%</div>
            <div class="text-sm text-gray-700">Conversion Rate Lift</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">3 Months</div>
            <div class="text-sm text-gray-700">Time to Impact</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What is eCRO?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">eCRO stands for eCommerce Conversion Rate Optimisation. It's the systematic process of increasing the percentage of website visitors who complete a desired action, whether that's making a purchase, adding to cart, or submitting an enquiry. We use data analysis, user research, and A/B testing to identify and remove friction points in your customer journey.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What kind of conversion rate improvement can I expect?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">Results vary by industry and starting point, but most clients see a 15-30% improvement in conversion rate within the first six months. Even a small uplift can have a dramatic impact on revenue, a 0.5% improvement on a site doing £500k annually can add £25k+ in revenue with zero additional ad spend.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What testing tools do you use?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">We work with industry-leading tools including VWO and Convert for A/B testing, plus analytics platforms like Hotjar and Microsoft Clarity for heatmaps and session recordings. The specific tooling depends on your platform, traffic volume, and budget. We recommend the best fit during our initial audit.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How does CRO work alongside our ad campaigns?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">CRO is the ultimate force multiplier for paid advertising. If your current conversion rate is 2% and we improve it to 2.5%, every pound you spend on ads is now 25% more effective. Most businesses focus on driving more traffic when the real opportunity is converting more of the traffic they already have. CRO makes all your other marketing channels more profitable.</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-navy text-center mb-8">Related Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <a href="/google-ads" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Drive qualified traffic that your optimised site can now convert at a higher rate.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/paid-social" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Paid Social Advertising</h3>
          <p class="text-gray-700 text-sm mb-3">Build brand demand on social, then convert visitors on a CRO-optimised site.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos compact />
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 lg:py-16 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Service Links -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ServiceLinks current="/ecro" />
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Ready to Convert More of Your Existing Traffic?</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free conversion audit that shows you exactly where visitors are dropping off, and how much revenue you're leaving on the table.</p>
      <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free eCRO Audit</a>
    </div>
  </section>

</Layout>
