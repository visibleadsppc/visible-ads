---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const channels = [
  { name: 'Google Ads', href: '/google-ads', note: 'Our flagship channel: search, PMax and Shopping.' },
  { name: 'Microsoft Advertising (Bing)', href: '/bing-ads', note: 'Near-zero competition.' },
  { name: 'Paid Social', href: '/paid-social', note: 'Meta, LinkedIn and TikTok.' },
  { name: 'Amazon Advertising', href: '/amazon', note: 'Sponsored campaigns and listing optimisation.' },
  { name: 'SEO', href: '/seo', note: 'Organic alongside paid, under the same brief.' },
  { name: 'eCRO', href: '/ecro', note: 'Conversion rate optimisation for the traffic already bought.' },
];

const notFor = [
  'A single client account under £500/month spend, on its own.',
  'An agency that wants to keep full visibility into the account without agreeing reporting and access up front.',
  'A one-off campaign with no ongoing management relationship.',
];

const goodFit = [
  'An agency with one or more client accounts at or above the £500/month floor per account.',
  'An agency that wants to offer channels it does not run in-house (Amazon, Microsoft Advertising, SEO) without hiring for them.',
  'An agency that keeps the client relationship and wants delivery handled behind the scenes.',
];

const proof = [
  { name: 'CFW', href: '/case-studies/cfw', stat: '£6M return from £500K Google Ads spend', label: '12x ROAS' },
  { name: 'Sephra Europe', href: '/case-studies/sephra', stat: '£2.31M ad-driven revenue', label: 'Google + Amazon' },
  { name: 'iWholesales', href: '/case-studies/iwholesales', stat: '450% sales growth', label: 'eCommerce' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', 'name': 'White-Label PPC and SEO Delivery', 'serviceType': 'White-label digital marketing delivery for agencies', 'description': 'White-label PPC, paid social and SEO delivery for UK agencies reselling to their own clients, starting from £500 per month per client account.', 'url': 'https://visible-ads.com/white-label-ppc-seo-pricing-uk', 'provider': { '@type': 'Organization', 'name': 'Visible Ads', 'url': 'https://visible-ads.com' }, 'areaServed': 'GB', 'offers': { '@type': 'Offer', 'priceCurrency': 'GBP', 'price': '500', 'priceSpecification': { '@type': 'UnitPriceSpecification', 'price': '500', 'priceCurrency': 'GBP', 'unitText': 'per month per client account', 'minPrice': '500' } } },
  { '@type': 'FAQPage', 'mainEntity': [
    { '@type': 'Question', 'name': 'How much does a white-label PPC or SEO agency cost in the UK?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Visible Ads delivers white-label PPC, paid social and SEO from £500 per month per client account. That is a floor, not a fixed price: exact terms depend on channels, account complexity, reporting and communication requirements.' } },
    { '@type': 'Question', 'name': 'What is the minimum budget for white-label digital marketing?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'The minimum engagement is £500 per month per client account. Enquiries below that floor are not a fit for white-label delivery through Visible Ads.' } },
    { '@type': 'Question', 'name': 'Does the agency or Visible Ads own the client relationship?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'The partner agency keeps the client relationship. Visible Ads delivers the campaign work behind the scenes, under the arrangement agreed with the partner agency.' } },
    { '@type': 'Question', 'name': 'Which channels can be white-labelled through Visible Ads?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'Google Ads, Microsoft Advertising, paid social (Meta, LinkedIn, TikTok), Amazon Advertising, SEO and eCRO can all be discussed within the same white-label brief.' } },
    { '@type': 'Question', 'name': 'What does an agency need to bring to a first conversation?', 'acceptedAnswer': { '@type': 'Answer', 'text': 'The client brief and channel scope, how approvals and client communication should work, and the account-access and commercial terms the agency wants to explore.' } },
    { '@type': 'Question', 'name': 'How is reporting handled for white-label clients?', 'acceptedAnswer': { '@type': 'Answer', 'text': "Reporting is scoped to the partner agency's requirements and agreed during onboarding, not fixed in advance." } }
  ] },
  { '@type': 'BreadcrumbList', 'itemListElement': [{ '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://visible-ads.com/' }, { '@type': 'ListItem', 'position': 2, 'name': 'White-Label PPC & SEO Pricing UK', 'item': 'https://visible-ads.com/white-label-ppc-seo-pricing-uk' }] }
] };
---
<Layout title="White-Label PPC & SEO Pricing UK | Visible Ads" description="How much white-label PPC, paid social and SEO delivery costs in the UK: £500 per month per client account floor, what changes the price, and how the arrangement works." schema={schema}>
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate><div class="absolute inset-0 dot-pattern opacity-5"></div><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative"><nav class="text-sm text-slate-light mb-8"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span class="text-white">White-label pricing</span></nav><div class="max-w-3xl"><span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Agency partners</span><h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">White-Label PPC &amp; SEO Pricing in the UK</h1><p class="text-lg sm:text-xl text-slate-light leading-relaxed">White-label delivery starts from £500 per month per client account. Below that floor, Visible Ads does not take on white-label delivery.</p><a href="mailto:Boh@Visible-Ads.com?subject=White-label%20pricing%20enquiry" class="mt-8 inline-flex items-center justify-center bg-white text-navy font-semibold px-8 py-4 rounded-xl hover:bg-sky-tint transition-colors">Discuss a white-label arrangement</a></div></div></section>

  <section class="py-16 lg:py-20 bg-white" data-animate><div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8"><h2>The short answer</h2><p class="text-lg text-gray-700 mb-6 leading-relaxed">£500 per month per client account is the floor for white-label PPC, paid social or SEO delivery through Visible Ads. It is a minimum, not a price list: the actual fee for a given account depends on the channels involved, the account's complexity and the reporting and communication the partner agency needs.</p><p class="text-lg text-gray-700 leading-relaxed">If a prospective client's budget sits below that floor, it is not a fit for white-label delivery here. Agencies are better placed to have that conversation with their own client than to bring an under-budget account to a delivery partner.</p></div></section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">What changes the price above the floor</h2><div class="grid md:grid-cols-2 gap-6"><div class="bg-white p-6 rounded-2xl border border-gray-100"><h3 class="text-xl font-heading font-bold text-navy mb-3">Channel scope</h3><p class="text-gray-700">Single-channel Google Ads management costs less than a multi-channel account spanning Google, Meta and Amazon under one arrangement.</p></div><div class="bg-white p-6 rounded-2xl border border-gray-100"><h3 class="text-xl font-heading font-bold text-navy mb-3">Account complexity</h3><p class="text-gray-700">Ad spend, SKU count, number of markets and campaign structure change the hours required to manage an account well.</p></div><div class="bg-white p-6 rounded-2xl border border-gray-100"><h3 class="text-xl font-heading font-bold text-navy mb-3">Delivery responsibilities</h3><p class="text-gray-700">Who owns strategy, who owns client communication, and whether Visible Ads works under the agency's brand or its own, all affect the fee.</p></div><div class="bg-white p-6 rounded-2xl border border-gray-100"><h3 class="text-xl font-heading font-bold text-navy mb-3">Reporting requirements</h3><p class="text-gray-700">A white-labelled report matching the agency's own branding and cadence takes more time than a standard monthly summary.</p></div></div></div></section>

  <section class="py-16 lg:py-20 bg-white" data-animate><div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8"><h2>How the arrangement works</h2><p class="text-lg text-gray-700 mb-6 leading-relaxed">The partner agency keeps the client relationship. Visible Ads does the campaign work behind the scenes: strategy, build, optimisation and reporting, to the arrangement agreed with the agency. The agency can present the work under its own brand.</p><p class="text-lg text-gray-700 leading-relaxed">See the full <a href="/ppc-for-professional-services" class="text-electric underline hover:text-electric-dark">professional services and agency partners page</a> for what to bring to a first conversation: client brief, channel scope, access and commercial terms.</p></div></section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Channels that can be white-labelled</h2><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{channels.map((c) => (<a href={c.href} class="block bg-white p-5 rounded-2xl border border-gray-100 hover:shadow-md hover:border-electric/20 transition-all"><h3 class="font-heading font-bold text-navy mb-1">{c.name}</h3><p class="text-sm text-gray-700">{c.note}</p></a>))}</div><p class="mt-8 text-gray-700 leading-relaxed">All six can be discussed within the same brief. Channels can be added at any point once the first account is running.</p></div></section>

  <section class="py-16 lg:py-20 bg-white" data-animate><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Is this the right fit?</h2><div class="grid md:grid-cols-2 gap-8"><div class="bg-white p-6 rounded-2xl border-2 border-emerald-200"><h3 class="text-lg font-heading font-bold text-navy mb-4">Good fit</h3><ul class="space-y-3">{goodFit.map((item) => (<li class="flex gap-3 text-gray-700"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span><span>{item}</span></li>))}</ul></div><div class="bg-white p-6 rounded-2xl border-2 border-gray-200"><h3 class="text-lg font-heading font-bold text-navy mb-4">Not a fit</h3><ul class="space-y-3">{notFor.map((item) => (<li class="flex gap-3 text-gray-700"><span class="text-gray-400 font-bold shrink-0">&#10005;</span><span>{item}</span></li>))}</ul></div></div></div></section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">The delivery, proven on our own client accounts</h2><p class="text-gray-700 leading-relaxed mb-8">A white-labelled account runs on the same <a href="/blueprint" class="text-electric underline hover:text-electric-dark">4-phase Blueprint</a> applied to every Visible Ads engagement: Discover, Strategise, Execute, Optimise.</p><div class="grid md:grid-cols-3 gap-6">{proof.map((p) => (<a href={p.href} class="block bg-white p-6 rounded-2xl border border-gray-100 hover:shadow-md hover:border-electric/20 transition-all"><h3 class="font-heading font-bold text-navy mb-2">{p.name}</h3><p class="text-electric font-heading font-extrabold text-xl mb-1">{p.stat}</p><p class="text-sm text-gray-700">{p.label}</p></a>))}</div></div></section>

  <section class="py-12 bg-white" data-animate><div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"><PartnerBadges compact /></div></section>

  <section class="relative py-20 lg:py-28 bg-navy" data-animate><div class="absolute inset-0 dot-pattern opacity-5"></div><div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center"><h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Have a client account above £500/month?</h2><p class="text-lg text-slate-light mb-8">Bring the brief and we will scope terms against the channels and reporting you need.</p><a href="mailto:Boh@Visible-Ads.com?subject=White-label%20pricing%20enquiry" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Discuss a white-label arrangement</a></div></section>

  <section class="py-16 lg:py-20 bg-sky-tint" data-animate><div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8"><h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Frequently asked questions</h2><div class="space-y-4"><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">How much does a white-label PPC or SEO agency cost in the UK?</summary><p class="mt-4 text-gray-700 leading-relaxed">Visible Ads delivers white-label PPC, paid social and SEO from £500 per month per client account. That is a floor, not a fixed price: exact terms depend on channels, account complexity, reporting and communication requirements.</p></details><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">What is the minimum budget for white-label digital marketing?</summary><p class="mt-4 text-gray-700 leading-relaxed">The minimum engagement is £500 per month per client account. Enquiries below that floor are not a fit for white-label delivery through Visible Ads.</p></details><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">Does the agency or Visible Ads own the client relationship?</summary><p class="mt-4 text-gray-700 leading-relaxed">The partner agency keeps the client relationship. Visible Ads delivers the campaign work behind the scenes, under the arrangement agreed with the partner agency.</p></details><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">Which channels can be white-labelled through Visible Ads?</summary><p class="mt-4 text-gray-700 leading-relaxed">Google Ads, Microsoft Advertising, paid social (Meta, LinkedIn, TikTok), Amazon Advertising, SEO and eCRO can all be discussed within the same white-label brief.</p></details><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">What does an agency need to bring to a first conversation?</summary><p class="mt-4 text-gray-700 leading-relaxed">The client brief and channel scope, how approvals and client communication should work, and the account-access and commercial terms the agency wants to explore.</p></details><details class="group bg-white border border-gray-200 rounded-xl p-6"><summary class="cursor-pointer font-heading font-semibold text-navy">How is reporting handled for white-label clients?</summary><p class="mt-4 text-gray-700 leading-relaxed">Reporting is scoped to the partner agency's requirements and agreed during onboarding, not fixed in advance.</p></details></div></div></section>
</Layout>
