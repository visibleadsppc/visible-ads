---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Turnstile from '../components/Turnstile.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Book a Profit Audit",
      "description": "Get a comprehensive, no-obligation audit of your Google Ads, Bing Ads, or Amazon campaigns.",
      "url": "https://visible-ads.com/free-ads-audit",
      "publisher": {
        "@type": "Organization",
        "name": "Visible Ads"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How long does the audit take?", "acceptedAnswer": { "@type": "Answer", "text": "We deliver the audit within 5 working days of getting access. The walkthrough call is booked at a time that suits you." } },
        { "@type": "Question", "name": "Is there really no obligation?", "acceptedAnswer": { "@type": "Answer", "text": "Absolutely none. The audit is genuinely free. We use it to demonstrate the value we can bring. If you choose to work with us afterwards, great. If not, you still walk away with actionable insights you can implement yourself." } },
        { "@type": "Question", "name": "What platforms do you audit?", "acceptedAnswer": { "@type": "Answer", "text": "We audit Google Ads, Bing Ads, Amazon Advertising, Meta Ads, and any other paid media platform you are running. If you are advertising on it, we can audit it." } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Book a Profit Audit", "item": "https://visible-ads.com/free-ads-audit" }
      ]
    }
  ]
};

const faqs = [
  {
    question: 'How long does the audit take?',
    answer: 'We deliver the audit within 5 working days of getting access. The walkthrough call is booked at a time that suits you.',
  },
  {
    question: 'Is there really no obligation?',
    answer: 'Absolutely none. The audit is genuinely free. We use it to demonstrate the value we can bring. If you choose to work with us afterwards, great. If not, you still walk away with actionable insights you can implement yourself.',
  },
  {
    question: 'What platforms do you audit?',
    answer: 'We audit Google Ads, Bing Ads, Amazon Advertising, Meta Ads, and any other paid media platform you are running. If you are advertising on it, we can audit it.',
  },
];
---

<Layout title="Book a Profit Audit | Visible Ads" description="Book a free, no-obligation profit audit of your Google Ads, Bing Ads, or Amazon campaigns. Discover exactly where you're leaving money on the table." schema={schema}>


  <section class="relative overflow-hidden py-20 lg:py-28 bg-white" data-animate>
    <div class="absolute top-20 left-10 w-32 h-32 bg-electric/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-40 h-40 bg-cyan-400/5 rounded-full blur-3xl"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

        <div class="lg:pt-4">
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-navy mb-6 leading-tight">Book Your Free Profit Audit</h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-8">A comprehensive, no-obligation review of your Google Ads, Bing Ads, Amazon Advertising or Paid Social campaigns. The audit is free for qualifying accounts, with actionable recommendations you keep whether you work with us or not.</p>

          <div class="space-y-5 mb-10">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Campaign Structure Analysis</h3>
                <p class="text-gray-700 text-sm">We review your account architecture, ad groups, match types, and bidding strategies against best practices.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Wasted Spend Identification</h3>
                <p class="text-gray-700 text-sm">We pinpoint exactly where your budget is being wasted on irrelevant clicks, poor-performing keywords, and inefficient targeting.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-sky-tint flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-electric" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-1">Growth Opportunity Mapping</h3>
                <p class="text-gray-700 text-sm">We identify untapped keywords, audiences, and channels where your competitors are winning and you are not.</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-6 flex-wrap">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-sm font-medium text-gray-700">100% Free</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-sm font-medium text-gray-700">No Obligation</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              <span class="text-sm font-medium text-gray-700">Actionable Insights</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 sm:p-10 shadow-xl border border-gray-200 ring-1 ring-electric/10">
          <h2 class="text-2xl font-heading font-bold text-navy mb-6">Request Your Audit</h2>
          <p class="text-gray-700 leading-relaxed mb-6">We take read-only access to your advertising account and, ideally, a view of your product margins. We never make changes during an audit. You see every finding before anything is touched. We deliver the audit within 5 working days of getting access. The walkthrough call is booked at a time that suits you.</p>
          <form id="audit-form" action="/api/submit" method="POST" data-astro-reload class="space-y-5">
            <input type="hidden" name="_form" value="audit" />
            <input type="hidden" name="_next" value="https://visible-ads.com/free-ads-audit?thanks=1" />
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;pointer-events:none" />
            <div>
              <label for="name" class="block text-sm font-medium text-navy mb-1.5">Name</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="Your full name" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-navy mb-1.5">Email</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="you@company.com" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-navy mb-1.5">Phone</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="+44 7XXX XXXXXX" />
            </div>
            <div>
              <label for="website" class="block text-sm font-medium text-navy mb-1.5">Website URL</label>
              <input type="text" inputmode="url" autocapitalize="none" autocorrect="off" spellcheck="false" id="website" name="website" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700" placeholder="yoursite.com" />
            </div>
            <div>
              <label for="budget" class="block text-sm font-medium text-navy mb-1.5">Monthly Ad Spend</label>
              <select id="budget" name="budget" required class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-all text-gray-700">
                <option value="" disabled selected>Select your monthly spend</option>
                <option value="under-5k">Under £5,000</option>
                <option value="5k-20k">£5,000 - £20,000</option>
                <option value="20k-50k">£20,000 - £50,000</option>
                <option value="50k-plus">£50,000+</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-navy mb-1.5">Buyer type, channels and goals</label>
              <p id="message-help" class="text-sm text-gray-700 mb-2">Are you the advertiser, or an agency or professional-services buyer acting on their behalf? Which channels do you run: Google Ads, Bing Ads, Amazon Advertising or Paid Social? Include all that apply, plus your goals and current challenges.</p>
              <textarea id="message" name="message" rows="6" required aria-describedby="message-help" class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white focus:border-electric focus:ring-2 focus:ring-electric/20 outline-none transition-colors text-gray-700 resize-none" placeholder="Buyer type: ... Channels: ... Goals and challenges: ..."></textarea>
            </div>
            <Turnstile />
            <button type="submit" class="w-full px-6 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-cta/25 text-lg">
              Request My Free Audit
            </button>
          </form>
          <script>
            if (window.location.search.includes('thanks=1')) {
              const form = document.getElementById('audit-form');
              if (form) form.innerHTML = '<div class="text-center py-12"><div class="w-16 h-16 rounded-full bg-success/10 flex items-center justify-center mx-auto mb-4"><svg class="w-8 h-8 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg></div><h3 class="text-xl font-heading font-bold text-navy mb-2">Thank You!</h3><p class="text-gray-700">We\'ve received your request. We deliver the audit within 5 working days of getting access. The walkthrough call is booked at a time that suits you.</p></div>';
            }
          </script>
        </div>

      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">What Happens Next?</h2>
        <p class="text-lg text-gray-700">Three simple steps from enquiry to insights.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-electric text-white font-heading font-bold text-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-electric/30">1</div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2">We Review Your Campaigns</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Our senior team digs into your accounts, analysing structure, keywords, bids, creatives, and conversion paths.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-electric text-white font-heading font-bold text-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-electric/30">2</div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2">We Prepare a Detailed Report</h3>
          <p class="text-gray-700 text-sm leading-relaxed">You receive a written report outlining findings, wasted spend, missed opportunities, and specific recommendations.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-electric text-white font-heading font-bold text-2xl flex items-center justify-center mx-auto mb-6 shadow-lg shadow-electric/30">3</div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2">We Walk You Through It</h3>
          <p class="text-gray-700 text-sm leading-relaxed">We schedule a call to walk through the findings, answer your questions, and discuss how we can help you implement the changes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
      <div class="mt-10">
        <GoogleReviews compact />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
            <h3 class="text-lg font-heading font-bold text-navy mb-3">{faq.question}</h3>
            <p class="text-gray-700 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
