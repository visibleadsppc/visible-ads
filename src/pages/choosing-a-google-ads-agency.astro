---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "How to Choose a Google Ads Agency in the UK",
      "description": "A straight buyer's guide to choosing a Google Ads agency: the questions to ask, the fee models to avoid, the red flags, and how to tell profit-first management from ROAS theatre.",
      "url": "https://visible-ads.com/choosing-a-google-ads-agency",
      "publisher": { "@type": "Organization", "name": "Visible Ads" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How much does a Google Ads agency cost in the UK?", "acceptedAnswer": { "@type": "Answer", "text": "Visible Ads offers these tiers per channel managed: SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo); GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo); PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection); PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated. All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice." } },
        { "@type": "Question", "name": "Should I pay an agency a percentage of ad spend?", "acceptedAnswer": { "@type": "Answer", "text": "Check the agreed tier and fee calculation. These tiers apply per channel managed. PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection). PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated." } },
        { "@type": "Question", "name": "What questions should I ask a Google Ads agency before hiring?", "acceptedAnswer": { "@type": "Answer", "text": "Ask whether they bid to your profit margins or just to ROAS, how their fees are structured, whether you will own the account and data, who manages your account day to day, what happens when a campaign stops being profitable, how often they report and on what metrics, and what the minimum term and notice period are." } },
        { "@type": "Question", "name": "Is a big agency or a small specialist better for Google Ads?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on accountability, not size. Large agencies have breadth but often hand day-to-day work to junior staff, with your account one of hundreds. A focused, founder-led specialist typically gives you senior attention and clearer ownership of results. Ask who will actually manage your account, not just who is in the pitch." } },
        { "@type": "Question", "name": "Should a Google Ads agency report on ROAS or profit?", "acceptedAnswer": { "@type": "Answer", "text": "Both, but profit is the one that matters. ROAS is a useful lever, yet a high ROAS on a low-margin product can still lose you money. A good agency ties bidding to your contribution margin and break-even ROAS and reports on the profit their work generates, not just the revenue." } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "How to Choose a Google Ads Agency", "item": "https://visible-ads.com/choosing-a-google-ads-agency" }
      ]
    }
  ]
};

const questions = [
  { q: 'Do you bid to my profit margins, or just to ROAS?', why: 'A high ROAS on a thin-margin product can still lose money. The right answer maps each product to its real margin and bids to your break-even ROAS, not a vanity target.' },
  { q: 'How are your fees structured?', why: 'Ask which fees are fixed, which vary with spend or revenue, and what the minimum term, notice period and exclusions are.' },
  { q: 'Will I own the account, the data and the conversions?', why: 'You should own your Google Ads account and its history outright. If an agency keeps the account in their own name, leaving them means starting from zero.' },
  { q: 'Who actually manages my account, day to day?', why: 'In a large agency the person in the pitch is rarely the person doing the work. Ask for the name and seniority of who runs your account each week.' },
  { q: 'What happens when a campaign stops being profitable?', why: 'The honest answer is that it gets scaled down or switched off, not left running because the budget was there. Ask for the exact rule they follow.' },
  { q: 'How often do you report, and on which metrics?', why: 'Look for a regular read on profit and clicks against a baseline, not a monthly dashboard of vanity numbers. You want to see the commercial result, not activity.' },
  { q: 'What is the minimum term and notice period?', why: 'Long lock-ins protect the agency, not you. A confident agency earns the retainer month to month. Short notice is a sign they back their own work.' },
  { q: 'Can you show relevant results and references?', why: 'Ask for results in a similar market or model, and for a client you can speak to. Certifications and awards are useful signals, but proof beats promises.' },
];

const options = [
  { type: 'In-house hire', cost: 'Salary plus tools and training', results: 'You own it, but on one person', margin: 'Depends entirely on the hire', risk: 'Single point of failure; slow to replace' },
  { type: 'Freelancer', cost: 'Low, hourly or small retainer', results: 'Direct, but limited capacity', margin: 'Varies; often ROAS-led', risk: 'Availability and cover; hard to scale' },
  { type: 'Large full-service agency', cost: 'Higher; often % of spend', results: 'Broad, but you are one of many', margin: 'Frequently reports ROAS, not profit', risk: 'Junior day-to-day; incentive to grow spend' },
  { type: 'Focused profit-first partner', cost: 'Fixed, spend-based or revenue-share terms', results: 'Senior, founder-led ownership', margin: 'Bids to your contribution margin', risk: 'Smaller team, so fit and focus matter', highlight: true },
];

const redFlags = [
  { flag: 'Unclear fee calculations', body: 'Ask which fees vary with spend or revenue and how they are calculated before agreeing terms.' },
  { flag: 'ROAS-only reporting with no view of margin', body: 'Revenue-per-pound looks impressive and tells you nothing about whether you actually made money.' },
  { flag: 'Long lock-in contracts', body: 'A twelve-month tie-in protects the agency from being judged on results. Good work earns the next month.' },
  { flag: 'The account is not in your name', body: 'If you do not own the account, you do not own the data or the history you paid to build.' },
  { flag: 'Vague on who does the work', body: 'If they will not name who manages your account week to week, assume it is the most junior person free.' },
];

const good = [
  { title: 'Profit before ROAS', body: 'Spend follows real margin. A campaign that is not profitable gets scaled down, not left running to flatter the report.' },
  { title: 'Clear tier and fee terms', body: 'These tiers apply per channel managed. SILVER and GOLD have fixed retainers. PLATINUM includes 5%. PERFORMANCE includes a revenue-share component, by application, individually negotiated.' },
  { title: 'You own everything', body: 'Your account, your data, your conversions. Full transparency into what is being done and why.' },
  { title: 'Senior, accountable people', body: 'The person who wins your business is the person who runs it. Founder-led attention, not a junior on account number three hundred.' },
];
---

<Layout title="How to Choose a Google Ads Agency in the UK | Visible Ads" description="A straight buyer's guide to choosing a Google Ads agency: the questions to ask, the fee models to avoid, and how to spot profit-first management." schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-electric-light font-heading font-semibold text-sm tracking-wide uppercase mb-4">Buyer's Guide</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white mb-6 leading-tight">How to choose a Google Ads agency, without getting burned</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed mb-8">Most agencies optimise to ROAS because it looks good in a report. ROAS does not pay your bills, profit does. This is the straight guide: the questions to ask, the fee models to avoid, and how to tell real profit-first management from vanity numbers, whoever you end up choosing.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/free-ads-audit" class="px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg hover:shadow-xl">Book a Profit Audit</a>
          <a href="/how-we-audit" class="px-8 py-4 bg-white/10 text-white font-semibold rounded-lg hover:bg-white/20 border border-white/20 transition-all duration-200">See how we work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Answer-first summary -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-sky-tint rounded-2xl p-8 border border-electric/10">
        <h2 class="text-xl font-heading font-bold text-navy mb-4">The short answer</h2>
        <p class="text-gray-700 leading-relaxed mb-4">To choose a Google Ads agency in the UK, judge four things: how their fee is aligned to your profit, whether they bid to your margins or just to ROAS, who actually manages your account, and whether you own the account and data. Check how fees change with spend or revenue, ask for the minimum term and notice period, and expect reporting on profit against a baseline, not a dashboard of vanity metrics.</p>
        <p class="text-gray-700 leading-relaxed">The rest of this guide gives you the exact questions, a side-by-side of your options, the red flags, and what good looks like.</p>
      </div>
    </div>
  </section>

  <!-- The questions to ask -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Eight questions to ask any Google Ads agency</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Print these and take them into every pitch. The answers tell you more than any case study.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {questions.map((item, i) => (
          <div class="bg-white rounded-2xl p-7 shadow-sm border border-gray-100">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-lg bg-electric text-white font-heading font-bold text-base flex items-center justify-center shadow-md shadow-electric/30 flex-shrink-0">{i + 1}</div>
              <div>
                <h3 class="font-heading font-bold text-navy mb-2 text-base leading-snug">{item.q}</h3>
                <p class="text-gray-700 text-sm leading-relaxed">{item.why}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Options compared -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Agency, freelancer or in-house? Compared</h2>
        <p class="text-lg text-gray-700 leading-relaxed">The four ways UK businesses run Google Ads, and where each one tends to win or fall short.</p>
      </div>
      <div class="max-w-5xl mx-auto overflow-x-auto">
        <div class="overflow-hidden rounded-2xl border border-gray-200 shadow-sm min-w-[720px]">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-navy">
                <th class="px-5 py-4 text-left font-heading font-semibold text-slate-light text-xs uppercase tracking-wide">Option</th>
                <th class="px-5 py-4 text-left font-heading font-semibold text-slate-light text-xs uppercase tracking-wide">Typical cost</th>
                <th class="px-5 py-4 text-left font-heading font-semibold text-slate-light text-xs uppercase tracking-wide">Accountability</th>
                <th class="px-5 py-4 text-left font-heading font-semibold text-slate-light text-xs uppercase tracking-wide">Margin focus</th>
                <th class="px-5 py-4 text-left font-heading font-semibold text-slate-light text-xs uppercase tracking-wide">Main risk</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              {options.map((row) => (
                <tr class={row.highlight ? 'bg-sky-tint' : 'hover:bg-gray-50 transition-colors duration-100'}>
                  <td class="px-5 py-4 font-heading font-bold text-navy">{row.type}</td>
                  <td class="px-5 py-4 text-gray-700">{row.cost}</td>
                  <td class="px-5 py-4 text-gray-700">{row.results}</td>
                  <td class={`px-5 py-4 ${row.highlight ? 'text-electric font-semibold' : 'text-gray-700'}`}>{row.margin}</td>
                  <td class="px-5 py-4 text-gray-700">{row.risk}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5 text-sm text-gray-600 leading-relaxed text-center">There is no single right answer. The point is to match the model to how much senior attention and margin discipline your account needs.</p>
      </div>
    </div>
  </section>

  <!-- Red flags -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Five red flags to walk away from</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Any one of these should give you pause. Two or more, and keep looking.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {redFlags.map((item) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-cta flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"/></svg>
              <h3 class="font-heading font-bold text-navy text-sm leading-snug">{item.flag}</h3>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What good looks like -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">What good looks like</h2>
        <p class="text-lg text-gray-700 leading-relaxed">The standard we hold ourselves to, and the one worth holding any agency to.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {good.map((item) => (
          <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
            <svg class="w-9 h-9 text-electric mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <h3 class="text-lg font-heading font-bold text-navy mb-3">{item.title}</h3>
            <p class="text-gray-700 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Challenger positioning -->
  <section class="py-20 lg:py-28 bg-navy relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">Where Visible Ads fits</h2>
        <p class="text-lg text-slate-light leading-relaxed mb-6">We are the focused, founder-led option: a Google, Microsoft, Amazon and Meta partner, award-winning at the UK Search Awards, that treats your profit and loss as the scoreboard, not your ROAS. We are not the biggest agency you will speak to, which is exactly why your account gets senior attention and the tier options below.</p>
        <p class="text-lg text-slate-light leading-relaxed mb-8">Because we are the challenger, we try harder. The audit is free, the report is yours to keep, and if the numbers do not support working together, we will tell you.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/free-ads-audit" class="px-8 py-4 bg-cta text-white font-semibold rounded-lg hover:bg-electric transition-all duration-200 shadow-lg">Book a Profit Audit</a>
          <a href="/case-studies" class="px-8 py-4 bg-white/10 text-white font-semibold rounded-lg hover:bg-white/20 border border-white/20 transition-all duration-200">See our results</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
      <div class="mt-10">
        <GoogleReviews compact />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-12 text-center">Frequently asked questions</h2>
      <div class="space-y-6">
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
          <h3 class="text-lg font-heading font-bold text-navy mb-3">How much does a Google Ads agency cost in the UK?</h3>
          <p class="text-gray-700 leading-relaxed">Visible Ads offers these tiers per channel managed: SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo); GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo); PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection); PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated. All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
          <h3 class="text-lg font-heading font-bold text-navy mb-3">Should I pay an agency a percentage of ad spend?</h3>
          <p class="text-gray-700 leading-relaxed">Check the agreed tier and fee calculation. These tiers apply per channel managed. PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection). PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
          <h3 class="text-lg font-heading font-bold text-navy mb-3">Is a big agency or a small specialist better for Google Ads?</h3>
          <p class="text-gray-700 leading-relaxed">It comes down to accountability, not size. Large agencies have breadth but often hand day-to-day work to junior staff, with your account one of hundreds. A focused, founder-led specialist typically gives you senior attention and clearer ownership of results. Ask who will actually manage your account, not just who is in the pitch.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
          <h3 class="text-lg font-heading font-bold text-navy mb-3">Should a Google Ads agency report on ROAS or profit?</h3>
          <p class="text-gray-700 leading-relaxed">Both, but profit is the one that matters. ROAS is a useful lever, yet a high ROAS on a low-margin product can still lose you money. A good agency ties bidding to your contribution margin and break-even ROAS, and reports on the profit their work generates, not just the revenue.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="py-16 lg:py-20 bg-electric" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">Put us to the test</h2>
      <p class="text-lg text-white/90 leading-relaxed mb-8 max-w-2xl mx-auto">Book a free profit audit of your Google Ads account. Five working days, senior attention, and a report you keep whether or not we work together.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/free-ads-audit" class="px-8 py-4 bg-white text-electric font-semibold rounded-lg hover:bg-gray-100 transition-all duration-200 shadow-lg">Book a Profit Audit</a>
        <a href="/how-we-audit" class="px-8 py-4 bg-electric-dark text-white font-semibold rounded-lg hover:bg-navy border border-white/20 transition-all duration-200">See how we audit</a>
      </div>
    </div>
  </section>

</Layout>
