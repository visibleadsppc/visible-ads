---
import Layout from '../layouts/Layout.astro';
import ProfitCalculator from '../components/ProfitCalculator.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import GoogleReviews from '../components/GoogleReviews.astro';

const faqs = [
  { question: 'What is the difference between ROAS and profit?', answer: 'ROAS (return on ad spend) is revenue divided by ad spend. It ignores the cost of your products. Profit is what is left after both product cost and ad spend. A 4x ROAS sounds healthy. At a 25% gross margin it is exactly break-even and you make nothing.' },
  { question: 'What is break-even ROAS?', answer: 'Break-even ROAS is 1 divided by your margin, so a 25% margin needs 4x before you make anything. The break-even ROAS guide shows how to build it on contribution margin.' },
  { question: 'Why do agencies report ROAS instead of profit?', answer: 'ROAS is easy to pull from the Google Ads dashboard and it usually looks impressive. Profit needs your margins and your P&L. That takes more work and is harder to flatter. We manage to ROAS targets set from your margin and judge the result on profit.' },
  { question: 'Does POAS work for low-margin businesses?', answer: 'Yes. It matters more there because thin margins make the gap between a break-even ROAS and a profitable one small. A POAS-first approach stops those campaigns draining cash.' },
  { question: 'How long does it take to move from ROAS to POAS reporting?', answer: 'It depends on how complete your cost and margin data is and how large the catalogue is. A small catalogue with clean margin data is quicker to map than a large one with gaps.' },
  { question: 'What data do you need from me to calculate POAS?', answer: 'At minimum you need cost of goods sold or gross margin per product or category. Add any other true costs you want counted, such as marketplace fees or return rates. The more granular the margin data, the more accurate the profit picture.' },
];

const quickAnswers = [
  {
    question: 'What is net ROAS and how is it different from ROAS?',
    answer: 'Net ROAS is revenue after VAT, refunds and cancellations, divided by ad spend. It is a stricter version of the platform figure because it only counts money you kept from those orders. There is no single official definition, so write down what your business takes off and use the same version every month.',
  },
  {
    question: 'What is gross ROAS and where do I find it?',
    answer: 'Gross ROAS is the figure the ad platform shows. It is conversion revenue divided by ad spend, with nothing taken off for refunds, cancellations or product costs. In Google Ads it is the Conv. value / cost column. VAT can still be inside it, depending on how your conversion value is set up. It compares campaigns well but cannot tell you on its own whether you made money.',
  },
  {
    question: 'What is profit ROAS (profit on ad spend)?',
    answer: 'Profit ROAS is another name for POAS, profit on ad spend. Take the contribution from your sales (revenue less product cost and the other direct costs you include) and divide it by what you spent on ads. A POAS of 1.0 means the sales exactly covered their own cost plus the ad spend. Anything above 1.0 is money left over.',
  },
  {
    question: 'What is a high ROAS, and what counts as a bad one?',
    answer: 'A high ROAS is one that sits comfortably above your own break-even ROAS, which is 1 divided by your margin. A bad ROAS is one below it, because every sale then costs more than it earns. No single number is high or bad for everyone. A 4x ROAS is well above break-even on a 50% margin and below it on a 20% margin. Find your margin in the break-even table further down or in the calculator above before you judge any figure.',
    more: { href: '/blog/target-roas-by-margin', label: 'What counts as a high target ROAS for your margin' },
  },
  {
    question: 'Why is my ROAS high but my profit low?',
    answer: 'Because ROAS only compares revenue with ad spend. Profit also has to pay for the product, payment fees, delivery and refunds, plus the agency fee in your P&L. A 4x ROAS is exactly break-even at a 25% gross margin, so any lower margin leaves little or nothing before overheads. The usual causes are a thin margin, a high return rate, discounted lines outselling full-price ones, VAT sitting inside reported revenue, and the same sale being claimed by more than one platform.',
  },
];

const compareRows = [
  { use: 'Comparing campaigns against each other', name: 'Gross ROAS', definition: 'Conversion revenue divided by ad spend', includes: 'Revenue as the platform reports it. Refunds, cancellations and product costs are not taken off, and VAT can still be inside it.' },
  { use: 'Checking how much of the reported revenue you kept', name: 'Net ROAS', definition: 'Revenue after VAT, refunds and cancellations, divided by ad spend', includes: 'Only the money you kept from those orders. You choose what to take off, so write the version down.' },
  { use: 'Deciding whether the spend made money', name: 'Profit ROAS (POAS)', definition: 'Contribution divided by ad spend', includes: 'Revenue less product cost and the other direct costs you include.' },
];

const reconcile = {
  question: 'My agency reports platform ROAS but my P&L says we lost money. How do I reconcile them?',
  answer: 'Both numbers can be right because they measure different things. Platform ROAS is attributed revenue divided by ad spend. Your P&L is real money after every cost. Work through the gap in this order.',
  steps: [
    'Match the dates. Platforms date a sale by click or conversion time, your P&L by order or payment date. Use the same period for both.',
    'Compare platform conversions with real orders from your shop or accounts system for those dates. If the platforms together report more sales than you took, some are being counted twice.',
    'Take VAT, refunds and cancellations off the revenue to get net revenue.',
    'Take off product cost, payment fees and delivery to get contribution.',
    'Take off ad spend, and the agency fee if your P&L carries it. The ad platform never includes that fee in ROAS.',
    'Divide the contribution by ad spend to get POAS, and compare your ROAS with your break-even ROAS. If the profit is still negative, your ROAS was below break-even.',
  ],
};

const allQa = [...quickAnswers, reconcile, ...faqs];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "ROAS vs Profit: why a high ROAS can still lose money",
      "description": "ROAS measures revenue, not profit. Learn the difference between ROAS, POAS and break-even ROAS, and use the calculator to check whether your Google Ads are actually profitable.",
      "url": "https://visible-ads.com/roas-vs-profit",
      "publisher": { "@type": "Organization", "name": "Visible Ads" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": allQa.map((q) => ({
        "@type": "Question",
        "name": q.question,
        "acceptedAnswer": { "@type": "Answer", "text": q.steps ? `${q.answer} ${q.steps.map((t, i) => `${i + 1}. ${t}`).join(' ')}` : q.answer }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "ROAS vs Profit", "item": "https://visible-ads.com/roas-vs-profit" }
      ]
    }
  ]
};

const breakEvenRows = [
  { margin: '20%', roas: '5.0x' },
  { margin: '25%', roas: '4.0x' },
  { margin: '30%', roas: '3.3x' },
  { margin: '40%', roas: '2.5x' },
  { margin: '50%', roas: '2.0x' },
  { margin: '60%', roas: '1.7x' },
];

---

<Layout title="High ROAS, Low Profit? ROAS vs Profit Explained | Visible Ads" description="ROAS measures revenue, not profit. Use the free calculator to see if your Google Ads are actually profitable, and learn break-even ROAS and POAS in plain terms." schema={schema}>

  <!-- Hero -->
  <section class="py-20 lg:py-28 bg-gradient-to-br from-navy to-navy-light relative overflow-hidden" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-electric-light font-heading font-semibold text-sm tracking-wide uppercase mb-4">ROAS vs Profit</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white mb-6 leading-tight">A 4x ROAS can still lose you money</h1>
        <p class="text-lg sm:text-xl text-slate-light leading-relaxed">ROAS measures revenue, not profit. Once you factor in your product margin, a number that looks healthy on the dashboard can be running at a loss. Put your own figures into the calculator and see where you really stand.</p>
      </div>
    </div>
  </section>

  <!-- Calculator (the hook) -->
  <section class="py-16 lg:py-24 bg-gray-50" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ProfitCalculator />
    </div>
  </section>

  <!-- The explainer -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">The difference, in plain terms</h2>
      <p class="text-gray-700 leading-relaxed mb-5"><strong class="text-navy">ROAS</strong> is revenue divided by ad spend. Spend £10,000, make £40,000 back, and your ROAS is 4x. It says nothing about whether you kept any of it.</p>
      <p class="text-gray-700 leading-relaxed mb-5"><strong class="text-navy">Profit</strong> is what is left after the product cost and the ad spend. If those sales carry a 25% gross margin, that £40,000 of revenue is only £10,000 of gross profit, and you spent £10,000 to get it. You broke even. The 4x ROAS made nothing.</p>
      <p class="text-gray-700 leading-relaxed mb-5"><strong class="text-navy">Break-even ROAS</strong> is the line between the two. It is 1 divided by your margin. Below it you lose money on every extra pound. Above it you are in profit. It is the single most useful number most accounts are not tracking.</p>
      <p class="text-gray-700 leading-relaxed"><strong class="text-navy">POAS</strong> (profit on ad spend) is contribution divided by ad spend. A POAS of 1.0 means the sales covered their own costs and the ad spend, and anything above 1.0 is profit.</p>
    </div>
  </section>

  <!-- Quick answers -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">Net ROAS, gross ROAS and profit ROAS: quick answers</h2>
      <div class="space-y-8">
        {quickAnswers.map((qa) => (
          <div>
            <h3 class="text-xl font-heading font-bold text-navy mb-2">{qa.question}</h3>
            <p class="text-gray-700 leading-relaxed">{qa.answer}</p>
            {qa.more && <p class="mt-2"><a href={qa.more.href} class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">{qa.more.label}</a></p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gross, net and profit ROAS table -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Which ROAS figure to use for which decision</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">All three divide by the same ad spend. They differ in what comes off the revenue first.</p>
      <p class="text-sm text-gray-700 mb-2 md:hidden">Swipe sideways to see every column.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200" tabindex="0" role="region" aria-label="Gross, net and profit ROAS compared, scrolls sideways on small screens">
        <table class="w-full min-w-[640px] text-left text-base">
          <caption class="sr-only">Which ROAS figure to use for which decision, with definition and what each includes</caption>
          <thead class="bg-navy text-white"><tr><th scope="col" class="p-4">Best used for</th><th scope="col" class="p-4">Measure</th><th scope="col" class="p-4">Definition</th><th scope="col" class="p-4">What it includes</th></tr></thead>
          <tbody class="text-gray-700">
            {compareRows.map((r, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th scope="row" class="p-4 font-semibold text-navy align-top">{r.use}</th><td class="p-4 align-top font-semibold text-navy">{r.name}</td><td class="p-4 align-top">{r.definition}</td><td class="p-4 align-top">{r.includes}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Symptoms -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Signs your ROAS is overstating profit</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">A healthy-looking ROAS can hide a business that is losing money. These are the usual signs.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-4 border-electric">
          <h3 class="font-heading text-lg font-bold text-navy mb-3">Your bank balance doesn't move</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Revenue is up on the dashboard. The money in the account tells a different story.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-4 border-amber-500">
          <h3 class="font-heading text-lg font-bold text-navy mb-3">Margins shrink as you scale</h3>
          <p class="text-gray-700 text-sm leading-relaxed">Every extra pound of spend chases lower-margin sales and dilutes the average.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-4 border-purple-600">
          <h3 class="font-heading text-lg font-bold text-navy mb-3">Your best-looking SKUs aren't your best-earning ones</h3>
          <p class="text-gray-700 text-sm leading-relaxed">High-revenue products can carry the thinnest margins in the whole catalogue.</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-4 border-emerald-500">
          <h3 class="font-heading text-lg font-bold text-navy mb-3">Returns eat the profit after the sale</h3>
          <p class="text-gray-700 text-sm leading-relaxed">ROAS is calculated at the point of sale. Profit isn't decided until the return window closes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Worked example -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">A worked example</h2>
      <p class="text-gray-700 leading-relaxed mb-5">Say a £25,000-a-month account is running at a 4x ROAS. That looks strong on the dashboard. The products driving that revenue carry a 22% gross margin, though. That puts break-even ROAS at 4.55x.</p>
      <div class="grid sm:grid-cols-2 gap-6 my-8">
        <div class="bg-sky-tint rounded-2xl p-6">
          <p class="text-sm font-semibold text-slate uppercase tracking-wide mb-2">What the dashboard shows</p>
          <p class="text-3xl font-heading font-extrabold text-navy mb-1">4x ROAS</p>
          <p class="text-sm text-gray-700">£25,000 spend, £100,000 revenue</p>
        </div>
        <div class="bg-navy rounded-2xl p-6">
          <p class="text-sm font-semibold text-slate-light uppercase tracking-wide mb-2">What the P&L shows</p>
          <p class="text-3xl font-heading font-extrabold text-white mb-1">-£3,000</p>
          <p class="text-sm text-slate-light">£22,000 gross profit, minus £25,000 ad spend</p>
        </div>
      </div>
      <p class="text-gray-700 leading-relaxed">A 4x ROAS reads as a win. The account is actually running at a loss. It sits below its own break-even ROAS. This is the exact gap a profit audit is built to catch.</p>
    </div>
  </section>

  <!-- Reconcile -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">{reconcile.question}</h2>
      <p class="text-gray-700 leading-relaxed mb-6">{reconcile.answer}</p>
      <ol class="space-y-4 mb-6">
        {reconcile.steps.map((step, i) => (
          <li class="flex gap-3 text-gray-700 leading-relaxed"><span class="text-electric font-heading font-bold shrink-0">{i + 1}.</span><span>{step}</span></li>
        ))}
      </ol>
      <p class="text-gray-700 leading-relaxed">The <a href="/how-we-audit" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">profit audit method</a> shows how we check platform revenue against your orders.</p>
    </div>
  </section>

  <!-- Break-even table -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">The ROAS you actually need</h2>
        <p class="text-lg text-gray-700 leading-relaxed">Your break-even ROAS depends on your margin. These rows use gross margin, which gives the lowest possible floor. Use contribution margin for your real one.</p>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-navy text-white">
              <th class="px-6 py-4 font-heading font-semibold text-sm">Gross margin</th>
              <th class="px-6 py-4 font-heading font-semibold text-sm">Break-even ROAS</th>
            </tr>
          </thead>
          <tbody>
            {breakEvenRows.map((r, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-6 py-4 text-navy font-semibold">{r.margin}</td>
                <td class="px-6 py-4 text-electric font-heading font-bold">{r.roas}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-center text-gray-600 text-sm mt-4">Anything below your row is losing money on every extra pound of spend. The <a href="/blog/break-even-roas" class="text-electric font-semibold hover:text-electric-dark underline decoration-electric/30">break-even ROAS guide</a> shows how to build this number on contribution margin.</p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="font-heading text-3xl sm:text-4xl font-bold text-navy">How We Get You From ROAS to POAS</h2>
        <p class="mt-4 text-lg text-slate max-w-2xl mx-auto">A four-step process that replaces vanity ROAS with a number tied to your real P&L.</p>
      </div>
      <div class="relative">
        <div class="hidden lg:block absolute top-10 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-electric via-electric-light to-electric"></div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
          <div class="text-center relative">
            <div class="w-20 h-20 rounded-full bg-electric text-white flex items-center justify-center text-2xl font-heading font-extrabold mx-auto relative z-10 shadow-lg shadow-electric/30">1</div>
            <h3 class="font-heading text-xl font-bold text-navy mt-6 mb-3">Map Margins</h3>
            <p class="text-slate text-sm leading-relaxed">We map true product or category-level margins across your catalogue. Not one blended figure.</p>
          </div>
          <div class="text-center relative">
            <div class="w-20 h-20 rounded-full bg-amber-500 text-white flex items-center justify-center text-2xl font-heading font-extrabold mx-auto relative z-10 shadow-lg shadow-amber-500/30">2</div>
            <h3 class="font-heading text-xl font-bold text-navy mt-6 mb-3">Rebuild Bidding to Profit</h3>
            <p class="text-slate text-sm leading-relaxed">Bid strategy gets rebuilt around margin-weighted targets, not a single blanket ROAS goal.</p>
          </div>
          <div class="text-center relative">
            <div class="w-20 h-20 rounded-full bg-purple-600 text-white flex items-center justify-center text-2xl font-heading font-extrabold mx-auto relative z-10 shadow-lg shadow-purple-600/30">3</div>
            <h3 class="font-heading text-xl font-bold text-navy mt-6 mb-3">Segment by Profitability</h3>
            <p class="text-slate text-sm leading-relaxed">High-margin SKUs and low-margin loss-leaders get separated. Budget follows profit, not volume.</p>
          </div>
          <div class="text-center relative">
            <div class="w-20 h-20 rounded-full bg-emerald-500 text-white flex items-center justify-center text-2xl font-heading font-extrabold mx-auto relative z-10 shadow-lg shadow-emerald-500/30">4</div>
            <h3 class="font-heading text-xl font-bold text-navy mt-6 mb-3">Report on POAS</h3>
            <p class="text-slate text-sm leading-relaxed">Vanity ROAS reporting gets replaced with a profit-first dashboard tied to your real P&L.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="py-16 lg:py-20 bg-electric" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-4">We find this in your real account</h2>
      <p class="text-lg text-white/90 leading-relaxed mb-8 max-w-2xl mx-auto">The calculator uses one blended margin. Your account has hundreds of products, each with its own. Our profit audit maps the real picture. It is free.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/free-ads-audit" class="px-8 py-4 bg-white text-electric font-semibold rounded-lg hover:bg-gray-100 transition-all duration-200 shadow-lg">Book a Profit Audit</a>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
      <div class="mt-10">
        <GoogleReviews compact />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-12 text-center">Frequently asked questions</h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
            <h3 class="text-lg font-heading font-bold text-navy mb-3">{faq.question}</h3>
            <p class="text-gray-700 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
