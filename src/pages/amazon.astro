---
import Layout from '../layouts/Layout.astro';
import PartnerBadges from '../components/PartnerBadges.astro';

const faqs = [
  {
    question: 'What does an Amazon PPC agency do?',
    answer: 'It runs your Amazon advertising for you. That means building the campaigns, setting bids and budgets, removing search terms that waste spend and reporting the result. We run each of those steps against the profit on every product.',
  },
  {
    question: 'Which Amazon ad types do you manage?',
    answer: 'Sponsored Products, Sponsored Brands and Sponsored Display. Most accounts start with Sponsored Products because they sit in search results next to the organic listings. We add the other two once the first campaigns are earning.',
  },
  {
    question: 'Why do you track TACoS and not only ACoS?',
    answer: 'ACoS only counts sales that came from an ad. TACoS counts all of your Amazon sales. If your ads help a product rank organically, TACoS falls while ACoS can stay flat. Watching both shows whether the advertising is building the business.',
  },
  {
    question: 'How do you decide how much budget to put behind a product?',
    answer: 'We start from the profit per unit and then follow the weekly ROAS rules we use on every channel. Budget goes up where the return is strong and comes down where it is weak. Profit is the target and ROAS is the control we manage to.',
  },
  {
    question: 'Which Amazon marketplaces do you work in?',
    answer: 'Our clients sell in the UK, the US and Europe. We manage the Amazon marketplaces they trade in. Tell us which ones you sell in when you book the audit.',
  },
  {
    question: 'Are you an Amazon advertising consultant or a full agency?',
    answer: 'We manage the account every week. If you only want a one-off review, the free audit is the place to start. It shows where spend is earning and where it is leaking.',
  },
  {
    question: 'What does Amazon charge per click?',
    answer: 'It varies by category and by how many sellers bid on the same terms. Our Amazon Ads cost guide for UK sellers lists the typical ranges for each ad type.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Amazon PPC Management',
      serviceType: 'Amazon PPC management',
      provider: { '@type': 'Organization', name: 'Visible Ads', url: 'https://visible-ads.com' },
      description: 'Amazon PPC management for ecommerce brands: Sponsored Products, Sponsored Brands and Sponsored Display campaigns run against unit profit and TACoS.',
      url: 'https://visible-ads.com/amazon/',
      areaServed: ['GB', 'US', 'EU'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://visible-ads.com/' },
        { '@type': 'ListItem', position: 2, name: 'Amazon PPC Agency', item: 'https://visible-ads.com/amazon/' },
      ],
    },
  ],
};

const adTypes = [
  { title: 'Sponsored Products', text: 'Ads for single products that show in search results and on product pages. We build them by keyword and by product target. Search terms that spend without selling are excluded every week.' },
  { title: 'Sponsored Brands', text: 'Ads that put your brand and several products at the top of search results. We use them to protect your brand terms and to introduce a range once single products are earning.' },
  { title: 'Sponsored Display', text: 'Ads that reach shoppers who looked at your products and did not buy. We keep the targeting narrow and judge them on the same profit rules as the rest of the account.' },
];

const measures = [
  { measure: 'ACoS', divides: 'Ad spend by sales that came from ads', shows: 'Whether a campaign pays for itself' },
  { measure: 'TACoS', divides: 'Ad spend by all Amazon sales', shows: 'Whether advertising is building organic sales too' },
  { measure: 'Profit per unit', divides: 'Price minus product cost, Amazon fees and ad spend', shows: 'Whether a sale made money' },
];

const steps = [
  { title: 'Audit your numbers', text: 'We take your product cost, Amazon fees and current ad data. The result is a profit figure for each product and the ACoS at which it stops making money. You also see which campaigns are earning today and which are leaking.' },
  { title: 'Build the campaigns', text: 'Campaigns are grouped by product and by the margin each product can carry. A product with a thin margin does not share a budget with a product with a wide one.' },
  { title: 'Manage every week', text: 'We review bids, search terms and budgets weekly. Above 1,200% ROAS a budget rises by 20% a week. Below 300% the spend is switched off. The full set of rules is on our PPC management page.' },
  { title: 'Scale what earns', text: 'Once a product holds its profit we widen the targeting and add the other ad types. We check TACoS before each step up.' },
];
---

<Layout title="Amazon PPC Agency | Amazon Ads Management | Visible Ads" description="Amazon PPC agency for ecommerce brands. We manage Sponsored Products, Brands and Display against unit profit and TACoS. Free audit to start." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-light mb-8"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span class="text-white">Amazon PPC Agency</span></nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Amazon Ads Verified Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Amazon PPC Agency for Ecommerce Brands</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">We manage your Sponsored Products, Sponsored Brands and Sponsored Display campaigns. Each decision is made against the profit on the product and your TACoS. ACoS alone does not drive it.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
          <a href="#profit" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">How we measure profit</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What we manage -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What our Amazon ads management covers</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">We run three Amazon ad types and set each one a profit target. Your ad spend is paid to Amazon and our fee is separate. A product only gets budget once it has a profit figure behind it.</p>
      <dl class="space-y-6 text-lg text-gray-700 leading-relaxed">
        {adTypes.map((a) => (
          <div>
            <dt class="font-heading font-bold text-navy">{a.title}</dt>
            <dd>{a.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Profit and TACoS -->
  <section id="profit" class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Unit profit and TACoS come before ACoS</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">A campaign can show a healthy ACoS and still lose money on every sale. We therefore start from the profit on each unit and treat ACoS as one input.</p>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">Take a product that leaves 30% of its price after cost and fees. It breaks even at a 30% ACoS. Every point of ACoS below that is profit and every point above it is a loss.</p>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">Here is the same sum in pounds. A £20 product costs £8 to buy and £4 to ship and fulfil through Amazon. That leaves £8 before ads, which is 40% of the price. At a 25% ACoS the ad costs £5, so each sale keeps £3. At a 45% ACoS the ad costs £9, so each sale loses £1. The figures are an illustration and not a client account.</p>
      </div>
      <p class="text-sm text-gray-700 mb-2 md:hidden">Swipe sideways to see every column.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white" tabindex="0" role="region" aria-label="Amazon advertising measures, scrolls sideways on small screens">
        <table class="w-full min-w-[600px] text-left text-base">
          <caption class="sr-only">The three measures we use on Amazon accounts</caption>
          <thead class="bg-navy text-white"><tr><th scope="col" class="p-4">Measure</th><th scope="col" class="p-4">What it divides</th><th scope="col" class="p-4">What it shows</th></tr></thead>
          <tbody class="text-gray-700">
            {measures.map((m, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th scope="row" class="p-4 font-semibold text-navy align-top">{m.measure}</th><td class="p-4 align-top">{m.divides}</td><td class="p-4 align-top">{m.shows}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-lg text-gray-700 mt-8 max-w-3xl leading-relaxed">Good advertising lifts a product up the organic results. Its total sales grow and TACoS falls. A falling TACoS next to a steady profit per unit is the sign we look for. Our <a href="/roas-vs-profit/" class="text-electric underline hover:text-electric-dark">ROAS vs profit calculator</a> shows the break-even point for your own margin.</p>
    </div>
  </section>

  <!-- Process -->
  <section id="process" class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">How the work runs</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">The work follows four steps and the weekly review never stops.</p>
      <ol class="space-y-6">
        {steps.map((s, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 w-10 h-10 bg-electric text-white rounded-full flex items-center justify-center font-bold" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="font-heading font-bold text-navy text-lg">{s.title}</h3>
              <p class="text-lg text-gray-700 leading-relaxed">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="text-gray-700 mt-8 leading-relaxed">The same rules run across every channel we manage. See <a href="/ppc-management/" class="text-electric underline hover:text-electric-dark">PPC management</a> for the full ladder.</p>
    </div>
  </section>

  <!-- Reporting -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What you see each week</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">You get a weekly call or video update, a KPI dashboard and a quarterly review. Each report is in plain English and starts with profit.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">We compare Amazon's own figures with your sales records. That way a decision rests on orders that happened.</p>
      <p class="text-lg text-gray-700 leading-relaxed">Profit per product comes first in every report. Spend, sales and ROAS follow it.</p>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Proof from an Amazon account we manage</h2>
      <div class="bg-sky-tint rounded-2xl p-6 sm:p-8 border border-gray-100">
        <p class="text-3xl font-heading font-extrabold text-electric mb-2">8.5x ROAS</p>
        <p class="text-lg text-gray-700 leading-relaxed"><strong class="text-navy">CFW Amazon Ads.</strong> All-time sales of £769,025.79 came from £91,902.91 of spend across 17,566 purchases.</p>
      </div>
      <p class="text-gray-700 mt-6 leading-relaxed">A second account, Sephra USA, is written up in the <a href="/case-studies/sephra-usa-amazon/" class="text-electric underline hover:text-electric-dark">Sephra USA Amazon case study</a>.</p>
    </div>
  </section>

  <!-- Who it suits -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Who this suits</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">It suits ecommerce brands that sell on Amazon and know what each product costs them. Most of our clients are direct to consumer and business brands with £1M to £20M in annual revenue.</p>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">If you sell on your own site as well, we plan the two together. Read about <a href="/amazon-google-ads/" class="text-electric underline hover:text-electric-dark">Amazon and Google Ads together</a> to see how that works.</p>
      <p class="text-lg text-gray-700 leading-relaxed">We set targets from your product costs, so it helps if you can share them early.</p>
    </div>
  </section>

  <!-- Fees -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What our management fee covers</h2>
      <p class="text-lg text-gray-700 mb-4 leading-relaxed">Our fees are per channel managed plus VAT. Each fee covers unlimited campaigns on that channel. Your ad budget is paid to Amazon separately. The minimum term is three months and then it rolls monthly with 30 days notice.</p>
      <p class="text-lg text-gray-700 leading-relaxed">The Silver, Gold and Platinum tiers and the minimum term are on our <a href="/ppc-management/#pricing" class="text-electric underline hover:text-electric-dark">PPC management pricing</a> section.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Amazon PPC questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white border border-gray-200 rounded-xl p-6">
            <summary class="cursor-pointer font-heading font-semibold text-navy">{faq.question}</summary>
            <p class="mt-4 text-gray-700 leading-relaxed">
              {faq.question === 'What does Amazon charge per click?' ? (
                <>It varies by category and by how many sellers bid on the same terms. Our <a href="/blog/amazon-ads-cost-uk/" class="text-electric underline hover:text-electric-dark">Amazon Ads cost guide</a> for UK sellers lists the typical ranges for each ad type.</>
              ) : faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">See what each product earns after ads</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit of your Amazon account. We show you the profit per product and where spend is leaking.</p>
      <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
    </div>
  </section>

</Layout>
