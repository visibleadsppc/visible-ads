---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    question: 'What does an Amazon PPC agency do?',
    answer: 'It runs your Amazon advertising for you. That covers building the campaigns, setting bids and budgets and reporting the result.',
  },
  {
    question: 'Which Amazon ad types do you manage?',
    answer: 'Sponsored Products, Sponsored Brands and Sponsored Display. We run all three.',
  },
  {
    question: 'Why do you look at unit profit and not only ACoS?',
    answer: 'ACoS compares ad spend with ad sales. It does not know what the product cost or what Amazon charged in fees. Profit per unit does. It shows whether a sale made money.',
  },
  {
    question: 'How do you decide how much budget to put behind a campaign?',
    answer: 'We review ROAS every week and follow a fixed ladder. Budget goes up where the return is strong and comes down where it is weak.',
  },
  {
    question: 'Which Amazon marketplaces do you work in?',
    answer: 'We work with sellers in the UK, US and Europe. Tell us where you sell when you book the audit.',
  },
  {
    question: 'Are you an Amazon advertising consultant or a full agency?',
    answer: 'We are a full Amazon ads agency. We manage the account every week. If you only want a one-off review, start with the free audit.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Amazon PPC Management',
      serviceType: 'Amazon PPC management',
      provider: { '@type': 'Organization', name: 'Visible Ads', url: 'https://visible-ads.com' },
      description: 'Amazon PPC management for ecommerce brands: Sponsored Products, Sponsored Brands and Sponsored Display campaigns run against unit profit.',
      url: 'https://visible-ads.com/amazon/',
      areaServed: ['GB', 'US', 'EU'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://visible-ads.com/' },
        { '@type': 'ListItem', position: 2, name: 'Amazon PPC Agency', item: 'https://visible-ads.com/amazon/' },
      ],
    },
  ],
};

const adTypes = [
  { title: 'Sponsored Products', text: 'Ads for single products that show in search results and on product pages.' },
  { title: 'Sponsored Brands', text: 'Ads that put your brand and several products at the top of search results.' },
  { title: 'Sponsored Display', text: 'Ads that reach shoppers by audience, product or category targeting. That includes people who viewed your products and did not buy.' },
];

const measures = [
  { measure: 'ACoS', how: 'Ad spend divided by ad sales', shows: 'Ad cost as a share of ad sales' },
  { measure: 'ROAS', how: 'Ad sales divided by ad spend', shows: 'How much each pound of spend returned' },
  { measure: 'Profit per unit', how: 'Price minus product cost, Amazon fees and ad spend', shows: 'Whether a sale made money' },
];

const ladder = [
  { roas: 'Above 1,200%', action: 'Raise the budget by 20% a week' },
  { roas: '900% to 1,100%', action: 'Raise the budget by 10% a week' },
  { roas: '600% to 800%', action: 'Hold the budget' },
  { roas: '300% to 500%', action: 'Cut the budget by 20%' },
  { roas: 'Below 300%', action: 'Switch the spend off' },
];
---

<Layout title="Amazon PPC Agency | Amazon Ads Management | Visible Ads" description="Amazon PPC agency for ecommerce brands. We manage Sponsored Products, Brands and Display against unit profit." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-light mb-8"><a href="/" class="hover:text-white">Home</a><span class="mx-2">/</span><span class="text-white">Amazon PPC Agency</span></nav>
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Amazon Ads Verified Partner</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Amazon PPC Agency for Ecommerce Brands</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">We run your Sponsored Products, Sponsored Brands and Sponsored Display campaigns with profit as the goal and weekly ROAS rules to steer budget.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
          <a href="#profit" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">How we measure profit</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What we manage -->
  <section class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What our Amazon ads management covers</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">Visible Ads is an Amazon advertising agency. Our Amazon PPC management covers three ad types.</p>
      <dl class="space-y-6 text-lg text-gray-700 leading-relaxed">
        {adTypes.map((a) => (
          <div>
            <dt class="font-heading font-bold text-navy">{a.title}</dt>
            <dd>{a.text}</dd>
          </div>
        ))}
      </dl>
      <p class="text-lg text-gray-700 mt-8 leading-relaxed">For what Amazon itself charges per click, read our <a href="/blog/amazon-ads-cost-uk/" class="text-electric underline hover:text-electric-dark">Amazon Ads cost guide</a> for UK sellers.</p>
    </div>
  </section>

  <!-- Unit profit -->
  <section id="profit" class="py-20 lg:py-24 bg-sky-tint" data-animate>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Unit profit comes before ACoS</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">A campaign can show a healthy ACoS and still lose money on every sale. Profit per unit shows whether a sale made money.</p>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">Here's a simple example. Assume a £20 product that costs £8 to buy and £4 in Amazon fees. That leaves £8 before ads. That is 40% of the price. It breaks even at a 40% ACoS. At 25% the ad costs £5 and each sale keeps £3. At 45% the ad costs £9 and each sale loses £1. All prices are before VAT.</p>
      </div>
      <p class="text-sm text-gray-700 mb-2 md:hidden">Swipe sideways to see every column.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white" tabindex="0" role="region" aria-label="Amazon advertising measures, scrolls sideways on small screens">
        <table class="w-full min-w-[600px] text-left text-base">
          <caption class="sr-only">Measures used on Amazon accounts</caption>
          <thead class="bg-navy text-white"><tr><th scope="col" class="p-4">Measure</th><th scope="col" class="p-4">How it is worked out</th><th scope="col" class="p-4">What it shows</th></tr></thead>
          <tbody class="text-gray-700">
            {measures.map((m, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th scope="row" class="p-4 font-semibold text-navy align-top">{m.measure}</th><td class="p-4 align-top">{m.how}</td><td class="p-4 align-top">{m.shows}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-lg text-gray-700 mt-8 max-w-3xl leading-relaxed">Our <a href="/roas-vs-profit/" class="text-electric underline hover:text-electric-dark">ROAS vs profit calculator</a> shows the break-even point for your own margin.</p>
    </div>
  </section>

  <!-- Budget ladder -->
  <section id="process" class="py-20 lg:py-24 bg-white" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">How we scale or cut Amazon spend</h2>
      <p class="text-lg text-gray-700 mb-8 leading-relaxed">We review ROAS every week and move each budget on a fixed ladder. Profit is the goal and ROAS is the weekly control. The ladder below is the one we follow.</p>
      <div class="overflow-x-auto rounded-2xl border border-gray-200" tabindex="0" role="region" aria-label="Weekly budget ladder, scrolls sideways on small screens">
        <table class="w-full min-w-[320px] text-left text-base">
          <caption class="sr-only">Weekly budget rules by return on ad spend</caption>
          <thead class="bg-navy text-white"><tr><th scope="col" class="p-4">Weekly ROAS</th><th scope="col" class="p-4">What we do</th></tr></thead>
          <tbody class="text-gray-700">
            {ladder.map((r, i) => (
              <tr class={i % 2 ? 'border-t bg-sky-tint/40' : 'border-t'}><th scope="row" class="p-4 font-semibold text-navy">{r.roas}</th><td class="p-4">{r.action}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Reporting -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">What you see from us each week and quarter</h2>
      <p class="text-lg text-gray-700 leading-relaxed">You get a weekly call or video update on the Amazon account. You also get a KPI dashboard. Once a quarter we hold a review.</p>
    </div>
  </section>

  <!-- Proof -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">Proof from an Amazon account we have managed</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">This is the all-time record for one Amazon Ads account we have managed.</p>
      <div class="bg-sky-tint rounded-2xl p-6 sm:p-8 border border-gray-100">
        <p class="text-lg text-navy font-semibold mb-6">CFW Amazon Ads, all time</p>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div><dt class="text-sm text-gray-700">Ad spend</dt><dd class="text-2xl font-heading font-extrabold text-electric">£91,902.91</dd></div>
          <div><dt class="text-sm text-gray-700">Sales</dt><dd class="text-2xl font-heading font-extrabold text-electric">£769,025.79</dd></div>
          <div><dt class="text-sm text-gray-700">Purchases</dt><dd class="text-2xl font-heading font-extrabold text-electric">17,566</dd></div>
        </dl>
      </div>
      <p class="text-lg text-gray-700 mt-6 leading-relaxed">We manage £3M of annual ad spend. Visible Ads won at the UK Search Awards 2022 and was a finalist at the UK Search Awards 2024, the UK eCommerce Awards 2024 and the National Digital Awards 2026.</p>
      <p class="text-gray-700 mt-6 leading-relaxed">The <a href="/case-studies/cfw/" class="text-electric underline hover:text-electric-dark">CFW case study</a> covers the wider account.</p>
    </div>
  </section>

  <!-- Who it suits -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-6">Who our Amazon management suits</h2>
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">It suits ecommerce brands that sell on Amazon and know what each product costs them. Most of our clients are direct to consumer and business brands with £1M to £20M in annual revenue.</p>
      <p class="text-lg text-gray-700 leading-relaxed">If you also sell on your own site, we plan the two together. Read about <a href="/amazon-google-ads/" class="text-electric underline hover:text-electric-dark">Amazon and Google Ads together</a> to see how.</p>
    </div>
  </section>

  <!-- Fees -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-6">What our Amazon management fee covers</h2>
      <p class="text-lg text-gray-700 mb-4 leading-relaxed">Our fee is per channel plus VAT, and it covers as many campaigns as you need. Your ad budget goes straight to Amazon. After the first three months you can stop any time with 30 days' notice.</p>
      <p class="text-lg text-gray-700 leading-relaxed">The Silver, Gold and Platinum tiers are set out in our <a href="/ppc-management/#pricing" class="text-electric underline hover:text-electric-dark">PPC management pricing</a> section.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-sky-tint" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Amazon PPC questions</h2>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-white border border-gray-200 rounded-xl p-6">
            <summary class="cursor-pointer font-heading font-semibold text-navy">{faq.question}</summary>
            <p class="mt-4 text-gray-700 leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 bg-navy" data-animate>
    <div class="absolute inset-0 dot-pattern opacity-5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-heading font-bold text-white mb-6">See what each product earns after ads</h2>
      <p class="text-lg text-slate-light mb-8 max-w-2xl mx-auto">Get a free audit of your Amazon account. It shows where spend is earning and where it is leaking.</p>
      <a href="/free-ads-audit/" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-10 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Book a free profit audit</a>
    </div>
  </section>

</Layout>
