---
import Layout from '../layouts/Layout.astro';
import CountUp from '../components/CountUp.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Visible Ads, London PPC Agency",
      "description": "Boutique PPC agency serving London businesses from Kingston-Upon-Thames. Google Partner delivering enterprise-level Google Ads, paid search, and multi-channel campaigns with personal service.",
      "url": "https://visible-ads.com/ppc-london",
      "telephone": "+447810477679",
      "email": "Boh@Visible-Ads.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kingston-Upon-Thames",
        "addressRegion": "Surrey",
        "addressCountry": "GB"
      },
      "areaServed": [
        { "@type": "City", "name": "London" },
        { "@type": "City", "name": "Kingston upon Thames" },
        { "@type": "AdministrativeArea", "name": "Greater London" },
        { "@type": "AdministrativeArea", "name": "Surrey" }
      ],
      "priceRange": "$$$$",
      "knowsAbout": ["PPC Management", "Google Ads", "Paid Search", "Bing Ads", "Amazon Advertising", "SEO", "Paid Social", "Conversion Rate Optimisation"]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "PPC London", "item": "https://visible-ads.com/ppc-london" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does a PPC agency in London charge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "London PPC agencies typically charge between £1,500 and £10,000 per month in management fees, depending on campaign complexity and ad spend levels. Large agencies in the West End or City often charge at the higher end due to overheads. Visible Ads offers enterprise-level expertise at boutique rates, our management fees range from £1,500 to £5,000 per month, with transparent pricing and no long-term lock-in contracts."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose a boutique PPC agency over a large London agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Large London agencies spread senior talent across dozens of accounts and frequently hand day-to-day management to juniors. At Visible Ads, your campaigns are managed directly by senior strategists with over 20 years of experience. You get faster response times, more strategic attention, and none of the overhead costs that big agencies pass on to clients. Our Google Partner status and £3M in annual ad spend managed prove that boutique does not mean small results."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer face-to-face meetings with London clients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely. We are based in Kingston-Upon-Thames, which is a 25-minute train ride from London Waterloo. We regularly meet clients across Central London, the City, and South West London. We also offer video calls for quick check-ins and monthly performance reviews. You will never feel like you are working with a remote agency."
          }
        },
        {
          "@type": "Question",
          "name": "What types of London businesses do you work with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We specialise in established businesses generating £1M or more in annual revenue, including professional services firms, eCommerce brands, B2B companies, SaaS providers, and multi-location businesses across Greater London. If you are investing at least £2,000 per month in ad spend and want expert management to maximise your return, we are an excellent fit."
          }
        }
      ]
    }
  ]
};
---

<Layout title="PPC Agency London | Google Ads Management | Visible Ads" description="London's boutique PPC agency: enterprise results, personal service, and a Google Partner managing £3M+ in annual ad spend across paid search." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">London PPC Agency</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">London's Boutique PPC Agency, Enterprise Results, Personal Service</h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">Visible Ads is a Google Partner agency that delivers the strategic firepower of a large London PPC firm with the responsiveness and accountability of a dedicated team. Based just outside London in Kingston-Upon-Thames, we manage profitable Google Ads, paid search, and multi-channel campaigns for ambitious businesses across the capital.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Ads Audit</a>
          <a href="#services" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- Serving London from Kingston -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Serving London Businesses from Kingston-Upon-Thames</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">London is the most competitive digital advertising market in the United Kingdom. Whether you are running Google Ads for a professional services firm in the City, managing Shopping campaigns for a Shoreditch eCommerce brand, or scaling paid social for a SaaS company in King's Cross, getting PPC right in London is the difference between profitable growth and wasted budget.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Visible Ads operates from <a href="/kingston-upon-thames" class="text-electric underline hover:text-electric-dark">Kingston-Upon-Thames</a>, just 25 minutes from London Waterloo by train. This gives our clients the best of both worlds: a senior team with deep experience managing high-spend campaigns across every London sector, without the inflated overheads that Central London agencies bake into their fees. Those savings go directly into your campaigns, not into a Mayfair office lease.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We have managed paid search campaigns for London businesses across financial services, legal, healthcare, technology, retail, and professional services. Our clients choose us because they have been through the big agency cycle, impressive pitch decks followed by junior account managers who barely understand their market, and want something fundamentally different. They want senior strategists who pick up the phone, who know their account inside out, and who treat every pound of ad spend as if it were their own.</p>
        <p class="text-lg text-gray-700 leading-relaxed">That is exactly what we deliver. No layers of account directors between you and the people managing your campaigns. No templated strategies. No dashboards masking poor performance. Just transparent, expert PPC management focused entirely on your commercial outcomes.</p>
      </div>
    </div>
  </section>

  <!-- Why Boutique Over Big Agency -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Why London Businesses Choose Boutique Over Big Agencies</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">The London PPC market is saturated with agencies. From global holding company networks charging eye-watering retainers to freelancers undercutting on price, the range of options can be paralysing. But the businesses we work with have learned, often the hard way, that the most important factor is not agency size. It is who actually manages your campaigns day to day.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">At a large London agency, the people in your pitch meeting rarely touch your account again. Your campaigns are handed to an executive with 18 months of experience and a portfolio of 15 other clients competing for their attention. Performance reviews become exercises in spin, and strategic recommendations get filtered through layers of management before reaching you.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">At Visible Ads, we have deliberately built a different model. Our senior strategists, each with over a decade of hands-on PPC experience, manage accounts directly. When market conditions shift, we react in hours, not weeks. When you have a question, you get a direct answer from the person who made the last optimisation to your campaigns, not a client services coordinator reading from notes.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10">
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <h3 class="font-heading font-bold text-navy mb-3">Senior-Led Management</h3>
            <p class="text-gray-700 text-sm leading-relaxed">Your campaigns are managed by strategists with 20+ years of experience, not delegated to juniors after the pitch.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <h3 class="font-heading font-bold text-navy mb-3">No Inflated Overheads</h3>
            <p class="text-gray-700 text-sm leading-relaxed">Without a Central London office lease, you get enterprise expertise at a fraction of West End agency rates.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <h3 class="font-heading font-bold text-navy mb-3">Faster Response Times</h3>
            <p class="text-gray-700 text-sm leading-relaxed">Direct access to your strategist means optimisations happen in hours, not after a chain of internal approvals.</p>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
            <h3 class="font-heading font-bold text-navy mb-3">Transparent Reporting</h3>
            <p class="text-gray-700 text-sm leading-relaxed">No vanity metrics or spin. Every report ties directly to revenue, ROAS, and the commercial outcomes that matter.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section id="services" class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">PPC & Digital Marketing Services for London Businesses</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">A full suite of performance marketing services engineered for London's most competitive sectors.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/google-ads" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Google Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Search, Shopping, Performance Max, and remarketing campaigns engineered for profitable growth in London's competitive auctions.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/bing-ads" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Bing Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Reach high-value London professionals on Microsoft's search network with typically lower cost-per-click than Google.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/seo" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">SEO Services</h3>
          <p class="text-gray-700 text-sm mb-3">Sustainable organic growth through technical SEO, content strategy, and authority building for London businesses.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/paid-social" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.7 48.7 0 0 0 5.232-.537c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.4 48.4 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Paid Social Advertising</h3>
          <p class="text-gray-700 text-sm mb-3">Creative-led campaigns on Meta, TikTok, and LinkedIn targeting London's most valuable audiences.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/amazon" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Amazon Ads & Marketplace</h3>
          <p class="text-gray-700 text-sm mb-3">Sponsored Products, Brands, and DSP campaigns that drive marketplace dominance for London-based sellers.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/ecro" class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-200 hover:shadow-lg hover:border-electric/20 transition-all duration-300">
          <div class="w-14 h-14 rounded-xl bg-electric/10 flex items-center justify-center mb-6 group-hover:bg-electric/20 transition-colors">
            <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"/></svg>
          </div>
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Conversion Rate Optimisation</h3>
          <p class="text-gray-700 text-sm mb-3">Turn more of your London traffic into customers through data-driven A/B testing and UX improvements.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="relative bg-gradient-to-b from-electric/5 to-transparent" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="text-center mb-10">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold text-navy">Results at a Glance</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <CountUp value="20" suffix="+" label="Years Experience" />
        <CountUp value="50" suffix="+" label="Businesses Scaled" />
        <CountUp value="3" prefix="£" suffix="M+" label="Annual Ad Spend Managed" />
        <CountUp value="97" suffix="%" label="Client Retention" />
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">Proven Results for London & South East Businesses</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">See how we have helped businesses achieve profitable growth through strategic PPC management.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="1165" suffix="%" label="ROAS" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">CFW</h3>
          <p class="text-gray-700 text-sm leading-relaxed mb-1">Google Ads</p>
          <p class="text-gray-700 font-medium mb-6">From stagnation to 7-figure revenue</p>
          <a href="/case-studies/cfw" class="text-electric font-semibold text-sm hover:underline">Read Case Study &rarr;</a>
        </div>
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="450" prefix="+" suffix="%" label="Sales Growth" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">iWholesales</h3>
          <p class="text-gray-700 text-sm leading-relaxed mb-1">Airsoft Division</p>
          <p class="text-gray-700 font-medium mb-6">Supercharged online presence</p>
          <a href="/case-studies/iwholesales" class="text-electric font-semibold text-sm hover:underline">Read Case Study &rarr;</a>
        </div>
        <div class="glass-card p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
          <CountUp value="2.31" prefix="£" suffix="M" label="Ad-Driven Revenue" />
          <h3 class="font-heading text-xl font-bold text-navy mt-4 mb-3">Sephra Europe</h3>
          <p class="text-gray-700 text-sm leading-relaxed mb-1">Multi-channel Growth</p>
          <p class="text-gray-700 font-medium mb-6">Exceptional business growth</p>
          <a href="/case-studies/sephra" class="text-electric font-semibold text-sm hover:underline">Read Case Study &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- London Market Expertise -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-8">Deep Expertise in London's Most Competitive Sectors</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">London's PPC landscape is unlike anywhere else in the UK. Cost-per-click rates for competitive terms in financial services, legal, and technology regularly exceed £30-50, and the difference between a profitable campaign and a money pit often comes down to the granularity of your targeting, the quality of your ad copy, and how intelligently your bidding strategy responds to London's unique search patterns.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We have managed campaigns across every major London sector, from City law firms competing for high-value commercial litigation queries, to Canary Wharf fintech companies scaling B2B lead generation, to Hackney DTC brands driving profitable customer acquisition through Shopping and Performance Max. Each sector has its own dynamics, and we bring sector-specific knowledge that generalist agencies simply cannot match.</p>
