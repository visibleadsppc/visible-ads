---
import Layout from '../layouts/Layout.astro';
import CountUp from '../components/CountUp.astro';
import GrowthChart from '../components/GrowthChart.astro';
import ClientLogos from '../components/ClientLogos.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import AdsWizard from '../components/AdsWizard.astro';
import StatsTicker from '../components/StatsTicker.astro';
import Edit from '../components/Edit.astro';
import EditImg from '../components/EditImg.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://visible-ads.com/#organization",
      "name": "Visible Ads",
      "url": "https://visible-ads.com",
      "description": "Digital advertising agency delivering measurable ROI through Google, Meta, Amazon, and Bing campaigns for businesses generating £1M+ revenue.",
      "knowsAbout": ["Google Ads", "Bing Ads", "Amazon Advertising", "SEO", "Paid Social", "Conversion Rate Optimisation"],
      "sameAs": ["https://www.linkedin.com/company/visibleads/", "https://www.google.com/maps/place/Visible+Ads/data=!4m2!3m1!1s0x0:0xc19421e998217581"],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "8",
        "reviewCount": "8"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kingston-Upon-Thames",
        "addressRegion": "Surrey",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 51.4123,
        "longitude": -0.3007
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "email": "Boh@Visible-Ads.com",
      "telephone": "+447810477679"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What size businesses do you work with?", "acceptedAnswer": { "@type": "Answer", "text": "We partner with businesses generating £1M+ in annual revenue who are serious about scaling their digital advertising profitably." } },
        { "@type": "Question", "name": "What results can I expect?", "acceptedAnswer": { "@type": "Answer", "text": "Results depend on your market and starting position." } },
        { "@type": "Question", "name": "How long before I see results?", "acceptedAnswer": { "@type": "Answer", "text": "Most clients see meaningful improvements within 3-6 months, with quick wins often appearing in the first 30 days as we optimise existing campaigns." } },
        { "@type": "Question", "name": "Which platforms do you specialise in?", "acceptedAnswer": { "@type": "Answer", "text": "We are certified partners of Google, Microsoft, Amazon, and Meta. Our core strength is Google Ads, supported by Bing Ads, SEO, paid social, Amazon advertising, and conversion rate optimisation." } },
        { "@type": "Question", "name": "Do you offer a free audit?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We provide a comprehensive, no-obligation audit of your current advertising setup with actionable recommendations, whether or not you choose to work with us." } }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://visible-ads.com/#website",
      "name": "Visible Ads",
      "url": "https://visible-ads.com",
      "publisher": { "@id": "https://visible-ads.com/#organization" }
    }
  ]
};
---

<Layout
  title="Google Ads Agency London | Profit-First PPC | Visible Ads"
  description="Unlock sales growth with advertising that converts. Visible Ads delivers measurable ROI through Google, Bing, Meta, and Amazon campaigns for £1M+ businesses."
  schema={schema}
>

<section class="relative overflow-hidden bg-white dot-pattern" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy leading-tight tracking-tight">
          <Edit key="hero.heading">Making Ecom Ads <span class="gradient-text">Profitable</span></Edit>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate leading-relaxed max-w-xl">
          <Edit key="hero.subtitle">We run full-funnel, multi-channel campaigns across Google, Meta, Amazon, and Bing. We build them for D2C and B2B ecommerce brands. Profit is the goal; ROAS is the lever we manage against our published scaling rulebook.</Edit>
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="inline-flex items-center justify-center px-8 py-4 bg-cta hover:bg-electric text-white font-heading font-bold text-lg rounded-xl shadow-lg shadow-cta/25 transition-all duration-300 hover:shadow-xl hover:shadow-electric/25 hover:-translate-y-0.5 w-full sm:w-auto">
            Get My Free Ads Audit
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
          </a>
          <a href="/case-studies" class="inline-flex items-center justify-center px-8 py-4 text-electric font-heading font-bold text-lg rounded-xl border-2 border-electric/20 hover:border-electric/40 hover:bg-sky-tint transition-all duration-300 w-full sm:w-auto">
            See Our Results
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="absolute -inset-4 bg-gradient-to-br from-electric/20 to-cyan-400/20 rounded-3xl blur-2xl"></div>
        <div class="gradient-border p-1.5 relative">
          <EditImg key="hero.image" src="/images/boh-and-joe.webp" alt="Boh Tjarks, founder, and Joe, Digital Marketing Manager at Visible Ads" class="w-full rounded-[0.85rem] shadow-2xl" />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-sky-tint" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="text-center mb-14">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-navy">Sound Familiar?</h2>
      <p class="mt-4 text-lg text-slate max-w-2xl mx-auto">Every growth-focused business faces these challenges. We solve them with data-driven advertising.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <a href="/google-ads" class="group bg-white rounded-2xl p-8 shadow-md border border-gray-100 border-t-4 border-electric transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl">
        <div class="w-14 h-14 rounded-xl bg-electric/15 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-electric" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.281m5.94 2.28-2.28 5.941"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-3">How do I sell more profitably?</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Cut wasted ad spend and maximise return from every click with campaigns engineered for profit, not vanity metrics.</p>
        <span class="text-electric font-semibold text-sm underline underline-offset-2">Learn More &rarr;</span>
      </a>

      <a href="/bing-ads" class="group bg-white rounded-2xl p-8 shadow-md border border-gray-100 border-t-4 border-emerald-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl">
        <div class="w-14 h-14 rounded-xl bg-emerald-500/15 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 0 1-.982-3.172M9.497 14.25a7.454 7.454 0 0 0 .981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 0 0 7.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M18.75 4.236c.982.143 1.954.317 2.916.52A6.003 6.003 0 0 1 16.27 9.728M18.75 4.236V4.5c0 2.108-.966 3.99-2.48 5.228m4.294-1.443A18.04 18.04 0 0 1 16.27 9.728M6.593 12.456c-.593-.222-1.15-.48-1.669-.768m-1.674-.94c.556.222 1.138.414 1.674.58m1.669-.768a18.04 18.04 0 0 0 4.283 1.394m-4.283-1.394a18.135 18.135 0 0 1-1.669-.768"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-3">How do I beat my competition?</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Outmanoeuvre rivals with competitor analysis, auction insights, and strategies that win the clicks that matter most.</p>
        <span class="text-emerald-600 font-semibold text-sm underline underline-offset-2">Learn More &rarr;</span>
      </a>
      <a href="/paid-social" class="group bg-white rounded-2xl p-8 shadow-md border border-gray-100 border-t-4 border-amber-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl">
        <div class="w-14 h-14 rounded-xl bg-amber-500/15 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-3">How do I increase market share?</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Dominate your category with strategic bidding, audience targeting, and multi-platform coverage that captures demand competitors miss.</p>
        <span class="text-amber-600 font-semibold text-sm underline underline-offset-2">Learn More &rarr;</span>
      </a>
      <a href="/free-ads-audit" class="group bg-white rounded-2xl p-8 shadow-md border border-gray-100 border-t-4 border-purple-600 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl">
        <div class="w-14 h-14 rounded-xl bg-purple-500/15 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-3">Am I maximising the opportunity?</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Uncover hidden revenue with a thorough audit of your campaigns, landing pages, and conversion funnels.</p>
        <span class="text-purple-600 font-semibold text-sm underline underline-offset-2">Learn More &rarr;</span>
      </a>
    </div>
  </div>
</section>

<section class="bg-white py-16 lg:py-20" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <PartnerBadges />
  </div>
</section>

<StatsTicker />

<div class="h-px bg-gradient-to-r from-transparent via-electric/20 to-transparent"></div>

<section class="relative bg-gradient-to-b from-electric/5 to-transparent" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="text-center mb-10">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-navy">Results At a Glance</h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      <CountUp value="50" suffix="+" label="Years Combined Experience" />
      <CountUp value="32" label="Businesses Scaled" />
      <CountUp prefix="£" value="25" suffix="M+" label="Revenue Generated" />
      <CountUp value="900" suffix="%+" label="Average ROAS" />
    </div>
  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-electric/20 to-transparent"></div>

<section class="bg-white" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="text-center mb-14">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-navy">Growth Services That Drive Revenue</h2>
      <p class="mt-4 text-lg text-slate max-w-2xl mx-auto">We take a full-funnel, multi-channel approach to paid advertising. Profit is the goal. ROAS guides budget decisions through our <a href="/how-we-audit/" class="text-electric underline hover:text-electric-dark">published scaling rulebook</a>.</p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/google-ads" class="group sm:col-span-2 lg:col-span-3 flex flex-col sm:flex-row sm:items-center gap-6 p-8 rounded-2xl bg-gradient-to-br from-navy to-navy-light shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ring-1 ring-electric/30">
        <div class="w-16 h-16 rounded-2xl bg-electric flex items-center justify-center shrink-0 shadow-lg shadow-electric/30">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
        </div>
        <div class="flex-1">
          <span class="inline-block px-3 py-1 bg-electric/20 text-electric-light text-xs font-semibold rounded-full mb-2">Flagship Service</span>
          <h3 class="font-heading text-xl font-bold text-white mb-2">Google Ads</h3>
          <p class="text-slate-light leading-relaxed">Our flagship service. From Search and Shopping to Performance Max and YouTube, we build, manage, and scale Google Ads campaigns that deliver consistent, profitable growth.</p>
        </div>
        <svg class="w-6 h-6 text-electric-light shrink-0 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
      </a>
      <a href="/paid-social" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-2 border-pink-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
        <div class="w-14 h-14 rounded-xl bg-pink-500/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-pink-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 0 1 1.037-.443 48.7 48.7 0 0 0 5.232-.537c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.4 48.4 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-2">Paid Social</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Reach new audiences and retarget buyers with campaigns across Meta, LinkedIn, and TikTok.</p>
        <span class="text-pink-600 font-semibold text-sm group-hover:underline">Explore &rarr;</span>
      </a>
      <a href="/bing-ads" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-2 border-cyan-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
        <div class="w-14 h-14 rounded-xl bg-cyan-500/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-cyan-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-2">Bing Ads</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Tap into lower-cost clicks and high-intent audiences on Microsoft's search network.</p>
        <span class="text-cyan-600 font-semibold text-sm group-hover:underline">Explore &rarr;</span>
      </a>
      <a href="/amazon" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-2 border-amber-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
        <div class="w-14 h-14 rounded-xl bg-amber-500/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349M3.75 21V9.349m0 0a3.001 3.001 0 0 0 3.75-.615A2.993 2.993 0 0 0 9.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 0 0 2.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 0 0 3.75.614m-16.5 0a3.004 3.004 0 0 1-.621-4.72l1.189-1.19A1.5 1.5 0 0 1 5.378 3h13.243a1.5 1.5 0 0 1 1.06.44l1.19 1.189a3 3 0 0 1-.621 4.72M6.75 18h3.75a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-.75-.75H6.75a.75.75 0 0 0-.75.75v3.75c0 .414.336.75.75.75Z"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-2">Amazon</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Sponsored Products, Brands, and DSP campaigns that drive marketplace dominance and profitability.</p>
        <span class="text-amber-600 font-semibold text-sm group-hover:underline">Explore &rarr;</span>
      </a>
      <a href="/ecro" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-2 border-emerald-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
        <div class="w-14 h-14 rounded-xl bg-emerald-500/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 1 0 7.5 7.5h-7.5V6Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0 0 13.5 3v7.5Z"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-2">eCRO</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Turn more visitors into customers with data-led conversion rate optimisation and landing page testing.</p>
        <span class="text-emerald-600 font-semibold text-sm group-hover:underline">Explore &rarr;</span>
      </a>
      <a href="/seo" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 border-t-2 border-purple-500 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-electric/20">
        <div class="w-14 h-14 rounded-xl bg-purple-500/10 flex items-center justify-center mb-6">
          <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-navy mb-2">SEO</h3>
        <p class="text-slate text-sm leading-relaxed mb-4">Sustainable organic growth through technical SEO, content strategy, and authority building.</p>
        <span class="text-purple-600 font-semibold text-sm group-hover:underline">Explore &rarr;</span>
      </a>
    </div>
  </div>
</section>

<div class="h-px bg-gradient-to-r from-transparent via-electric/20 to-transparent"></div>

<section class="bg-gray-50" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="text-center mb-16">
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-navy">The Visible Ads Blueprint</h2>
      <p class="mt-4 text-lg text-slate max-w-2xl mx-auto">A proven, four-phase methodology that turns ad spend into predictable, scalable revenue.</p>
    </div>
    <div class="relative">
      <div class="hidden lg:block absolute top-10 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-electric via-electric-light to-electric"></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
        <div class="text-center relative">
          <div class="w-20 h-20 rounded-full bg-electric text-white flex items-center justify-center text-2xl font-heading font-extrabold mx-auto relative z-10 shadow-lg shadow-electric/30">1</div>
          <h3 class="font-heading text-xl font-bold text-navy mt-6 mb-3">Discover</h3>
          <p class="text-slate text-sm leading-relaxed">Deep-dive audit of your accounts, competitors, market, and growth opportunities.</p>
        </div>
