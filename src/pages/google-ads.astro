---
import Layout from '../layouts/Layout.astro';
import GrowthChart from '../components/GrowthChart.astro';
import PartnerBadges from '../components/PartnerBadges.astro';
import ClientLogos from '../components/ClientLogos.astro';
import PpcFunnel from '../components/PpcFunnel.astro';
import IndustryBenchmarks from '../components/IndustryBenchmarks.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Google Ads Management",
      "provider": {
        "@type": "Organization",
        "name": "Visible Ads",
        "url": "https://visible-ads.com"
      },
      "description": "Award-winning Google Ads management. Google Partner agency delivering 20-40% annual growth through strategic PPC campaigns.",
      "url": "https://visible-ads.com/google-ads",
      "serviceType": "PPC Management",
      "areaServed": "GB"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does Google Ads management cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "These tiers apply per channel managed. SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo); GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo); PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection); PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated. All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly will I see results from Google Ads?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can see initial traffic within 24 hours of launching campaigns. However, meaningful performance optimisation typically takes 4-8 weeks as we gather conversion data, refine audiences, and test ad copy. Most clients see strong month-on-month improvement from month two onwards."
          }
        },
        {
          "@type": "Question",
          "name": "What are the benefits of working with a Google Partner agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As a Google Partner, we have direct access to Google support, beta features, and advanced training. We meet Google's strict performance requirements for client growth and retention. This means you benefit from insider knowledge and early access to new ad formats before your competitors."
          }
        },
        {
          "@type": "Question",
          "name": "How often do you report on campaign performance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide comprehensive monthly reports with full transparency on spend, conversions, ROAS, and strategic recommendations. You also get access to a live dashboard for real-time performance monitoring, and we schedule monthly strategy calls to review results and plan next steps."
          }
        },
        {
          "@type": "Question",
          "name": "Are we locked into a long-term contract?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We work on rolling monthly agreements after an initial 3-month onboarding period. The first three months allow us to properly audit, restructure, and optimise your account. After that, you stay because of results, not contracts."
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://visible-ads.com/" },
        { "@type": "ListItem", "position": 2, "name": "Google Ads", "item": "https://visible-ads.com/google-ads" }
      ]
    }
  ]
};
---

<Layout title="Google Ads Agency | PPC Management | Visible Ads" description="Award-winning Google Ads management. Google Partner agency delivering 20-40% annual growth through strategic PPC campaigns." schema={schema}>

  <!-- Hero -->
  <section class="relative py-20 lg:py-28 overflow-hidden bg-navy" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-navy to-navy-light"></div>
    <div class="absolute inset-0 dot-pattern opacity-10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1.5 bg-electric/20 text-electric-light text-sm font-medium rounded-full mb-6">Google Partner Agency</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white leading-tight mb-6">Google Ads Management That Drives <span class="gradient-text">Profitable Growth</span></h1>
        <p class="text-lg sm:text-xl text-slate-light mb-8 leading-relaxed">We manage Google Ads campaigns for ambitious businesses that want more than clicks, they want revenue. From Search and Shopping to Performance Max and remarketing, we build campaigns engineered for profitable growth.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/free-ads-audit" class="w-full sm:w-auto inline-flex items-center justify-center bg-cta text-white font-semibold px-8 py-4 rounded-xl hover:bg-electric transition-colors text-lg">Get Your Free Google Ads Audit</a>
          <a href="#approach" class="w-full sm:w-auto inline-flex items-center justify-center text-white font-medium px-8 py-4 rounded-xl border border-white/20 hover:bg-white/10 transition-colors">See Our Approach</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Partner Badges -->
  <section class="py-12 bg-sky-tint border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerBadges compact />
    </div>
  </section>

  <!-- What We Do -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-8">What We Do</h2>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">We manage every aspect of your Google Ads account, from campaign architecture and keyword strategy to bid management and conversion tracking. Whether you're running Search campaigns to capture high-intent traffic, Shopping campaigns to showcase your products, or Performance Max campaigns to reach customers across Google's entire network, we build and optimise campaigns that deliver measurable return on ad spend.</p>
        <p class="text-lg text-gray-700 mb-6 leading-relaxed">Our team specialises in eCommerce and lead generation accounts where every pound of spend must justify its place. We don't set and forget. Every week, we analyse search term reports, adjust bids, test new ad copy, refine audiences, and eliminate waste. This hands-on management is what separates agencies that deliver 20-40% annual growth from those that simply keep the lights on.</p>
        <p class="text-lg text-gray-700 leading-relaxed">We work across the full Google Ads ecosystem: Search, Shopping, Display, Video, Discovery, and Performance Max. For clients with existing remarketing lists, we build sophisticated retargeting sequences that bring warm prospects back at exactly the right moment. For those starting fresh, we build the foundation properly from day one, structured campaigns, accurate tracking, and a clear measurement framework so you always know what's working. Many clients also pair Google Ads with our <a href="/bing-ads" class="text-electric underline hover:text-electric-dark">Bing Ads management</a> to capture additional market share at lower CPCs, or add <a href="/ecro" class="text-electric underline hover:text-electric-dark">conversion rate optimisation</a> to squeeze more revenue from every click.</p>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Our Approach</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">A proven four-phase process that turns ad spend into predictable revenue.</p>
        <p class="text-lg text-gray-700 mt-6 leading-relaxed">For the questions to ask when comparing management partners, read our guide to <a href="/choosing-a-google-ads-agency/" class="text-electric underline hover:text-electric-dark">choosing a Google Ads agency</a>.</p>
      </div>
      <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="hidden lg:block absolute top-10 left-[calc(12.5%+24px)] right-[calc(12.5%+24px)] h-0.5 bg-electric/20"></div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">1</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Audit & Discovery</h3>
          <p class="text-gray-700">We tear down your existing account structure, analyse historical performance, review conversion tracking, and identify every pound of wasted spend. Nothing launches until we understand the full picture.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">2</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Strategy & Structure</h3>
          <p class="text-gray-700">We build a campaign architecture designed around your business goals, not Google's defaults. Keyword grouping, match types, bid strategies, and audience layering are all planned before a single ad goes live.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">3</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Launch & Optimise</h3>
          <p class="text-gray-700">Campaigns go live with rigorous monitoring. We optimise daily during the first month, adjusting bids, pausing underperformers, scaling winners, and refining search terms to eliminate irrelevant traffic.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md transition-all duration-300">
          <div class="relative z-10 w-12 h-12 bg-electric text-white rounded-full flex items-center justify-center text-xl font-bold mb-6">4</div>
          <h3 class="text-xl font-heading font-bold text-navy mb-3">Scale & Grow</h3>
          <p class="text-gray-700">Once we've established profitable baselines, we scale strategically, expanding into new campaign types, testing new audiences, and increasing budget where the data supports it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">Why Choose Us</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">Numbers that speak louder than promises.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">1,165%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Best-in-Class ROAS</div>
          <p class="text-gray-700 text-sm">CFW's verified all-time ROAS across a 3-year Google Ads engagement managing £380K in spend.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">£2M+</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Revenue Managed</div>
          <p class="text-gray-700 text-sm">Annual client revenue generated through our Google Ads campaigns.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">97%</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Client Retention</div>
          <p class="text-gray-700 text-sm">Clients stay because we deliver results, not because of lock-in contracts.</p>
        </div>
        <div class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300 text-center">
          <div class="text-4xl font-heading font-extrabold text-electric mb-2">24hr</div>
          <div class="text-sm font-semibold text-navy uppercase tracking-wide mb-2">Response Time</div>
          <p class="text-gray-700 text-sm">Every client gets a dedicated account manager with same-day response guaranteed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PPC Funnel -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">The Google Ads Funnel</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">How we turn impressions into revenue, every stage optimised for maximum conversion.</p>
      </div>
      <PpcFunnel />
    </div>
  </section>

  <!-- Industry Benchmarks -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-4">UK Industry Benchmarks</h2>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">See how Google Ads performance varies by industry. Select yours to see the numbers that matter.</p>
        <p class="text-lg text-gray-700 mt-6 leading-relaxed">For an overview of advertising budgets and costs, read <a href="/blog/how-much-google-ads-cost-uk/" class="text-electric underline hover:text-electric-dark">how much Google Ads cost in the UK</a>.</p>
      </div>
      <IndustryBenchmarks />
    </div>
  </section>

  <!-- Growth Chart -->
  <section class="py-20 lg:py-28 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <GrowthChart title="Average Client Performance" bars={[
          { label: "ROAS Improvement", value: 85, color: "#2563EB" },
          { label: "Wasted Spend Reduction", value: 65, color: "#10B981" },
          { label: "Conversion Rate Uplift", value: 45, color: "#2563EB" },
          { label: "Revenue Growth", value: 90, color: "#10B981" },
        ]} />
      </div>
    </div>
  </section>

  <!-- Case Study -->
  <section class="py-20 lg:py-28 bg-sky-tint" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="glass-card p-8 sm:p-12 lg:p-16 max-w-4xl mx-auto">
        <span class="inline-block px-3 py-1 bg-electric/10 text-electric text-sm font-semibold rounded-full mb-6">Case Study</span>
        <h2 class="text-2xl sm:text-3xl font-heading font-bold text-navy mb-4">CFW, £4.14M Revenue · 1,165% ROAS · 3 Years</h2>
        <p class="text-lg text-gray-700 mb-8 leading-relaxed">CFW's Google Ads were unprofitable before Visible Ads stepped in. We restructured their entire campaign architecture, implemented granular Shopping feeds, launched Performance Max with curated asset groups, and built a remarketing funnel that recaptured abandoned baskets. Over three years managing £380K in ad spend, we generated £4.14M in revenue, a verified all-time ROAS of 1,165% and a 180x return on agency fees.</p>
        <div class="flex flex-wrap gap-8">
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">1,165%</div>
            <div class="text-sm text-gray-700">All-Time ROAS</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">£4.14M</div>
            <div class="text-sm text-gray-700">Revenue Generated</div>
          </div>
          <div>
            <div class="text-3xl font-heading font-extrabold text-electric">180x</div>
            <div class="text-sm text-gray-700">Return on Agency Fees</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-navy mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How much does Google Ads management cost?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">These tiers apply per channel managed. SILVER GBP 1,000/mo (ad budget up to GBP 3,000, 10 hours/mo); GOLD GBP 1,500/mo (up to GBP 20,000, 20 hours/mo); PLATINUM GBP 2,000/mo + 5% (GBP 20,000+ budget, 35 hours/mo, click-fraud protection); PERFORMANCE: reduced or zero retainer with a revenue-share component, by application, individually negotiated. All plus VAT/month, excluding creative and a one-off GBP 1,000 tracking setup fee, 3-month minimum then rolling monthly with 30 days notice.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How quickly will I see results from Google Ads?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">You can see initial traffic within 24 hours of launching campaigns. However, meaningful performance optimisation typically takes 4-8 weeks as we gather conversion data, refine audiences, and test ad copy. Most clients see strong month-on-month improvement from month two onwards.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              What are the benefits of working with a Google Partner agency?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">As a Google Partner, we have direct access to Google support, beta features, and advanced training. We meet Google's strict performance requirements for client growth and retention. This means you benefit from insider knowledge and early access to new ad formats before your competitors.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              How often do you report on campaign performance?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">We provide comprehensive monthly reports with full transparency on spend, conversions, ROAS, and strategic recommendations. You also get access to a live dashboard for real-time monitoring, and we schedule monthly strategy calls to review results and plan next steps.</div>
          </details>
          <details class="group bg-white border border-gray-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-6 font-heading font-semibold text-navy text-lg hover:bg-gray-50 transition-colors">
              Are we locked into a long-term contract?
              <svg class="w-5 h-5 text-electric shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-gray-700 leading-relaxed">We work on rolling monthly agreements after an initial 3-month onboarding period. The first three months allow us to properly audit, restructure, and optimise your account. After that, you stay because of results, not contracts.</div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos -->
  <section class="py-16 lg:py-20 bg-gray-50" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ClientLogos />
    </div>
  </section>

  <!-- Hub: Service Suite -->
  <section class="py-16 lg:py-20 bg-white" data-animate>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-heading font-bold text-navy text-center mb-8">Explore Our Full Service Suite</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <a href="/bing-ads" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Bing Ads Management</h3>
          <p class="text-gray-700 text-sm mb-3">Reach high-value audiences on Microsoft's search network with 20-35% lower CPCs.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/seo" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">SEO Services</h3>
          <p class="text-gray-700 text-sm mb-3">Compound your paid search investment with sustainable organic growth and technical excellence.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/paid-social" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Paid Social Advertising</h3>
          <p class="text-gray-700 text-sm mb-3">Creative-led campaigns on Meta, TikTok, and LinkedIn that turn scrollers into buyers.</p>
          <span class="text-electric text-sm font-medium inline-flex items-center gap-1">Learn more <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
        </a>
        <a href="/amazon" class="group relative bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-gray-100 ring-1 ring-electric/10 hover:ring-electric/30 hover:shadow-lg transition-all duration-300">
          <h3 class="text-lg font-heading font-bold text-navy mb-2 group-hover:text-electric transition-colors">Amazon Ads & Marketplace</h3>
