---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  image?: string;
  noindex?: boolean;
}

const { title, description, canonical, schema, image, noindex = false } = Astro.props;
const siteUrl = 'https://visible-ads.com';
const pageUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}${image || '/images/visible-ads-og.png'}`;

import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GuidePopup from '../components/GuidePopup.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZZ6RF754RW"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZZ6RF754RW', { send_page_view: false });
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={pageUrl} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <link rel="alternate" type="application/rss+xml" title="Visible Ads Blog" href="/rss.xml" />
  {Astro.url.pathname === '/' && <link rel="preload" href="/images/boh-and-joe.webp" as="image" type="image/webp" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Visible Ads" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <ClientRouter />
</head>
<body class="antialiased" data-pathname={Astro.url.pathname}>
  <style>
    body[data-pathname="/contact"] #sticky-cta,
    body[data-pathname="/contact/"] #sticky-cta { display: none !important; }
  </style>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />
  <GuidePopup />
  <div id="sticky-cta" class="lg:hidden fixed bottom-0 left-0 right-0 z-30 transform translate-y-full transition-transform duration-300 bg-navy border-t border-electric/20 px-4 py-3 flex items-center justify-between">
    <span class="text-white text-sm font-medium">Free Ads Audit</span>
    <a href="/free-ads-audit" class="bg-cta text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-electric transition-colors">Get Started</a>
  </div>
  <a href="https://wa.me/447810477679" target="_blank" rel="noopener" aria-label="Chat on WhatsApp" class="fixed bottom-20 lg:bottom-6 right-6 z-40 w-14 h-14 bg-[#25D366] rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-200">
    <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
  <button id="back-to-top" aria-label="Back to top" class="fixed bottom-20 lg:bottom-6 left-6 z-40 w-12 h-12 bg-navy/80 backdrop-blur-sm text-white rounded-full flex items-center justify-center shadow-lg hover:bg-electric transition-all duration-300 opacity-0 translate-y-4 pointer-events-none">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/></svg>
  </button>
  <script>
    document.addEventListener('astro:page-load', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title,
        });
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-on-scroll');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('[data-animate]').forEach((el) => observer.observe(el));

      const stickyCta = document.getElementById('sticky-cta');
      let stickyShown = false;
      let pastThreshold = false;
      let overOwnCta = false;
      const backToTop = document.getElementById('back-to-top');

      const syncStickyCta = () => {
        const shouldShow = pastThreshold && !overOwnCta;
        if (shouldShow && !stickyShown) {
          stickyShown = true;
          stickyCta?.classList.remove('translate-y-full');
          stickyCta?.classList.add('translate-y-0');
        } else if (!shouldShow && stickyShown) {
          stickyShown = false;
          stickyCta?.classList.remove('translate-y-0');
          stickyCta?.classList.add('translate-y-full');
        }
      };

      // Pages that embed their own CTA form (e.g. the profit calculator) can have that
      // form scroll flush to the bottom of a mobile viewport, right under the global
      // sticky bar. Hide the sticky bar while an in-page CTA is visible so the two
      // don't overlap.
      const ownCtaTargets = document.querySelectorAll('[data-hide-sticky-cta]');
      if (ownCtaTargets.length) {
        const overlapObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            overOwnCta = entry.isIntersecting;
          });
          syncStickyCta();
        }, { threshold: 0.01 });
        ownCtaTargets.forEach((el) => overlapObserver.observe(el));
      }

      window.addEventListener('scroll', () => {
        pastThreshold = window.scrollY > 500;
        syncStickyCta();
        if (window.scrollY > 800) {
          backToTop?.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
          backToTop?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          backToTop?.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
          backToTop?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        }
      });
      backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    });
  </script>
</body>
</html>
